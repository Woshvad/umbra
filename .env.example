# Umbra — environment template (spec §15). Copy to `.env` and fill values.
# `.env` is gitignored and MUST NEVER be committed.
#
# NOTE: this root file is only a convenience template. The file the solver ACTUALLY
# reads is `solver/.env` — see `solver/.env.example` for the authoritative, complete
# list of solver vars (JSON_API_URL, SOLVER_PORT, ROUND_SECONDS, ANTHROPIC_API_KEY,
# and the default-OFF X402_* metered-access block). Prefer that file for solver config.

# Anthropic API key for the Claude AI auction solver.
# Read ONLY by solver/ (Phase 5). NEVER referenced by the frontend (web/),
# NEVER committed. (Threat T-01-04 / ASVS V14.)
ANTHROPIC_API_KEY=

# Canton JSON Ledger API v2 base URL — cn-quickstart LocalNet app-provider
# participant (:3975), consumed by the solver. (Legacy Daml 2.x `daml start`
# sandbox HTTP JSON API v1 was :7575/ — preserved at git tag `sandbox-mvp`.)
JSON_API_URL=http://localhost:3975

# Solver service HTTP port (Phase 5, solver/). Defaults to 4100 on the dev box because a
# separate `augur` project owns :4000. (web/.env's VITE_SOLVER_URL must match.)
SOLVER_PORT=4100

# Auction round window length, in seconds.
ROUND_SECONDS=60

# Product display name.
PRODUCT_NAME=Umbra

# ── OIDC (DevNet/prod dual-mode auth — IDEN-01/02) — SERVER-SIDE ONLY ──────────────
# Set OIDC_ISSUER to switch the solver's operator credential from the unsafe-HMAC dev
# token (scripts/.operator-token) to real OIDC client-credentials (Keycloak, RS256/JWKS).
# Leave BLANK for the LocalNet dev loop (the dev HMAC path stays the default). These are
# read ONLY by solver/ (auth.ts + ledger.ts); OIDC_CLIENT_SECRET is confidential and MUST
# NEVER reach the browser or be committed (.env is gitignored — placeholders only here).
# The token audience stays https://canton.network.global (same as the dev token).
OIDC_ISSUER=
OIDC_JWKS_URL=
OIDC_CLIENT_ID=umbra-solver
OIDC_CLIENT_SECRET=
# The operator PARTY id on the OIDC path (the token carries no party authority — Canton
# derives rights from the token's user). Falls back to daml/parties.json `operator`.
OIDC_OPERATOR_PARTY=
