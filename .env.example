# Umbra — environment template (spec §15). Copy to `.env` and fill values.
# `.env` is gitignored and MUST NEVER be committed.

# Anthropic API key for the Claude AI auction solver.
# Read ONLY by solver/ (Phase 5). NEVER referenced by the frontend (web/),
# NEVER committed. (Threat T-01-04 / ASVS V14.)
ANTHROPIC_API_KEY=

# Canton JSON Ledger API v2 base URL — cn-quickstart LocalNet app-provider
# participant (:3975), consumed by the solver. (Legacy Daml 2.x `daml start`
# sandbox HTTP JSON API v1 was :7575/ — preserved at git tag `sandbox-mvp`.)
JSON_API_URL=http://localhost:3975

# Solver service HTTP port (Phase 5, solver/).
SOLVER_PORT=4000

# Auction round window length, in seconds.
ROUND_SECONDS=60

# Product display name.
PRODUCT_NAME=Umbra
