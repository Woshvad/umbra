# --- Secrets (NEVER commit) ---
.env
.env.local
.env.*.local

# --- Daml build artifacts ---
.daml/
*.dar
# Canton runtime logs emitted by `daml build`/`daml test`/`daml start`.
daml/log/
canton.log
canton_errors.log

# --- Ephemeral runtime state ---
# parties.json holds per-boot Canton party IDs (hint::<fingerprint>), which are
# NOT stable across `daml start` restarts — regenerate it, never commit it.
parties.json

# --- Node / JS ---
node_modules/
dist/
.dist/
*.tsbuildinfo

# --- Phase 3 frontend: generated / per-boot ephemeral state ---
# NOTE: web/daml.js/ (generated by `daml codegen js`) is intentionally COMMITTED so the
# web app builds on a fresh clone without the Daml SDK. Regenerate only when templates change.
# Per-boot bearer credentials minted from parties.json — never commit (Pitfall 6, D5/D6).
web/src/tokens.json
# Operator dev token is minted OUT of the browser bundle (D6) — also never committed.
scripts/.operator-token
# LocalNet (Daml 3.x / cn-quickstart) deploy record — per-deploy party IDs, ephemeral.
scripts/localnet/.deploy.json
scripts/localnet/.tokens.json

# --- SDK download temp / OS noise ---
*.tar.gz
.DS_Store
Thumbs.db

# NOTE: spec.md and "Umbra design/" are intentionally NOT ignored — they are
# binding source inputs and must stay git-tracked for every later phase.

# Local dev preview config (Claude preview server)
.claude/
