-- Umbra — auction data model (spec §7.3–7.7, frozen field shapes).
-- The signatory/observer sets here ARE the privacy model: Order is private to
-- exactly operator+desk (no observer) — the core of the money shot; a stray
-- observer would silently break PRIV-01..04.
-- The module re-exports `Side` and `Allocation` (now defined in the leaf math
-- module Umbra.Clearing to break a module-import cycle — Auction.Clear must
-- import computeClearing, and Clearing previously imported Auction). Re-exporting
-- keeps `Umbra.Auction.Side` / `Umbra.Auction.Allocation` resolvable, byte-shape
-- unchanged, for every existing consumer (Roles / Setup / Tests).
module Umbra.Auction
  ( module Umbra.Auction
  , Side(..)
  , Allocation(..)
  , OrderType(..)
  ) where

-- CRYP-01 (10-01): on-ledger commitment hashing. `sha256 : BytesHex -> BytesHex`
-- takes HEX input, so the payload is `toHex`-encoded FIRST (RESEARCH Pitfall 1).
-- Alpha-flagged stdlib module — the warning is suppressed via daml.yaml
-- build-options (`-Wno-crypto-text-is-alpha`), honestly labeled alpha.
import DA.Crypto.Text (sha256, toHex)
import Umbra.Holding (Holding, Reassign(..))
-- FIX 1 (BLOCKER, privacy): the SETTLEMENT BODY (§8 re-verify, four-eyes gate, Batch
-- DvP, per-desk TradeConfirmations) moved OUT of a consuming `Round.Clear` into the
-- NONCONSUMING `Venue.SettleRound` (Umbra.Roles). In Daml a CONSUMING exercise informs
-- the contract's OBSERVERS with the choice arguments; `Round` has `observer desks`, so a
-- consuming `Round.Clear` disclosed every rival's fill (`allocations`) + the buyer/seller
-- party lists to every desk's transaction stream. A NONCONSUMING Venue choice does NOT
-- inform the Venue's observers (the exact idiom SubmitOrder/CommitOrder/IssueHolding use),
-- so desks never witness the settlement args. Round keeps only the bare `MarkSettled`
-- status flip desks ARE allowed to see. The settlement-only imports (Settlement, Approval,
-- Clearing.computeClearing/OrderView, DA.Foldable/DA.List, InstrumentId) now live in
-- Umbra.Roles, so they are dropped here.
import Umbra.Clearing (Side(..), Allocation(..), OrderType(..))

-- §7.3 — order status (verbatim). `Side` is defined in Umbra.Clearing and
-- re-exported above (cycle-break); its Buy/Sell shape is byte-unchanged.
data OrderStatus = Sealed | Filled | PartiallyFilled | Unfilled deriving (Eq, Show)

-- (DFIN-01/02, 11-05) The old Asset-based per-leg `moveExact` and the `fillFor`
-- allocation-fill lookup are RETIRED from the settlement path: Round.Clear now
-- delegates the DvP legs to `Umbra.Settlement.settleBatch`, which threads each
-- source `Holding` across its receivers (`moveThread`) inside the one Clear
-- transaction. `Asset` is off the live path (kept in git history / sandbox-mvp).

-- AUCT-04 — per-desk best-execution (TCA) receipt math (pure; mirrored by the
-- solver receipt surface). `surplusVsLimit` is the PROVEN, structurally-non-negative
-- number (a buy is only eligible when limit ≥ p*, a sell when limit ≤ p*), asserted
-- `>= 0` on-ledger at the per-desk create site in Round.Clear. The bp values use the
-- RULEBOOK-pinned formula `round((|limit − p*| / p*) * 10000)`.
tcaSurplusVsLimit : Side -> Decimal -> Decimal -> Int -> Decimal
tcaSurplusVsLimit sd ownLimit price filled =
  let f = intToDecimal filled
  in case sd of
       Buy  -> (ownLimit - price) * f   -- buyer surplus: paid p* ≤ its ceiling
       Sell -> (price - ownLimit) * f   -- seller surplus: received p* ≥ its floor

tcaImprovementVsLimitBp : Decimal -> Decimal -> Decimal
tcaImprovementVsLimitBp ownLimit price =
  roundBankers 0 ((abs (ownLimit - price) / price) * 10000.0)

-- SIGNED benchmark vs a labeled reference stub (MAY be negative — a DIFFERENT number
-- from the proven vs-limit surplus). A BUY improves when p* is BELOW the reference
-- (paid less); a SELL improves when p* is ABOVE it (received more). On the §4 fixture
-- referencePrice == p* == 100 → 0 (so the benchmark never renders red on §4).
tcaImprovementVsReferenceBp : Side -> Decimal -> Decimal -> Decimal
tcaImprovementVsReferenceBp sd price referencePrice =
  let signed = case sd of
        Buy  -> referencePrice - price
        Sell -> price - referencePrice
  in roundBankers 0 ((signed / price) * 10000.0)

-- §7.4 — round lifecycle status (verbatim)
data RoundStatus = Open | Closed | Cleared | Settled deriving (Eq, Show)

-- §7.7 — the solver's verified output (`Allocation`) is defined in Umbra.Clearing
-- and re-exported above; its record shape (desk : Party, side : Side,
-- filledQty : Int) is byte-unchanged.

-- §7.3 — a sealed limit order. Stakeholders are exactly operator + desk: both
-- signatories make it unforgeable, and NO observer keeps it private to those two.
template Order
  with
    operator : Party
    desk     : Party
    roundId  : Text
    side     : Side
    quantity : Int
    limit    : Decimal
    status   : OrderStatus
    orderType : OrderType         -- AUCT-01 discriminator (§4 orders are Limit)
    minQty    : Optional Int      -- AllOrNone/MAQ only (inert until 09-02)
    firmIf    : Optional Decimal  -- Conditional only (inert until 09-03)
  where
    signatory operator, desk     -- both; unforgeable, and private to these two
    -- ADDITIVE ensure relaxation (T-09-01-01): a plain Limit still needs limit>0;
    -- a Noncompetitive order carries no price so limit>0 is not required. MAQ's
    -- minQty must be in [1, quantity]; a Conditional's firmIf must be > 0. These
    -- guards reject a malformed order on-ledger even though the new fields are
    -- inert in the clearing math this plan. §4 orders (Limit, minQty=None,
    -- firmIf=None) satisfy exactly the old `quantity > 0 && limit > 0.0`.
    ensure quantity > 0
      && (orderType == Noncompetitive || limit > 0.0)
      -- FIX 3 (MEDIUM): the settle path banker-rounds the price to 2dp, so an order
      -- with a sub-cent limit could clear at a price it can never be charged at.
      -- Constrain a competitive limit (and any firmIf band) to 2 decimals so no order
      -- enters the book at a precision settlement cannot honor. §4's whole-number
      -- limits (101/99/100) satisfy this trivially.
      && (orderType == Noncompetitive || roundBankers 2 limit == limit)
      && optional True (\m -> m >= 1 && m <= quantity) minQty
      && optional True (> 0.0) firmIf
      && optional True (\x -> roundBankers 2 x == x) firmIf

    -- Operator-only retirement of a settled order. `archive` (the built-in)
    -- needs the authority of ALL signatories (operator AND desk); inside
    -- Round.Clear only operator authority is present, so a bare `archive`
    -- would fail "missing authorization from <desk>". A CONSUMING choice
    -- controlled by operator alone archives the contract with just the
    -- controller's authority (operator is already a signatory) — the correct
    -- operator-custody retirement primitive (spec §10 step 3).
    choice Retire : ()
      controller operator
      do
        pure ()

-- ===========================================================================
-- CRYP-01 (10-01) — on-ledger commit–reveal. A desk posts sha256(order‖salt)
-- during the window; at close it reveals the full order + salt and the LEDGER
-- itself recomputes the digest and rejects any reveal that does not match. This
-- is verify-don't-trust upgraded from "rivals can't see you" to "the venue
-- cannot accept a reveal that differs from your commitment." ADDITIVE: it wraps
-- the §4 order flow (commit → reveal → clear) and does NOT touch Round.Clear or
-- the §8 clearing math (Umbra.Clearing).
-- ===========================================================================

-- Canonical, injective serializer of the FULL Phase-9 order (RESEARCH Pitfall 2).
-- The SAME function is used by commit and reveal, so a legitimate reveal always
-- reproduces the committed bytes. Guarantees:
--   * fixed field order (side, quantity, limit, orderType, minQty, firmIf);
--   * an injective "|<tag>=" delimiter that cannot appear in any field value
--     (Int/Decimal/Side/OrderType `show` never emit '|');
--   * a PINNED 2-dp Decimal scale via `roundBankers 2` so 100.0 and 100.00 (the
--     same value) serialize identically (and match the solver mirror in 10-05);
--   * EXPLICIT `Some`/`None` tokens for the two Optional params (never "" vs omitted).
serializeOrder : Side -> Int -> Decimal -> OrderType -> Optional Int -> Optional Decimal -> Text
serializeOrder side quantity limit orderType minQty firmIf =
  "s=" <> show side
    <> "|q=" <> show quantity
    <> "|l=" <> show (roundBankers 2 limit)
    <> "|t=" <> show orderType
    <> "|m=" <> optional "None" (\x -> "Some" <> show x) minQty
    <> "|f=" <> optional "None" (\x -> "Some" <> show (roundBankers 2 x)) firmIf

-- The commitment binding: hex sha256 of (canonicalPayload ‖ salt). `sha256`
-- requires a HEX argument, so the concatenated UTF-8 text is `toHex`-encoded
-- FIRST (RESEARCH Pitfall 1). Output is lowercase hex. Deterministic and
-- salt-binding: a different salt (or a different order) yields a different digest.
commitOf : Text -> Text -> Text   -- payload, salt -> hex sha256
commitOf payload salt = sha256 (toHex (payload <> "|" <> salt))

-- A desk's sealed commitment during the open window. Stakeholders are exactly
-- operator + desk (identical privacy set to `Order`): unforgeable, and NO
-- observer keeps the commitment (and its bond) private to those two. During the
-- window ONLY the `commitment : Text` hash and the bond reference are on-ledger —
-- the order contents do not exist on the ledger until a verified reveal.
--
-- BOND CUSTODY (operator-custody LOCK model): the bond is the desk's OWN cash
-- `Holding` (DFIN-01, migrated off `Asset` in 11-05). The operator is already that
-- Holding's sole signatory/custodian and every Holding choice (Split/Merge/Reassign)
-- is `controller operator`, so while the commitment is live the desk CANNOT move or
-- archive its bond — it is locked in operator custody. (The Holding also carries a
-- `lock : Optional Text` field, but it is left `None` here: setting it would also
-- block the operator's own ForfeitBond Reassign — the generic mutating choices
-- refuse a locked holding by design (11-01) — so the immovability guarantee is
-- provided by controller-operator custody, RESEARCH A5, exactly mirroring the old
-- Asset lock.) A valid reveal RELEASES the lock (the commitment is consumed, the
-- bond stays freely the desk's); a non-reveal lets the operator SEIZE it via
-- ForfeitBond. (An earlier "reassign the bond to the operator at commit" escrow is
-- not viable: an operator-OWNED Holding is invisible to the desk — Holding's
-- observer is `owner` only — so the desk's controller-desk RevealOrder could not
-- fetch it. The lock model gives the identical economic guarantee within Daml's
-- disclosure rules.)
template OrderCommitment
  with
    operator   : Party
    desk       : Party
    roundId    : Text
    commitment : Text                -- hex sha256(toHex(canonicalOrder ‖ salt))
    bondCid    : ContractId Holding  -- the desk's cash bond Holding, locked in operator custody
  where
    signatory operator, desk         -- both; unforgeable, and private to these two

    -- REVEAL: the desk submits the full order + salt. The ledger recomputes the
    -- digest over the SAME canonical serializer and `assertMsg`s equality — a
    -- reveal of a DIFFERENT order (or a wrong salt) is rejected ON-LEDGER (T-10-01).
    -- On success the commitment is consumed (the bond lock is released, the bond
    -- stays the desk's) and the sealed Phase-9 Order is created.
    choice RevealOrder : ContractId Order
      with
        side      : Side
        quantity  : Int
        limit     : Decimal
        orderType : OrderType
        minQty    : Optional Int
        firmIf    : Optional Decimal
        salt      : Text
      controller desk
      do
        assertMsg "commitment mismatch"
          (commitment == commitOf (serializeOrder side quantity limit orderType minQty firmIf) salt)
        -- Create the sealed Phase-9 Order (identical shape to Venue.SubmitOrder).
        -- The bond lock is released simply by consuming this OrderCommitment.
        create Order with
          operator; desk; roundId; side; quantity; limit
          status = Sealed
          orderType; minQty; firmIf

    -- FORFEIT (T-10-02) — the deterrent against commit-then-vanish griefing. A
    -- commitment still live at close (never revealed) lets the operator SEIZE the
    -- locked bond into the operator pot. Controller operator (the Holding custodian,
    -- so it can both see and Reassign the desk's bond); CONSUMING, so the desk can
    -- no longer RevealOrder to reclaim — the seizure is final.
    choice ForfeitBond : ContractId Holding
      controller operator
      do
        exercise bondCid Reassign with newOwner = operator

-- CRYP-03 (10-01) — on-ledger PROOF-HASH ANCHOR. Records ONLY hashes: the ZK
-- proof/publicSignals hash and the verification-key hash (RESEARCH Open Q3). NO
-- proof bytes / witness / order data ever land on-ledger — Canton has no zk
-- precompile, so verification is OFF-ledger (a documented gap) and this anchor
-- merely records "a valid proof existed" and binds it to a known circuit
-- (vkeyHash). Operator-signed (no desk authority needed); created via the
-- operator's Venue.AnchorProof choice (or a direct operator create).
template ProofAnchor
  with
    operator  : Party
    roundId   : Text
    proofHash : Text     -- sha256(proof ‖ publicSignals), computed OFF-ledger
    vkeyHash  : Text     -- hash of the verification key (binds to a known circuit)
  where
    signatory operator

-- §7.6 — each desk's private fill receipt; observed by the SINGULAR desk only.
-- AUCT-04 (best-ex / TCA): the appended fields carry the per-desk receipt numbers.
-- `surplusVsLimit` is the PROVEN best-execution number — structurally non-negative
-- (a buy is only eligible when limit ≥ p*, a sell when limit ≤ p*), and asserted
-- `>= 0` ON-LEDGER inside Round.Clear (the ledger-provable claim). `referencePrice`
-- is a LABELED benchmark stub (≈ pre-auction mid); `improvementVsReferenceBp` is a
-- DISTINCT, SIGNED number that MAY be negative — never conflated with the proven one.
template TradeConfirmation
  with
    operator      : Party
    desk          : Party
    roundId       : Text
    symbol        : Text
    side          : Side
    filledQty     : Int
    clearingPrice : Decimal
    cashMoved     : Decimal
    ownLimit                 : Optional Decimal  -- AUCT-04: None for a noncompetitive order (no meaningful limit)
    referencePrice           : Decimal           -- AUCT-04: labeled benchmark STUB (pre-auction mid ≈ 100), passed into Clear
    surplusVsLimit           : Decimal           -- AUCT-04: PROVEN best-ex, asserted ≥ 0 on-ledger in Round.Clear
    improvementVsLimitBp     : Decimal           -- AUCT-04: improvement vs own limit in bp (structurally ≥ 0)
    improvementVsReferenceBp : Decimal           -- AUCT-04: SIGNED benchmark vs reference in bp (MAY be negative)
  where
    signatory operator
    -- visible only to this desk
    observer desk

-- §7.5 — the only pre-clear info desks may see: a COUNT, never the contents.
template RoundStats
  with
    operator : Party
    roundId  : Text
    desks    : [Party]
    sealedOrderCount : Int     -- count ONLY, no contents
  where
    signatory operator
    observer desks

-- Recommended freeze (spec §7.4 references ClearResult but never defines it —
-- RESEARCH Pattern 2 / Assumption A1). Becomes the shared cross-layer return type.
-- Declared after TradeConfirmation because it references `ContractId TradeConfirmation`.
data ClearResult = ClearResult with
    roundId       : Text
    clearingPrice : Decimal
    totalMatched  : Int
    confirmations : [ContractId TradeConfirmation]
  deriving (Eq, Show)

-- §7.4 — the auction round the solver acts on. Desks observe the round + status
-- + (later) count, never the order contents.
template Round
  with
    operator      : Party
    roundId       : Text
    symbol        : Text          -- "BONDX"
    desks         : [Party]
    openedAt      : Time
    windowSeconds : Int           -- 60
    status        : RoundStatus
  where
    signatory operator
    observer desks                -- desks see the round + status + (later) count, never contents

    -- spec §7.4 shows CloseRound without an explicit controller/body. Operator-only,
    -- recreates the round as Closed, with a minimal lifecycle guard (below). Full
    -- window-timing enforcement (deadline checks) remains Phase 2.
    choice CloseRound : ContractId Round            -- after the window
      controller operator
      do
        -- Lifecycle guard: never close an already-settled/cleared round — recreating
        -- it as Closed would re-open the settle path (a latent re-settle vector).
        -- Open→Closed is the normal path; Closed→Closed is an idempotent no-op.
        assertMsg "cannot close an already-settled round" (status /= Settled && status /= Cleared)
        create this with status = Closed

    -- FIX 1 (BLOCKER, the privacy keystone) — the SETTLEMENT BODY moved to the
    -- NONCONSUMING `Venue.SettleRound` (Umbra.Roles); see the import note at the top of
    -- this module. All that remains on Round is the operator-only status transition that
    -- desks (Round observers) ARE allowed to witness. A consuming exercise informs the
    -- contract's observers with the choice args, and `Round` has `observer desks`, so
    -- keeping the sensitive settlement args (allocations, buyer/seller party lists) on a
    -- consuming `Round` choice disclosed every rival's fill to every desk. `MarkSettled`
    -- carries NO sensitive args — just the Closed/Cleared → Settled flip — so observers
    -- learn only what they may. It is exercised by `Venue.SettleRound` AFTER that choice
    -- re-verifies §8, checks the four-eyes gate, and settles the Batch DvP under sole
    -- operator authority.
    choice MarkSettled : ContractId Round
      controller operator
      do
        -- Lifecycle guard (RESEARCH Pitfall 7 / T-02-07, double-settle): only a Closed
        -- (or Cleared) round is settleable; the recreated Settled round fails this guard
        -- on any re-exercise.
        assertMsg "round not settleable (must be Closed or Cleared)"
          (status == Closed || status == Cleared)
        create this with status = Settled
