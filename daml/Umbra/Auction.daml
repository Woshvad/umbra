-- Umbra — auction data model (spec §7.3–7.7, frozen field shapes).
-- The signatory/observer sets here ARE the privacy model: Order is private to
-- exactly operator+desk (no observer) — the core of the money shot; a stray
-- observer would silently break PRIV-01..04.
-- The module re-exports `Side` and `Allocation` (now defined in the leaf math
-- module Umbra.Clearing to break a module-import cycle — Auction.Clear must
-- import computeClearing, and Clearing previously imported Auction). Re-exporting
-- keeps `Umbra.Auction.Side` / `Umbra.Auction.Allocation` resolvable, byte-shape
-- unchanged, for every existing consumer (Roles / Setup / Tests).
module Umbra.Auction
  ( module Umbra.Auction
  , Side(..)
  , Allocation(..)
  ) where

import DA.Action (when, foldlA)
import DA.Foldable (forA_)
import DA.List (sortOn, head)
import Umbra.Asset (Asset(..), Split(..), Reassign(..))
import Umbra.Clearing (Side(..), Allocation(..), OrderView(..), computeClearing)

-- §7.3 — order status (verbatim). `Side` is defined in Umbra.Clearing and
-- re-exported above (cycle-break); its Buy/Sell shape is byte-unchanged.
data OrderStatus = Sealed | Filled | PartiallyFilled | Unfilled deriving (Eq, Show)

-- Settlement helper (Update-monad; top-level because it is reused per leg and
-- Daml-LF forbids recursive/closure-heavy local bindings). Moves EXACTLY `qty`
-- units off the holding `cid` to `newOwner`, returning the moved-slice cid.
--   * qty == holding.quantity → Reassign the WHOLE contract (Asset.Split is
--     STRICT `splitQty < quantity`, so a full move must NOT call Split).
--   * qty <  holding.quantity → Split a `qty` slice, Reassign that slice (the
--     remainder stays with the current owner).
--   * qty >  holding.quantity → Asset.Split's guard / `ensure quantity >= 0.0`
--     throws → the whole Clear transaction rolls back (atomicity, SETL-03).
-- Quantities cross to Decimal here via the caller's `intToDecimal` (units stay Int).
moveExact : ContractId Asset -> Decimal -> Party -> Update (ContractId Asset)
moveExact cid qty newOwner = do
  holding <- fetch cid
  if qty == holding.quantity
    then exercise cid Reassign with newOwner
    else do
      (slice, _remainder) <- exercise cid Split with splitQty = qty
      exercise slice Reassign with newOwner

-- Lookup a desk's filled quantity for a given side from the verified allocations.
fillFor : [Allocation] -> Party -> Side -> Int
fillFor allocs party sd =
  sum [ a.filledQty | a <- allocs, a.desk == party, a.side == sd ]

-- §7.4 — round lifecycle status (verbatim)
data RoundStatus = Open | Closed | Cleared | Settled deriving (Eq, Show)

-- §7.7 — the solver's verified output (`Allocation`) is defined in Umbra.Clearing
-- and re-exported above; its record shape (desk : Party, side : Side,
-- filledQty : Int) is byte-unchanged.

-- §7.3 — a sealed limit order. Stakeholders are exactly operator + desk: both
-- signatories make it unforgeable, and NO observer keeps it private to those two.
template Order
  with
    operator : Party
    desk     : Party
    roundId  : Text
    side     : Side
    quantity : Int
    limit    : Decimal
    status   : OrderStatus
  where
    signatory operator, desk     -- both; unforgeable, and private to these two
    ensure quantity > 0 && limit > 0.0

-- §7.6 — each desk's private fill receipt; observed by the SINGULAR desk only.
template TradeConfirmation
  with
    operator      : Party
    desk          : Party
    roundId       : Text
    symbol        : Text
    side          : Side
    filledQty     : Int
    clearingPrice : Decimal
    cashMoved     : Decimal
  where
    signatory operator
    -- visible only to this desk
    observer desk

-- §7.5 — the only pre-clear info desks may see: a COUNT, never the contents.
template RoundStats
  with
    operator : Party
    roundId  : Text
    desks    : [Party]
    sealedOrderCount : Int     -- count ONLY, no contents
  where
    signatory operator
    observer desks

-- Recommended freeze (spec §7.4 references ClearResult but never defines it —
-- RESEARCH Pattern 2 / Assumption A1). Becomes the shared cross-layer return type.
-- Declared after TradeConfirmation because it references `ContractId TradeConfirmation`.
data ClearResult = ClearResult with
    roundId       : Text
    clearingPrice : Decimal
    totalMatched  : Int
    confirmations : [ContractId TradeConfirmation]
  deriving (Eq, Show)

-- §7.4 — the auction round the solver acts on. Desks observe the round + status
-- + (later) count, never the order contents.
template Round
  with
    operator      : Party
    roundId       : Text
    symbol        : Text          -- "BONDX"
    desks         : [Party]
    openedAt      : Time
    windowSeconds : Int           -- 60
    status        : RoundStatus
  where
    signatory operator
    observer desks                -- desks see the round + status + (later) count, never contents

    -- PHASE-1 MINIMAL PLACEHOLDER: spec §7.4 shows CloseRound without an explicit
    -- controller/body, so freeze it as operator-only with a minimal recreating body
    -- that flips status = Closed purely so the template compiles. NOT real lifecycle
    -- logic — the Open→Closed→Cleared→Settled lifecycle (timing, guards) is Phase 2.
    choice CloseRound : ContractId Round            -- after the window
      controller operator
      do
        create this with status = Closed

    -- §10 — THE atomic settlement choice. The named frozen fields
    -- (clearingPrice, allocations, controller operator, → ClearResult) are
    -- UNCHANGED; the orderCids / buyerUsdcCid / sellerBondCids fields are
    -- ADDITIVE settlement inputs (Option B, DECISIONS.md D7) — a choice body
    -- cannot `query` the ACS, so the caller (Script test now, TS solver P4)
    -- locates and passes in the ContractIds it operates on.
    choice Clear : ClearResult
      with
        clearingPrice  : Decimal
        allocations    : [Allocation]               -- solver output, verified on-ledger
        orderCids      : [ContractId Order]          -- the round's sealed orders
        buyerUsdcCid   : ContractId Asset            -- buyer's USDCx holding to debit
        sellerBondCids : [(Party, ContractId Asset)] -- each seller's BONDX holding
      controller operator
      do
        -- 0. Lifecycle guard (RESEARCH Pitfall 7 / T-02-07, double-settle): only a
        --    Closed (or Cleared) round is settleable. Clear recreates the Round with
        --    status = Settled, so a re-exercise on the new contract fails this guard.
        assertMsg "round not settleable (must be Closed or Cleared)"
          (status == Closed || status == Cleared)

        -- 1. RE-VERIFY — the security keystone (CLEAR-05 + SETL-04, spec §9/§10
        --    step 1). Fetch the sealed orders, rebuild OrderViews, recompute §8,
        --    and assert the proposal matches EXACTLY. This single recompute-and-
        --    equal check provably subsumes max-volume + per-order-limit-compliance
        --    + conservation: a bad allocation (e.g. A buys 12) or a wrong price
        --    (e.g. 99.0) is rejected here regardless of holdings.
        orders <- mapA fetch orderCids
        let views = [ OrderView with
                        desk     = o.desk
                        side     = o.side
                        quantity = o.quantity
                        limit    = o.limit
                    | o <- orders ]
        let (pStarExpected, allocsExpected) = computeClearing views
        assertMsg "clearingPrice does not match recomputed §8 p*"
          (roundBankers 2 clearingPrice == roundBankers 2 pStarExpected)
        -- Order-independent (multiset) allocation equality via a stable sort key.
        let allocKey a = (show a.desk, show a.side, a.filledQty)
        assertMsg "allocations do not match recomputed §8"
          (sortOn allocKey allocations == sortOn allocKey allocsExpected)
        -- Defense-in-depth conservation: Σ buy fills == Σ sell fills.
        let totalBuy  = sum [ a.filledQty | a <- allocations, a.side == Buy ]
        let totalSell = sum [ a.filledQty | a <- allocations, a.side == Sell ]
        assertMsg "fills not conserved (Σbuy /= Σsell)" (totalBuy == totalSell)

        -- 2. SETTLE DvP in this ONE transaction (spec §10 step 2, SETL-01) under
        --    sole operator authority (operator-custody — Clear is `controller
        --    operator` and every Asset choice is `controller operator`, so
        --    authority flows automatically; no counterparty submit). Any failing
        --    leg rolls back the whole transaction (atomicity, SETL-03).
        let priceDec = roundBankers 2 clearingPrice
        -- The buyer is the (single) desk on the Buy side of the verified allocation.
        let buyer = head [ a.desk | a <- allocations, a.side == Buy ]

        -- BONDX leg: each seller delivers `filledQty` BONDX to the buyer.
        forA_ sellerBondCids $ \(seller, bondCid) -> do
          let filled = fillFor allocations seller Sell
          when (filled > 0) $ do
            _ <- moveExact bondCid (intToDecimal filled) buyer
            pure ()

        -- Cash leg: debit the buyer's USDCx and credit each seller `filledQty * p*`.
        -- Thread the buyer's USDCx ContractId through the per-seller splits so each
        -- slice comes off the running remainder (the final remainder stays with the
        -- buyer). The buyer's net debit is Σ(sellerFill * p*) = totalSell * p*.
        let creditCash usdcCid (seller, _) = do
              let filled = fillFor allocations seller Sell
              if filled <= 0
                then pure usdcCid
                else do
                  let cashDue = intToDecimal filled * priceDec
                  holding <- fetch usdcCid
                  if cashDue == holding.quantity
                    then do
                      _ <- exercise usdcCid Reassign with newOwner = seller
                      pure usdcCid   -- holding fully consumed; no remainder cid to thread
                    else do
                      (slice, remainder) <- exercise usdcCid Split with splitQty = cashDue
                      _ <- exercise slice Reassign with newOwner = seller
                      pure remainder
        -- Fold the cash credits across sellers, threading the buyer's USDCx remainder.
        _finalBuyerCash <- foldlA creditCash buyerUsdcCid sellerBondCids

        -- 3. Mark the Orders settled — archive each (spec §10 step 3); the per-desk
        --    TradeConfirmation is the durable fill receipt.
        forA_ orderCids archive

        -- 4. Per-desk TradeConfirmation (spec §10 step 4) — observer = that desk
        --    only (the privacy field is frozen in the template). One per
        --    participating desk (each allocation row maps to one desk+side).
        confs <- forA allocations $ \a ->
          create TradeConfirmation with
            operator
            desk          = a.desk
            roundId
            symbol
            side          = a.side
            filledQty     = a.filledQty
            clearingPrice = priceDec
            cashMoved     = intToDecimal a.filledQty * priceDec

        -- 5. Settle the Round (spec §10 step 5) and return the verified result.
        _newRound <- create this with status = Settled
        pure ClearResult with
          roundId
          clearingPrice = priceDec
          totalMatched  = totalBuy
          confirmations = confs
