-- Umbra — auction data model (spec §7.3–7.7, frozen field shapes).
-- The signatory/observer sets here ARE the privacy model: Order is private to
-- exactly operator+desk (no observer) — the core of the money shot; a stray
-- observer would silently break PRIV-01..04.
-- The module re-exports `Side` and `Allocation` (now defined in the leaf math
-- module Umbra.Clearing to break a module-import cycle — Auction.Clear must
-- import computeClearing, and Clearing previously imported Auction). Re-exporting
-- keeps `Umbra.Auction.Side` / `Umbra.Auction.Allocation` resolvable, byte-shape
-- unchanged, for every existing consumer (Roles / Setup / Tests).
module Umbra.Auction
  ( module Umbra.Auction
  , Side(..)
  , Allocation(..)
  , OrderType(..)
  ) where

import DA.Action (when, foldlA)
import DA.Foldable (forA_)
import DA.List (sortOn, dedup)
import Umbra.Asset (Asset(..), Split(..), Reassign(..))
import Umbra.Clearing (Side(..), Allocation(..), OrderType(..), OrderView(..), computeClearing)

-- §7.3 — order status (verbatim). `Side` is defined in Umbra.Clearing and
-- re-exported above (cycle-break); its Buy/Sell shape is byte-unchanged.
data OrderStatus = Sealed | Filled | PartiallyFilled | Unfilled deriving (Eq, Show)

-- Settlement helper (Update-monad; top-level because it is reused per leg and
-- Daml-LF forbids recursive/closure-heavy local bindings). Moves EXACTLY `qty`
-- units off the holding `cid` to `newOwner`, returning the moved-slice cid.
--   * qty == holding.quantity → Reassign the WHOLE contract (Asset.Split is
--     STRICT `splitQty < quantity`, so a full move must NOT call Split).
--   * qty <  holding.quantity → Split a `qty` slice, Reassign that slice (the
--     remainder stays with the current owner).
--   * qty >  holding.quantity → Asset.Split's guard / `ensure quantity >= 0.0`
--     throws → the whole Clear transaction rolls back (atomicity, SETL-03).
-- Quantities cross to Decimal here via the caller's `intToDecimal` (units stay Int).
moveExact : ContractId Asset -> Decimal -> Party -> Update (ContractId Asset)
moveExact cid qty newOwner = do
  holding <- fetch cid
  if qty == holding.quantity
    then exercise cid Reassign with newOwner
    else do
      (slice, _remainder) <- exercise cid Split with splitQty = qty
      exercise slice Reassign with newOwner

-- Lookup a desk's filled quantity for a given side from the verified allocations.
fillFor : [Allocation] -> Party -> Side -> Int
fillFor allocs party sd =
  sum [ a.filledQty | a <- allocs, a.desk == party, a.side == sd ]

-- AUCT-04 — per-desk best-execution (TCA) receipt math (pure; mirrored by the
-- solver receipt surface). `surplusVsLimit` is the PROVEN, structurally-non-negative
-- number (a buy is only eligible when limit ≥ p*, a sell when limit ≤ p*), asserted
-- `>= 0` on-ledger at the per-desk create site in Round.Clear. The bp values use the
-- RULEBOOK-pinned formula `round((|limit − p*| / p*) * 10000)`.
tcaSurplusVsLimit : Side -> Decimal -> Decimal -> Int -> Decimal
tcaSurplusVsLimit sd ownLimit price filled =
  let f = intToDecimal filled
  in case sd of
       Buy  -> (ownLimit - price) * f   -- buyer surplus: paid p* ≤ its ceiling
       Sell -> (price - ownLimit) * f   -- seller surplus: received p* ≥ its floor

tcaImprovementVsLimitBp : Decimal -> Decimal -> Decimal
tcaImprovementVsLimitBp ownLimit price =
  roundBankers 0 ((abs (ownLimit - price) / price) * 10000.0)

-- SIGNED benchmark vs a labeled reference stub (MAY be negative — a DIFFERENT number
-- from the proven vs-limit surplus). A BUY improves when p* is BELOW the reference
-- (paid less); a SELL improves when p* is ABOVE it (received more). On the §4 fixture
-- referencePrice == p* == 100 → 0 (so the benchmark never renders red on §4).
tcaImprovementVsReferenceBp : Side -> Decimal -> Decimal -> Decimal
tcaImprovementVsReferenceBp sd price referencePrice =
  let signed = case sd of
        Buy  -> referencePrice - price
        Sell -> price - referencePrice
  in roundBankers 0 ((signed / price) * 10000.0)

-- §7.4 — round lifecycle status (verbatim)
data RoundStatus = Open | Closed | Cleared | Settled deriving (Eq, Show)

-- §7.7 — the solver's verified output (`Allocation`) is defined in Umbra.Clearing
-- and re-exported above; its record shape (desk : Party, side : Side,
-- filledQty : Int) is byte-unchanged.

-- §7.3 — a sealed limit order. Stakeholders are exactly operator + desk: both
-- signatories make it unforgeable, and NO observer keeps it private to those two.
template Order
  with
    operator : Party
    desk     : Party
    roundId  : Text
    side     : Side
    quantity : Int
    limit    : Decimal
    status   : OrderStatus
    orderType : OrderType         -- AUCT-01 discriminator (§4 orders are Limit)
    minQty    : Optional Int      -- AllOrNone/MAQ only (inert until 09-02)
    firmIf    : Optional Decimal  -- Conditional only (inert until 09-03)
  where
    signatory operator, desk     -- both; unforgeable, and private to these two
    -- ADDITIVE ensure relaxation (T-09-01-01): a plain Limit still needs limit>0;
    -- a Noncompetitive order carries no price so limit>0 is not required. MAQ's
    -- minQty must be in [1, quantity]; a Conditional's firmIf must be > 0. These
    -- guards reject a malformed order on-ledger even though the new fields are
    -- inert in the clearing math this plan. §4 orders (Limit, minQty=None,
    -- firmIf=None) satisfy exactly the old `quantity > 0 && limit > 0.0`.
    ensure quantity > 0
      && (orderType == Noncompetitive || limit > 0.0)
      && optional True (\m -> m >= 1 && m <= quantity) minQty
      && optional True (> 0.0) firmIf

    -- Operator-only retirement of a settled order. `archive` (the built-in)
    -- needs the authority of ALL signatories (operator AND desk); inside
    -- Round.Clear only operator authority is present, so a bare `archive`
    -- would fail "missing authorization from <desk>". A CONSUMING choice
    -- controlled by operator alone archives the contract with just the
    -- controller's authority (operator is already a signatory) — the correct
    -- operator-custody retirement primitive (spec §10 step 3).
    choice Retire : ()
      controller operator
      do
        pure ()

-- §7.6 — each desk's private fill receipt; observed by the SINGULAR desk only.
-- AUCT-04 (best-ex / TCA): the appended fields carry the per-desk receipt numbers.
-- `surplusVsLimit` is the PROVEN best-execution number — structurally non-negative
-- (a buy is only eligible when limit ≥ p*, a sell when limit ≤ p*), and asserted
-- `>= 0` ON-LEDGER inside Round.Clear (the ledger-provable claim). `referencePrice`
-- is a LABELED benchmark stub (≈ pre-auction mid); `improvementVsReferenceBp` is a
-- DISTINCT, SIGNED number that MAY be negative — never conflated with the proven one.
template TradeConfirmation
  with
    operator      : Party
    desk          : Party
    roundId       : Text
    symbol        : Text
    side          : Side
    filledQty     : Int
    clearingPrice : Decimal
    cashMoved     : Decimal
    ownLimit                 : Optional Decimal  -- AUCT-04: None for a noncompetitive order (no meaningful limit)
    referencePrice           : Decimal           -- AUCT-04: labeled benchmark STUB (pre-auction mid ≈ 100), passed into Clear
    surplusVsLimit           : Decimal           -- AUCT-04: PROVEN best-ex, asserted ≥ 0 on-ledger in Round.Clear
    improvementVsLimitBp     : Decimal           -- AUCT-04: improvement vs own limit in bp (structurally ≥ 0)
    improvementVsReferenceBp : Decimal           -- AUCT-04: SIGNED benchmark vs reference in bp (MAY be negative)
  where
    signatory operator
    -- visible only to this desk
    observer desk

-- §7.5 — the only pre-clear info desks may see: a COUNT, never the contents.
template RoundStats
  with
    operator : Party
    roundId  : Text
    desks    : [Party]
    sealedOrderCount : Int     -- count ONLY, no contents
  where
    signatory operator
    observer desks

-- Recommended freeze (spec §7.4 references ClearResult but never defines it —
-- RESEARCH Pattern 2 / Assumption A1). Becomes the shared cross-layer return type.
-- Declared after TradeConfirmation because it references `ContractId TradeConfirmation`.
data ClearResult = ClearResult with
    roundId       : Text
    clearingPrice : Decimal
    totalMatched  : Int
    confirmations : [ContractId TradeConfirmation]
  deriving (Eq, Show)

-- §7.4 — the auction round the solver acts on. Desks observe the round + status
-- + (later) count, never the order contents.
template Round
  with
    operator      : Party
    roundId       : Text
    symbol        : Text          -- "BONDX"
    desks         : [Party]
    openedAt      : Time
    windowSeconds : Int           -- 60
    status        : RoundStatus
  where
    signatory operator
    observer desks                -- desks see the round + status + (later) count, never contents

    -- spec §7.4 shows CloseRound without an explicit controller/body. Operator-only,
    -- recreates the round as Closed, with a minimal lifecycle guard (below). Full
    -- window-timing enforcement (deadline checks) remains Phase 2.
    choice CloseRound : ContractId Round            -- after the window
      controller operator
      do
        -- Lifecycle guard: never close an already-settled/cleared round — recreating
        -- it as Closed would re-open the settle path (a latent re-settle vector).
        -- Open→Closed is the normal path; Closed→Closed is an idempotent no-op.
        assertMsg "cannot close an already-settled round" (status /= Settled && status /= Cleared)
        create this with status = Closed

    -- §10 — THE atomic settlement choice. The named frozen fields
    -- (clearingPrice, allocations, controller operator, → ClearResult) are
    -- UNCHANGED; the orderCids / buyerUsdcCid / sellerBondCids fields are
    -- ADDITIVE settlement inputs (Option B, DECISIONS.md D7) — a choice body
    -- cannot `query` the ACS, so the caller (Script test now, TS solver P4)
    -- locates and passes in the ContractIds it operates on.
    choice Clear : ClearResult
      with
        clearingPrice  : Decimal
        allocations    : [Allocation]               -- solver output, verified on-ledger
        orderCids      : [ContractId Order]          -- the round's sealed orders
        buyerUsdcCid   : ContractId Asset            -- buyer's USDCx holding to debit
        sellerBondCids : [(Party, ContractId Asset)] -- each seller's BONDX holding
        referencePrice : Decimal                     -- AUCT-04: labeled benchmark STUB (config, passed in — a choice body cannot read config)
      controller operator
      do
        -- 0. Lifecycle guard (RESEARCH Pitfall 7 / T-02-07, double-settle): only a
        --    Closed (or Cleared) round is settleable. Clear recreates the Round with
        --    status = Settled, so a re-exercise on the new contract fails this guard.
        assertMsg "round not settleable (must be Closed or Cleared)"
          (status == Closed || status == Cleared)

        -- 1. RE-VERIFY — the security keystone (CLEAR-05 + SETL-04, spec §9/§10
        --    step 1). Fetch the sealed orders, rebuild OrderViews, recompute §8,
        --    and assert the proposal matches EXACTLY. This single recompute-and-
        --    equal check provably subsumes max-volume + per-order-limit-compliance
        --    + conservation: a bad allocation (e.g. A buys 12) or a wrong price
        --    (e.g. 99.0) is rejected here regardless of holdings.
        orders <- mapA fetch orderCids
        let views = [ OrderView with
                        desk      = o.desk
                        side      = o.side
                        quantity  = o.quantity
                        limit     = o.limit
                        orderType = o.orderType
                        minQty    = o.minQty
                        firmIf    = o.firmIf
                    | o <- orders ]
        let (pStarExpected, allocsExpected) = computeClearing views
        assertMsg "clearingPrice does not match recomputed §8 p*"
          (roundBankers 2 clearingPrice == roundBankers 2 pStarExpected)
        -- Order-independent (multiset) allocation equality via a stable sort key.
        let allocKey a = (show a.desk, show a.side, a.filledQty)
        assertMsg "allocations do not match recomputed §8"
          (sortOn allocKey allocations == sortOn allocKey allocsExpected)
        -- Defense-in-depth conservation: Σ buy fills == Σ sell fills.
        let totalBuy  = sum [ a.filledQty | a <- allocations, a.side == Buy ]
        let totalSell = sum [ a.filledQty | a <- allocations, a.side == Sell ]
        assertMsg "fills not conserved (Σbuy /= Σsell)" (totalBuy == totalSell)

        -- 2. SETTLE DvP in this ONE transaction (spec §10 step 2, SETL-01) under
        --    sole operator authority (operator-custody — Clear is `controller
        --    operator` and every Asset choice is `controller operator`, so
        --    authority flows automatically; no counterparty submit). Any failing
        --    leg rolls back the whole transaction (atomicity, SETL-03).
        let priceDec = roundBankers 2 clearingPrice
        -- The buyer is the SINGLE funded desk on the Buy side of the verified
        -- allocation. Filter to filledQty > 0 so a 0-fill eligible buy never binds
        -- the settlement counterparty, and FAIL LOUDLY (not via a partial `head`,
        -- which would crash on an all-sell allocation) if the allocation is not
        -- single-buyer — the operator-custody DvP legs below assume exactly one
        -- buyer (spec §10 MVP single-buyer invariant).
        let fundedBuyers = dedup [ a.desk | a <- allocations, a.side == Buy, a.filledQty > 0 ]
        buyer <- case fundedBuyers of
          [b] -> pure b
          _   -> abort "Clear: settlement requires exactly one funded buyer (MVP single-buyer invariant)"

        -- BONDX leg: each seller delivers `filledQty` BONDX to the buyer.
        forA_ sellerBondCids $ \(seller, bondCid) -> do
          let filled = fillFor allocations seller Sell
          when (filled > 0) $ do
            -- DvP integrity: the supplied holding must be THIS seller's own BONDX.
            -- The recompute above verifies the allocation, not that the caller
            -- passed each seller's own holding — a wrong/mismatched cid would
            -- otherwise under-deliver while the round still reports Settled.
            bond <- fetch bondCid
            assertMsg "Clear: seller BONDX holding owner/symbol mismatch"
              (bond.owner == seller && bond.symbol == symbol)
            _ <- moveExact bondCid (intToDecimal filled) buyer
            pure ()

        -- Cash leg: debit the buyer's USDCx and credit each seller `filledQty * p*`.
        -- Thread the buyer's USDCx ContractId through the per-seller splits so each
        -- slice comes off the running remainder (the final remainder stays with the
        -- buyer). The buyer's net debit is Σ(sellerFill * p*) = totalSell * p*.
        -- DvP integrity: the supplied USDCx holding to debit must be the buyer's own
        -- cash holding (symbol USDCx) — guards against debiting a wrong/foreign cid.
        buyerCash <- fetch buyerUsdcCid
        assertMsg "Clear: buyer USDCx holding owner/symbol mismatch"
          (buyerCash.owner == buyer && buyerCash.symbol == "USDCx")
        let creditCash usdcCid (seller, _) = do
              let filled = fillFor allocations seller Sell
              if filled <= 0
                then pure usdcCid
                else do
                  let cashDue = intToDecimal filled * priceDec
                  holding <- fetch usdcCid
                  if cashDue == holding.quantity
                    then do
                      _ <- exercise usdcCid Reassign with newOwner = seller
                      pure usdcCid   -- holding fully consumed; no remainder cid to thread
                    else do
                      (slice, remainder) <- exercise usdcCid Split with splitQty = cashDue
                      _ <- exercise slice Reassign with newOwner = seller
                      pure remainder
        -- Fold the cash credits across sellers, threading the buyer's USDCx remainder.
        _finalBuyerCash <- foldlA creditCash buyerUsdcCid sellerBondCids

        -- 3. Mark the Orders settled — Retire each (spec §10 step 3); the per-desk
        --    TradeConfirmation is the durable fill receipt. Use the operator-only
        --    consuming `Retire` choice rather than `archive`, which would require
        --    each desk's authority (Order signatory = operator, desk) that the
        --    operator-authority-only Clear does not carry.
        forA_ orderCids (`exercise` Retire)

        -- 4. Per-desk TradeConfirmation (spec §10 step 4) — observer = that desk
        --    only (the privacy field is frozen in the template). One per
        --    participating desk (each allocation row maps to one desk+side).
        confs <- forA allocations $ \a -> do
          -- AUCT-04: find this desk+side's own order view for its limit / order type.
          -- (One order per desk per round in the MVP, so the head match is exact.)
          let mView = case [ v | v <- views, v.desk == a.desk, v.side == a.side ] of
                (v :: _) -> Some v
                []       -> None
              -- A Noncompetitive order carries no meaningful limit → ownLimit None,
              -- surplusVsLimit 0 (it took the clearing price by construction).
              ownLimitOpt = case mView of
                Some v -> if v.orderType == Noncompetitive then None else Some v.limit
                None   -> None
              surplus = case ownLimitOpt of
                Some l -> tcaSurplusVsLimit a.side l priceDec a.filledQty
                None   -> 0.0
              bpLimit = case ownLimitOpt of
                Some l -> tcaImprovementVsLimitBp l priceDec
                None   -> 0.0
              bpRef = tcaImprovementVsReferenceBp a.side priceDec referencePrice
          -- THE on-ledger AUCT-04 proof (T-09-05-01): execution is at least as good
          -- as this desk's limit. A receipt that violates it ABORTS the atomic settle.
          assertMsg "execution at least as good as limit (surplusVsLimit >= 0)" (surplus >= 0.0)
          create TradeConfirmation with
            operator
            desk          = a.desk
            roundId
            symbol
            side          = a.side
            filledQty     = a.filledQty
            clearingPrice = priceDec
            cashMoved     = intToDecimal a.filledQty * priceDec
            ownLimit                 = ownLimitOpt
            referencePrice
            surplusVsLimit           = surplus
            improvementVsLimitBp     = bpLimit
            improvementVsReferenceBp = bpRef

        -- 5. Settle the Round (spec §10 step 5) and return the verified result.
        _newRound <- create this with status = Settled
        pure ClearResult with
          roundId
          clearingPrice = priceDec
          totalMatched  = totalBuy
          confirmations = confs
