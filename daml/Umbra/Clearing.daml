-- Umbra — the deterministic §8 clearing algorithm as PURE Daml functions.
-- Source: spec §8 (verbatim) + 02-CONTEXT tie-break trap + DA.List signatures
--   (sort/sortOn/dedup verified from SDK 2.10.4 source).
--
-- This module is the SINGLE source of clearing math for the whole build:
--   * Tests.daml's `test_clears_at_100` calls it (the continuous §4 canary).
--   * Plan 02's `Round.Clear` recomputes §8 with it and asserts the proposal
--     matches (the on-ledger security backstop — a wrong/malicious proposal is
--     rejected on-ledger).
--   * Phase 4 mirrors it 1:1 in TypeScript (CLEAR-05 parity).
--
-- It is therefore kept PURE — no Update/Script, no `query`/`queryContractId`
-- (those are Script-only and would not type-check here anyway), no settlement.
-- Math only, a pure function of plain data (`OrderView`), mirrorable in TS.
--
-- Pitfall guards (02-RESEARCH Pitfalls 2 & 4):
--   * every Decimal literal carries a decimal point (`0.0`, `100.0`).
--   * unit quantities stay `Int` end-to-end (no Decimal mixing in the math).
--   * `maxMatched` uses `foldl max 0` (NOT `maximumBy`) for empty-list safety on
--     a no-cross round (where there are no candidate prices / no crossing orders).
module Umbra.Clearing where

import DA.List (sort, sortOn, dedup)

-- §7.3 — order side (verbatim). Defined here (the math leaf module) rather than
-- in Auction so that Auction.Clear can `import Umbra.Clearing (computeClearing)`
-- without a cyclic module dependency (Daml forbids import cycles; no .hs-boot).
-- Re-exported by Umbra.Auction, so `Umbra.Auction.Side` still resolves unchanged
-- for every existing consumer (Roles/Setup/Tests). Record/constructor shape is
-- byte-identical to the Phase-1 definition.
data Side = Buy | Sell deriving (Eq, Show)

-- §7.7 — the solver's verified output (plain data, re-checked on-ledger in Phase 2).
-- Lives in the leaf math module for the same cycle-breaking reason as `Side`;
-- re-exported by Umbra.Auction so `Umbra.Auction.Allocation` is unchanged. The
-- record field shape (desk : Party, side : Side, filledQty : Int) is byte-identical.
data Allocation = Allocation with
    desk      : Party
    side      : Side
    filledQty : Int
  deriving (Eq, Show)

-- §7.3 (AUCT-01) — the order-type discriminator. ADDITIVE: the §4 canonical
-- orders are plain `Limit`, so `orderType`/`minQty`/`firmIf` are INERT until the
-- wave-2 clearing math (09-02/09-03) reads them. Defined here (the pure math
-- leaf, beside OrderView) and re-exported by Umbra.Auction so a single symbol is
-- shared by both planes. `limit : Decimal` is KEPT (effective-limit approach,
-- RESEARCH A1) — Noncompetitive's "willing at any price" is modelled later as an
-- effective ±∞ limit, NOT by making `limit` Optional (smaller blast radius on
-- the frozen field). Byte-mirrored by `type OrderType` in solver/src/auction.ts.
data OrderType = Limit | Noncompetitive | AllOrNone | Conditional
  deriving (Eq, Show)

-- A flattened view of one order, decoupled from the `Order` template so the
-- math is a pure function of plain data — easy to test and to mirror in TS (P4).
-- The three appended fields (orderType/minQty/firmIf) are additive and inert in
-- this plan: demandAt/supplyAt/choosePStar/rationByPriority/computeClearing do
-- NOT read them yet, so §4 still clears $100.00 as a pure reduction.
data OrderView = OrderView with
    desk      : Party
    side      : Side
    quantity  : Int
    limit     : Decimal
    orderType : OrderType         -- AUCT-01 discriminator (defaults to Limit)
    minQty    : Optional Int      -- AllOrNone/MAQ only (inert until 09-02)
    firmIf    : Optional Decimal  -- Conditional only (inert until 09-03)
  deriving (Eq, Show)

isBuy : OrderView -> Bool
isBuy o = o.side == Buy

isSell : OrderView -> Bool
isSell o = o.side == Sell

-- §8 step 2 — Σ qty of buys willing to pay >= p.
demandAt : [OrderView] -> Decimal -> Int
demandAt orders p =
  sum [ o.quantity | o <- orders, isBuy o, o.limit >= p ]

-- §8 step 2 — Σ qty of sells willing to receive <= p.
supplyAt : [OrderView] -> Decimal -> Int
supplyAt orders p =
  sum [ o.quantity | o <- orders, isSell o, o.limit <= p ]

-- §8 step 2 — matched volume at p.
matchedAt : [OrderView] -> Decimal -> Int
matchedAt orders p = min (demandAt orders p) (supplyAt orders p)

-- §8 step 1 — distinct, sorted candidate prices from all limits.
candidatePrices : [OrderView] -> [Decimal]
candidatePrices orders = sort (dedup [ o.limit | o <- orders ])

-- §8 step 3 — choose p* with the TWO-LEVEL tie-break, applied IN ORDER.
--
-- CRITICAL TRAP (02-CONTEXT phase_critical_constraint 1): tie-break (a)
-- "minimize |demand - supply|" is computed ONLY over the candidates that
-- ACHIEVE the max matched volume. Applying it across ALL prices clears the §4
-- fixture at 99 (imbalance 2 < 3) instead of 100. The fix is structural: filter
-- to `topPrices` (the max-matched subset) FIRST, then rank by (imbalance, price).
--
-- The (imbalance, price) tuple exploits lexicographic Ord on tuples: an ascending
-- `sortOn` puts the smallest imbalance first, ties broken by the lower price —
-- exactly tie-break (a) then (b), applied only within the max-matched subset.
choosePStar : [OrderView] -> Decimal
choosePStar orders =
  let prices     = candidatePrices orders
      matches    = [ (p, matchedAt orders p) | p <- prices ]
      -- `foldl max 0` (NOT `maximumBy`) — total on the empty list, seeds the
      -- no-cross round at 0 matched (02-RESEARCH Pitfall 4).
      maxMatched = foldl max 0 [ m | (_, m) <- matches ]
      -- The trap-guard: keep only the prices that achieve max matched volume.
      topPrices  = [ p | (p, m) <- matches, m == maxMatched ]
      -- Tie-break (a) minimize |demand - supply| THEN (b) lower price — applied
      -- ONLY over topPrices.
      ranked     = sortOn (\p -> (abs (demandAt orders p - supplyAt orders p), p)) topPrices
  in case ranked of
       (p :: _) -> p
       []       -> 0.0   -- no candidates => no cross; caller guards.

-- §8 step 4 (long-side rationing) — ration `traded` units across an
-- already-price-ordered list, most-aggressive-first, integer fills, never
-- exceeding each order's quantity nor `traded`.
--
-- MVP tie behavior (accurate to the code below): equal-limit orders are filled in
-- the order the caller already sorted them (price-priority, stable) — NOT a pro-rata
-- split. Strict pro-rata with "leftover unit(s) to the largest order" is deferred:
-- it is not needed for the §4 fixture (which has no equal-limit tie), so this greedy
-- pass alone gives the exact answer (B=8, C=2). The TypeScript mirror (auction.ts)
-- uses the IDENTICAL greedy rule, so the two match bit-for-bit (02-RESEARCH A3).
-- (Daml-LF forbids recursive LOCAL bindings — recursion must be top-level, so
-- `rationByPriority` is itself the recursive function rather than a local `go`.)
rationByPriority : [OrderView] -> Int -> [(OrderView, Int)]
rationByPriority [] _ = []
rationByPriority (o :: rest) remaining =
  let f = min o.quantity remaining
  in (o, f) :: rationByPriority rest (remaining - f)

-- §8 steps 4-5 (SINGLE-PASS CORE) — clear the batch: pick p*, compute traded
-- volume, ration both sides by price priority, and emit an Allocation for EVERY
-- participating eligible order (including 0-fill / partially-filled ones like C,
-- whose residual is `order.quantity - filledQty`) so Plan 02's `Round.Clear` can
-- mark each Order's status.
--
-- `coreClear` is the extracted pure §8 kernel (09-02): it is the ONE function
-- that does candidate-price selection + eligibility + priority rationing. The
-- public `computeClearing` (below) is a TWO-PASS WRAPPER over it (the seam that
-- 09-03 conditional auto-firming rides on). Extracting it is behavior-preserving:
-- with no conditional orders, `computeClearing == coreClear` exactly, so the §4
-- fixture is byte-identical before and after the refactor.
coreClear : [OrderView] -> (Decimal, [Allocation])
coreClear orders =
  let pStar  = choosePStar orders
      traded = matchedAt orders pStar
      -- eligible buys sorted DESCENDING by limit (most-aggressive buy first);
      -- eligible sells sorted ASCENDING by limit (most-aggressive sell first).
      buys   = sortOn (\o -> negate o.limit) [ o | o <- orders, isBuy o,  o.limit >= pStar ]
      sells  = sortOn (.limit)               [ o | o <- orders, isSell o, o.limit <= pStar ]
      buyFills  = rationByPriority buys  traded
      sellFills = rationByPriority sells traded
      allocs =
        [ Allocation with desk = o.desk; side = Buy;  filledQty = f | (o, f) <- buyFills  ] ++
        [ Allocation with desk = o.desk; side = Sell; filledQty = f | (o, f) <- sellFills ]
  in (pStar, allocs)

-- §8 public entry point — a deterministic TWO-PASS wrapper over `coreClear`
-- (09-02 scaffold; `Round.Clear` re-verifies via THIS function, so on-ledger and
-- solver agree). PASS 1 computes a provisional clear over the FIRM (non-conditional)
-- orders; PASS 2 firms each conditional whose `firmIf` qualifies versus the
-- PROVISIONAL p*, drops the rest, and re-clears `firm ++ firmed`.
--
-- In THIS plan the firming rule is not yet implemented: `qualifies` is a TOTAL
-- pass-through (True for every conditional against any provisional price), so
-- `firmed == conditional`, `final == firm ++ conditional == orders`, and the
-- wrapper reduces to a single `coreClear` — i.e. no observable behavior change
-- (the §4 canary stays $100.00 / A=10 / B=8 / C=2). The real `firmIf` test lands
-- in 09-03; the provisional p* it fires against is `provP` here.
computeClearing : [OrderView] -> (Decimal, [Allocation])
computeClearing orders =
  let firm        = [ v | v <- orders, v.orderType /= Conditional ]
      conditional = [ v | v <- orders, v.orderType == Conditional ]
      (provP, _)  = coreClear firm          -- PASS 1: provisional over firm only
      qualifies _v _p = True                -- 09-03 hook: total pass-through today
      firmed      = [ v | v <- conditional, qualifies v provP ]  -- PASS 2 (inert now)
      final       = firm ++ firmed          -- == orders while no conditional firms
  in coreClear final
