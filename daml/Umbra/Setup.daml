-- Umbra — Setup script: allocate the four parties, create the Venue, mint the
-- §4 holdings, submit the canonical round, and provide a parties-export script.
-- This is the seed every later phase and test runs against; the §4 quantities
-- are the SINGLE correctness reference for the whole build (spec §4 / §14).
--
-- Pitfall guards (RESEARCH):
--   * every Decimal literal carries a decimal point (`5000.0`, not `5000`) —
--     Daml does not coerce a bare Int literal into Decimal position (Pitfall 1).
--   * party IDs come back as `hint::<fingerprint>` and are NOT stable across
--     `daml start` boots → captured to parties.json via the export script,
--     never hard-coded (Pitfall 3).
module Umbra.Setup where

import Daml.Script
import Umbra.Roles
import Umbra.Auction
import Umbra.Instrument (InstrumentId(..))
import Umbra.Holding (Holding(..), Split(..))
import Umbra.Compliance (DeskEligibility(..))

-- Frozen shape returned by the export script → becomes parties.json.
data Parties = Parties with
    operator : Party
    bankA    : Party
    bankB    : Party
    bankC    : Party
  deriving (Eq, Show)

-- Allocate the four parties with readable id-hints. The hint controls the
-- readable prefix (`bankA::<fp>`); the fingerprint suffix is still per-boot.
allocateAll : Script Parties
allocateAll = do
  operator <- allocatePartyByHint (PartyIdHint "operator")
  bankA    <- allocatePartyByHint (PartyIdHint "bankA")
  bankB    <- allocatePartyByHint (PartyIdHint "bankB")
  bankC    <- allocatePartyByHint (PartyIdHint "bankC")
  pure Parties with operator, bankA, bankB, bankC

-- §4 token-agnostic InstrumentIds (DFIN-03). The operator is both issuer and
-- custodian in the MVP topology; a different stablecoin/CBDC cash instrument can be
-- swapped in WITHOUT changing Round.Clear (it takes cashInstrument as a parameter).
bondInstrumentOf : Party -> InstrumentId
bondInstrumentOf operator = InstrumentId with issuer = operator; id = "BONDX"

cashInstrumentOf : Party -> InstrumentId
cashInstrumentOf operator = InstrumentId with issuer = operator; id = "USDCx"

-- Mint one operator-custodied `Holding` for `owner` (DFIN-01, replacing mintAsset).
-- All choices on Holding are operator-authority alone, so the operator submits the
-- create. Newly-minted holdings are free (`lock = None`).
mintHolding : Party -> Party -> InstrumentId -> Decimal -> Script (ContractId Holding)
mintHolding operator owner instrument amount =
  submit operator do
    createCmd Holding with operator, owner, instrument, amount, lock = None

-- COMP-01 keyless lookup (D7 Option-B): find a desk's DeskEligibility ContractId
-- from the operator's visible credentials (contract keys are unsupported on Canton
-- LF 2.1 — 11-02). Threaded into every SubmitOrder/CommitOrder call site.
findEligCid : Party -> [(ContractId DeskEligibility, DeskEligibility)] -> Party -> ContractId DeskEligibility
findEligCid operator creds desk =
  case [ cid | (cid, e) <- creds, e.operator == operator, e.desk == desk ] of
    (cid :: _) -> cid
    []         -> error ("findEligCid: no DeskEligibility for " <> show desk)

-- init-script for daml.yaml (`init-script: Umbra.Setup:initialize`). Allocates
-- the four parties, creates one Venue{operator, desks=[A,B,C]}, and mints the
-- EXACT §4 holdings (5 Asset contracts). These quantities are NON-NEGOTIABLE
-- (spec §4 single source of truth) — a wrong literal silently corrupts every
-- downstream test, so test_setup_seeds asserts them.
initialize : Script Parties
initialize = do
  p@Parties{..} <- allocateAll
  -- one Venue, all three desks as observers
  submit operator do
    createCmd Venue with operator, desks = [bankA, bankB, bankC]
  -- COMP-01: seed A/B/C DeskEligibility (accredited + sanctions-clear) BEFORE any
  -- SubmitOrder/CommitOrder so the new on-ledger eligibility gate passes for §4.
  -- operator == compliance for the MVP stub (single trust domain).
  let mkElig desk = submit operator do
        createCmd DeskEligibility with
          operator; compliance = operator; desk
          accredited = True; jurisdiction = "US"; sanctionsClear = True
  _ <- mkElig bankA
  _ <- mkElig bankB
  _ <- mkElig bankC
  -- §4 holdings, now as token-agnostic `Holding`s (DFIN-01/03; every Decimal
  -- literal carries a decimal point). Quantities are NON-NEGOTIABLE (spec §4):
  --   BankA → 5,000 USDCx
  --   BankB → 20 BONDX + 1,000 USDCx
  --   BankC → 15 BONDX + 1,000 USDCx
  let bond = bondInstrumentOf operator
      cash = cashInstrumentOf operator
  _ <- mintHolding operator bankA cash 5000.0
  _ <- mintHolding operator bankB bond 20.0
  _ <- mintHolding operator bankB cash 1000.0
  _ <- mintHolding operator bankC bond 15.0
  _ <- mintHolding operator bankC cash 1000.0
  pure p

-- Export script: run SEPARATELY against the live sandbox with
-- `daml script ... --output-file parties.json`, which writes this return value
-- (the Parties record) as Daml-LF JSON for downstream phases (LEDG-02).
exportParties : Script Parties
exportParties = allocateAll

-- Submit the three §4 orders via Venue.SubmitOrder (spec §4 + §14). Order
-- quantities are Int (no decimal point); limit prices are Decimal (decimal
-- point). The Venue is nonconsuming, so all three submissions hit the same cid.
runCanonicalRound : Script ()
runCanonicalRound = do
  Parties{..} <- initialize
  -- The init-script created exactly one Venue, signed by operator; find it.
  venues <- query @Venue operator
  let (venueCid, _) = case venues of
        (v :: _) -> v
        []       -> error "runCanonicalRound: no Venue found after initialize"
  -- COMP-01: gather each desk's eligibility credential (keyless) to gate SubmitOrder.
  creds <- query @DeskEligibility operator
  -- A Buy 10 @ 101, B Sell 8 @ 99, C Sell 5 @ 100 (each submitted by its desk).
  submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankB
  submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankC
  pure ()
  -- DEFERRED to Phase 2: open a Round, CloseRound, then Round.Clear and assert
  -- clearingPrice == 100.0 with fills A=10 / B=8 / C=2 (C residual 3 unfilled).
  -- Clear is a loud Phase-1 placeholder (assertMsg False) — do NOT call it here.

-- CLEAR-01 — the screenshot-ready OPEN-round seed for the Phase-3 money shot.
-- Mirrors runCanonicalRound (submits the three §4 orders each under its own desk
-- authority) but ALSO opens a `Round{status = Open}` and creates a
-- `RoundStats{sealedOrderCount = 3}` so the 3-up Privacy view renders live data
-- WITHOUT a solver service:
--   * each desk's per-party `query @Order` returns ONLY its own sealed order;
--   * every desk's `query @RoundStats` reads the shared count = 3 (observer = desks).
-- The round is left OPEN on purpose — the live Open→Closed→Cleared→Settled
-- lifecycle and the solver's RoundStats auto-increment are Phase 4 (CLEAR-01 /
-- D-deferred). Here the count is SEEDED to 3, never computed.
seedOpenRound : Script Parties
seedOpenRound = do
  p@Parties{..} <- initialize
  -- (1) Open the Round (operator signatory; desks observe). openedAt from getTime.
  now <- getTime
  submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open
  -- (2) Find the seeded Venue (one created by initialize) and submit the §4 orders
  --     each under its OWN desk authority (Int quantities, Decimal limits).
  venues <- query @Venue operator
  let (venueCid, _) = case venues of
        (v :: _) -> v
        []       -> error "seedOpenRound: no Venue found after initialize"
  creds <- query @DeskEligibility operator
  submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankB
  submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankC
  -- (3) Seed RoundStats{count = 3} (operator-signed; observer = desks) — the ONLY
  --     pre-clear shared info any desk may read.
  submit operator do
    createCmd RoundStats with
      operator
      roundId          = "R1"
      desks            = [bankA, bankB, bankC]
      sealedOrderCount = 3
  -- Return the Parties so this can serve as the `daml start` init-script and the
  -- `--output-file parties.json` export simultaneously (one allocation pass → the
  -- exported IDs match the seeded Round/orders, so minted tokens authenticate
  -- against the live money-shot state).
  pure p

-- ===========================================================================
-- CRYP-01 (10-01) — §4 commit → reveal → clear seed. The canonical §4 batch,
-- now routed through the on-ledger commit–reveal binding, still clears exactly
-- $100.00 / A=10 / B=8 / C=2. Everything the real `Round.Clear` needs is
-- collected at the Script tier (Option-B ContractIds) and returned so the caller
-- drives the SAME settle path — Round.Clear and the §8 math are untouched.
-- ===========================================================================

-- Everything the real `Round.Clear` needs to settle the §4 commit→reveal batch.
-- Holdings-migrated (DFIN-01): the buyer cash + seller bond legs are `Holding`s;
-- `buyerCashCids` is the list Round.Clear now takes (generalized N-buyer form).
data CommitRevealSeed = CommitRevealSeed with
    parties        : Parties
    roundCid       : ContractId Round
    orderCids      : [ContractId Order]
    buyerCashCids  : [(Party, ContractId Holding)]
    sellerBondCids : [(Party, ContractId Holding)]

-- The small per-desk cash bond carved from each desk's OWN §4 cash (so total
-- value is conserved and the §4 finals stay exact). It MUST be < the §4
-- cash-needed threshold (the buyer pays 1000 cash), so the buyer's cash leg
-- selects the large trade remainder, never a released bond slice.
commitRevealBond : Decimal
commitRevealBond = 10.0

-- Mint the §4 holdings, carve a small USDCx bond per desk, open a Round, and for
-- each §4 order: compute the on-ledger commitment, CommitOrder (lock the bond),
-- RevealOrder (recompute sha256 on-ledger, release the bond, create the sealed
-- Order). Then CloseRound and gather the Option-B ContractIds.
seedCommitRevealRound : Script CommitRevealSeed
seedCommitRevealRound = do
  p@Parties{..} <- initialize
  let bond = bondInstrumentOf operator
      cash = cashInstrumentOf operator
  -- Carve a bond slice from each desk's own cash Holding (operator is the custodian).
  usdc0 <- query @Holding operator
  let cashCidFor owner =
        case [ cid | (cid, h) <- usdc0, h.owner == owner, h.instrument == cash ] of
          (cid :: _) -> cid
          []         -> error ("seedCommitRevealRound: no cash Holding for " <> show owner)
  (aBond, _) <- submit operator do exerciseCmd (cashCidFor bankA) Split with splitQty = commitRevealBond
  (bBond, _) <- submit operator do exerciseCmd (cashCidFor bankB) Split with splitQty = commitRevealBond
  (cBond, _) <- submit operator do exerciseCmd (cashCidFor bankC) Split with splitQty = commitRevealBond
  -- Open the Round.
  now <- getTime
  roundCid0 <- submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open
  -- Find the seeded Venue + the eligibility credentials (COMP-01 gate on CommitOrder).
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "seedCommitRevealRound: no Venue found after initialize"
  creds <- query @DeskEligibility operator
  -- Per desk: COMMIT (hash + lock bond, eligibility-gated) then REVEAL (recompute
  -- on-ledger + Order). The bond is now a cash Holding; the serializeOrder/sha256
  -- commitment body is BYTE-UNCHANGED (only the bond field TYPE changed).
  ocA <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"
      commitment = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
      bondCid = aBond; cashInstrument = cash; eligCid = findEligCid operator creds bankA
  oa <- submit bankA do
    exerciseCmd ocA RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  ocB <- submit bankB do
    exerciseCmd venueCid CommitOrder with
      desk = bankB; roundId = "R1"
      commitment = commitOf (serializeOrder Sell 8 99.0 Limit None None) "saltB"
      bondCid = bBond; cashInstrument = cash; eligCid = findEligCid operator creds bankB
  ob <- submit bankB do
    exerciseCmd ocB RevealOrder with
      side = Sell; quantity = 8; limit = 99.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltB"
  ocC <- submit bankC do
    exerciseCmd venueCid CommitOrder with
      desk = bankC; roundId = "R1"
      commitment = commitOf (serializeOrder Sell 5 100.0 Limit None None) "saltC"
      bondCid = cBond; cashInstrument = cash; eligCid = findEligCid operator creds bankC
  oc <- submit bankC do
    exerciseCmd ocC RevealOrder with
      side = Sell; quantity = 5; limit = 100.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltC"
  -- Close the round → the recreated Closed contract is what Clear settles.
  roundCid <- submit operator do exerciseCmd roundCid0 CloseRound
  -- Gather the Option-B ContractIds. The buyer's cash leg needs a SINGLE cash
  -- Holding >= 1000 (the §4 cash needed) — pick the large trade remainder, never
  -- the released 10.0 bond slice (the load-bearing reason bond < 1000).
  holdings <- query @Holding operator
  let buyerCashCid =
        case [ cid | (cid, h) <- holdings, h.owner == bankA, h.instrument == cash, h.amount >= 1000.0 ] of
          (cid :: _) -> cid
          []         -> error "seedCommitRevealRound: no sufficient cash Holding (>=1000) for the buyer"
      bondCidOf owner =
        case [ cid | (cid, h) <- holdings, h.owner == owner, h.instrument == bond ] of
          (cid :: _) -> cid
          []         -> error ("seedCommitRevealRound: no bond Holding for " <> show owner)
  pure CommitRevealSeed with
    parties        = p
    roundCid
    orderCids      = [oa, ob, oc]
    buyerCashCids  = [(bankA, buyerCashCid)]
    sellerBondCids = [(bankB, bondCidOf bankB), (bankC, bondCidOf bankC)]

-- ===========================================================================
-- DFIN-02 / DFIN-03 / WOW-07 (11-06) — a 2-buyer × 2-seller GOLDEN seed that
-- runs through the REAL, generalized `Round.Clear` (not the pure Settlement
-- layer of `test_netting_conserves`). Two buyers (A, D) and two sellers (B, C)
-- cross at ONE uniform price p*=100; a fourth GUEST desk (bankD) participates as
-- a first-class, eligibility-gated desk — the same structural per-party privacy
-- as A/B/C (WOW-07). Parameterized by the cash instrument id so the SAME batch
-- can settle with a non-USDCx cash token unchanged (DFIN-03, token-agnostic).
--
-- The book (candidate prices {101,100,99}):
--   A Buy 6 @101 · D Buy 4 @100   (demand)
--   B Sell 7 @99 · C Sell 3 @100  (supply)
--   @99 : demand 10, supply 7  → matched 7  (imbalance 3)
--   @100: demand 10, supply 10 → matched 10 (imbalance 0)  ← unique max-matched
--   @101: demand 6,  supply 10 → matched 6  (imbalance 4)
--   ⇒ p*=100 (unique), everyone fully filled: A=6 / D=4 / B=7 / C=3.
--   Cash: A pays 600, D pays 400 (Σ 1000). Bond: B delivers 7, C delivers 3 (Σ 10).
-- ===========================================================================

-- Everything the real `Round.Clear` needs to settle the 2×2 golden, plus the
-- verified allocation and the four desks (bankD is the guest) so tests can drive
-- Clear and prove per-party privacy without re-deriving anything.
data MultiBuyerSeed = MultiBuyerSeed with
    operator       : Party
    bankA          : Party   -- buyer, fills 6
    bankB          : Party   -- seller, fills 7
    bankC          : Party   -- seller, fills 3
    bankD          : Party   -- GUEST buyer, fills 4 (WOW-07)
    roundCid       : ContractId Round
    orderCids      : [ContractId Order]
    buyerCashCids  : [(Party, ContractId Holding)]   -- A, D
    sellerBondCids : [(Party, ContractId Holding)]   -- B, C
    cashInstrument : InstrumentId                     -- the cash token this batch used (USDCx or a swapped-in token)
    bondInstrument : InstrumentId
    allocations    : [Allocation]                     -- the verified 2×2 clear (A=6/D=4/B=7/C=3)

-- Seed the 2×2 golden with a caller-chosen cash instrument id (DFIN-03). All four
-- desks are registered + eligible; buyers fund their EXACT cash legs, sellers fund
-- their EXACT bond legs; the round is opened, the four sealed orders submitted
-- (each under its OWN desk authority, eligibility-gated), and closed. The caller
-- drives the SAME `Round.Clear` used by §4 — nothing here is hardcoded to "USDCx".
seedMultiBuyerRound : Text -> Script MultiBuyerSeed
seedMultiBuyerRound cashId = do
  operator <- allocatePartyByHint (PartyIdHint "operator")
  bankA    <- allocatePartyByHint (PartyIdHint "bankA")
  bankB    <- allocatePartyByHint (PartyIdHint "bankB")
  bankC    <- allocatePartyByHint (PartyIdHint "bankC")
  bankD    <- allocatePartyByHint (PartyIdHint "bankD")   -- the guest desk
  let bond = bondInstrumentOf operator
      cash = InstrumentId with issuer = operator; id = cashId

  -- Venue registers ALL FOUR desks (the guest is a first-class participant).
  venueCid <- submit operator do
    createCmd Venue with operator, desks = [bankA, bankB, bankC, bankD]

  -- COMP-01: every desk (guest included) holds an eligible credential.
  let mkElig desk = submit operator do
        createCmd DeskEligibility with
          operator; compliance = operator; desk
          accredited = True; jurisdiction = "US"; sanctionsClear = True
  _ <- mkElig bankA
  _ <- mkElig bankB
  _ <- mkElig bankC
  _ <- mkElig bankD
  creds <- query @DeskEligibility operator

  -- Fund the EXACT DvP legs: buyers' cash, sellers' bond (so totals are unambiguous).
  aCash <- mintHolding operator bankA cash 600.0
  dCash <- mintHolding operator bankD cash 400.0
  bBond <- mintHolding operator bankB bond 7.0
  cBond <- mintHolding operator bankC bond 3.0

  -- Open the Round (desks observe; guest included).
  now <- getTime
  roundCid0 <- submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC, bankD]
      openedAt      = now
      windowSeconds = 60
      status        = Open

  -- The four sealed §11 orders (each under its OWN desk authority, eligibility-gated).
  oa <- submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 6; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  od <- submit bankD do
    exerciseCmd venueCid SubmitOrder with
      desk = bankD; roundId = "R1"; side = Buy;  quantity = 4; limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankD
  ob <- submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 7; limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankB
  oc <- submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 3; limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankC

  -- CloseRound → the recreated Closed contract is what Clear settles.
  roundCid <- submit operator do exerciseCmd roundCid0 CloseRound

  pure MultiBuyerSeed with
    operator; bankA; bankB; bankC; bankD
    roundCid
    orderCids      = [oa, od, ob, oc]
    buyerCashCids  = [(bankA, aCash), (bankD, dCash)]
    sellerBondCids = [(bankB, bBond), (bankC, cBond)]
    cashInstrument = cash
    bondInstrument = bond
    allocations    =
      [ Allocation with desk = bankA; side = Buy;  filledQty = 6
      , Allocation with desk = bankD; side = Buy;  filledQty = 4
      , Allocation with desk = bankB; side = Sell; filledQty = 7
      , Allocation with desk = bankC; side = Sell; filledQty = 3
      ]
