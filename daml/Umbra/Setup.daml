-- Umbra — Setup script: allocate the four parties, create the Venue, mint the
-- §4 holdings, submit the canonical round, and provide a parties-export script.
-- This is the seed every later phase and test runs against; the §4 quantities
-- are the SINGLE correctness reference for the whole build (spec §4 / §14).
--
-- Pitfall guards (RESEARCH):
--   * every Decimal literal carries a decimal point (`5000.0`, not `5000`) —
--     Daml does not coerce a bare Int literal into Decimal position (Pitfall 1).
--   * party IDs come back as `hint::<fingerprint>` and are NOT stable across
--     `daml start` boots → captured to parties.json via the export script,
--     never hard-coded (Pitfall 3).
module Umbra.Setup where

import Daml.Script
import Umbra.Asset
import Umbra.Roles
import Umbra.Auction

-- Frozen shape returned by the export script → becomes parties.json.
data Parties = Parties with
    operator : Party
    bankA    : Party
    bankB    : Party
    bankC    : Party
  deriving (Eq, Show)

-- Allocate the four parties with readable id-hints. The hint controls the
-- readable prefix (`bankA::<fp>`); the fingerprint suffix is still per-boot.
allocateAll : Script Parties
allocateAll = do
  operator <- allocatePartyByHint (PartyIdHint "operator")
  bankA    <- allocatePartyByHint (PartyIdHint "bankA")
  bankB    <- allocatePartyByHint (PartyIdHint "bankB")
  bankC    <- allocatePartyByHint (PartyIdHint "bankC")
  pure Parties with operator, bankA, bankB, bankC

-- Mint one operator-custodied Asset for `owner`. All choices on Asset are
-- operator-authority alone, so the operator submits the create.
mintAsset : Party -> Party -> Text -> Decimal -> Script (ContractId Asset)
mintAsset operator owner symbol quantity =
  submit operator do
    createCmd Asset with operator, owner, symbol, quantity

-- init-script for daml.yaml (`init-script: Umbra.Setup:initialize`). Allocates
-- the four parties, creates one Venue{operator, desks=[A,B,C]}, and mints the
-- EXACT §4 holdings (5 Asset contracts). These quantities are NON-NEGOTIABLE
-- (spec §4 single source of truth) — a wrong literal silently corrupts every
-- downstream test, so test_setup_seeds asserts them.
initialize : Script Parties
initialize = do
  p@Parties{..} <- allocateAll
  -- one Venue, all three desks as observers
  submit operator do
    createCmd Venue with operator, desks = [bankA, bankB, bankC]
  -- §4 holdings (every Decimal literal carries a decimal point):
  --   BankA → 5,000 USDCx
  --   BankB → 20 BONDX + 1,000 USDCx
  --   BankC → 15 BONDX + 1,000 USDCx
  mintAsset operator bankA "USDCx" 5000.0
  mintAsset operator bankB "BONDX" 20.0
  mintAsset operator bankB "USDCx" 1000.0
  mintAsset operator bankC "BONDX" 15.0
  mintAsset operator bankC "USDCx" 1000.0
  pure p

-- Export script: run SEPARATELY against the live sandbox with
-- `daml script ... --output-file parties.json`, which writes this return value
-- (the Parties record) as Daml-LF JSON for downstream phases (LEDG-02).
exportParties : Script Parties
exportParties = allocateAll

-- Submit the three §4 orders via Venue.SubmitOrder (spec §4 + §14). Order
-- quantities are Int (no decimal point); limit prices are Decimal (decimal
-- point). The Venue is nonconsuming, so all three submissions hit the same cid.
runCanonicalRound : Script ()
runCanonicalRound = do
  Parties{..} <- initialize
  -- The init-script created exactly one Venue, signed by operator; find it.
  venues <- query @Venue operator
  let (venueCid, _) = case venues of
        (v :: _) -> v
        []       -> error "runCanonicalRound: no Venue found after initialize"
  -- A Buy 10 @ 101, B Sell 8 @ 99, C Sell 5 @ 100 (each submitted by its desk).
  submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
  submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
  submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
  pure ()
  -- DEFERRED to Phase 2: open a Round, CloseRound, then Round.Clear and assert
  -- clearingPrice == 100.0 with fills A=10 / B=8 / C=2 (C residual 3 unfilled).
  -- Clear is a loud Phase-1 placeholder (assertMsg False) — do NOT call it here.

-- CLEAR-01 — the screenshot-ready OPEN-round seed for the Phase-3 money shot.
-- Mirrors runCanonicalRound (submits the three §4 orders each under its own desk
-- authority) but ALSO opens a `Round{status = Open}` and creates a
-- `RoundStats{sealedOrderCount = 3}` so the 3-up Privacy view renders live data
-- WITHOUT a solver service:
--   * each desk's per-party `query @Order` returns ONLY its own sealed order;
--   * every desk's `query @RoundStats` reads the shared count = 3 (observer = desks).
-- The round is left OPEN on purpose — the live Open→Closed→Cleared→Settled
-- lifecycle and the solver's RoundStats auto-increment are Phase 4 (CLEAR-01 /
-- D-deferred). Here the count is SEEDED to 3, never computed.
seedOpenRound : Script Parties
seedOpenRound = do
  p@Parties{..} <- initialize
  -- (1) Open the Round (operator signatory; desks observe). openedAt from getTime.
  now <- getTime
  submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open
  -- (2) Find the seeded Venue (one created by initialize) and submit the §4 orders
  --     each under its OWN desk authority (Int quantities, Decimal limits).
  venues <- query @Venue operator
  let (venueCid, _) = case venues of
        (v :: _) -> v
        []       -> error "seedOpenRound: no Venue found after initialize"
  submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
  submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
  submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
  -- (3) Seed RoundStats{count = 3} (operator-signed; observer = desks) — the ONLY
  --     pre-clear shared info any desk may read.
  submit operator do
    createCmd RoundStats with
      operator
      roundId          = "R1"
      desks            = [bankA, bankB, bankC]
      sealedOrderCount = 3
  -- Return the Parties so this can serve as the `daml start` init-script and the
  -- `--output-file parties.json` export simultaneously (one allocation pass → the
  -- exported IDs match the seeded Round/orders, so minted tokens authenticate
  -- against the live money-shot state).
  pure p

-- ===========================================================================
-- CRYP-01 (10-01) — §4 commit → reveal → clear seed. The canonical §4 batch,
-- now routed through the on-ledger commit–reveal binding, still clears exactly
-- $100.00 / A=10 / B=8 / C=2. Everything the real `Round.Clear` needs is
-- collected at the Script tier (Option-B ContractIds) and returned so the caller
-- drives the SAME settle path — Round.Clear and the §8 math are untouched.
-- ===========================================================================

-- Everything the real `Round.Clear` needs to settle the §4 commit→reveal batch.
data CommitRevealSeed = CommitRevealSeed with
    parties        : Parties
    roundCid       : ContractId Round
    orderCids      : [ContractId Order]
    buyerUsdcCid   : ContractId Asset
    sellerBondCids : [(Party, ContractId Asset)]

-- The small per-desk USDCx bond carved from each desk's OWN §4 cash (so total
-- value is conserved and the §4 finals stay exact). It MUST be < the §4
-- cash-needed threshold (the buyer pays 1000 USDCx), so the buyer's cash leg
-- selects the large trade remainder, never a released bond slice.
commitRevealBond : Decimal
commitRevealBond = 10.0

-- Mint the §4 holdings, carve a small USDCx bond per desk, open a Round, and for
-- each §4 order: compute the on-ledger commitment, CommitOrder (lock the bond),
-- RevealOrder (recompute sha256 on-ledger, release the bond, create the sealed
-- Order). Then CloseRound and gather the Option-B ContractIds.
seedCommitRevealRound : Script CommitRevealSeed
seedCommitRevealRound = do
  p@Parties{..} <- initialize
  -- Carve a bond slice from each desk's own USDCx (operator is the Asset custodian).
  usdc0 <- query @Asset operator
  let usdcCidFor owner =
        case [ cid | (cid, a) <- usdc0, a.owner == owner, a.symbol == "USDCx" ] of
          (cid :: _) -> cid
          []         -> error ("seedCommitRevealRound: no USDCx for " <> show owner)
  (aBond, _) <- submit operator do exerciseCmd (usdcCidFor bankA) Split with splitQty = commitRevealBond
  (bBond, _) <- submit operator do exerciseCmd (usdcCidFor bankB) Split with splitQty = commitRevealBond
  (cBond, _) <- submit operator do exerciseCmd (usdcCidFor bankC) Split with splitQty = commitRevealBond
  -- Open the Round.
  now <- getTime
  roundCid0 <- submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open
  -- Find the seeded Venue.
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "seedCommitRevealRound: no Venue found after initialize"
  -- Per desk: COMMIT (hash + lock bond) then REVEAL (recompute on-ledger + Order).
  ocA <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"
      commitment = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
      bondCid = aBond
  oa <- submit bankA do
    exerciseCmd ocA RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  ocB <- submit bankB do
    exerciseCmd venueCid CommitOrder with
      desk = bankB; roundId = "R1"
      commitment = commitOf (serializeOrder Sell 8 99.0 Limit None None) "saltB"
      bondCid = bBond
  ob <- submit bankB do
    exerciseCmd ocB RevealOrder with
      side = Sell; quantity = 8; limit = 99.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltB"
  ocC <- submit bankC do
    exerciseCmd venueCid CommitOrder with
      desk = bankC; roundId = "R1"
      commitment = commitOf (serializeOrder Sell 5 100.0 Limit None None) "saltC"
      bondCid = cBond
  oc <- submit bankC do
    exerciseCmd ocC RevealOrder with
      side = Sell; quantity = 5; limit = 100.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltC"
  -- Close the round → the recreated Closed contract is what Clear settles.
  roundCid <- submit operator do exerciseCmd roundCid0 CloseRound
  -- Gather the Option-B ContractIds. The buyer's cash leg needs a SINGLE USDCx
  -- holding >= 1000 (the §4 cash needed) — pick the large trade remainder, never
  -- the released 10.0 bond slice (the load-bearing reason bond < 1000).
  assets <- query @Asset operator
  let buyerUsdcCid =
        case [ cid | (cid, a) <- assets, a.owner == bankA, a.symbol == "USDCx", a.quantity >= 1000.0 ] of
          (cid :: _) -> cid
          []         -> error "seedCommitRevealRound: no sufficient USDCx (>=1000) for the buyer"
      bondCidOf owner =
        case [ cid | (cid, a) <- assets, a.owner == owner, a.symbol == "BONDX" ] of
          (cid :: _) -> cid
          []         -> error ("seedCommitRevealRound: no BONDX for " <> show owner)
  pure CommitRevealSeed with
    parties        = p
    roundCid
    orderCids      = [oa, ob, oc]
    buyerUsdcCid
    sellerBondCids = [(bankB, bondCidOf bankB), (bankC, bondCidOf bankC)]
