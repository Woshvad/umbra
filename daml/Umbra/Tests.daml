-- Umbra — Wave-0 Daml Script validation scaffolds (spec §16; this phase only
-- needs the "seeds + compiles" smoke — clearing/settlement/privacy tests 1-6
-- arrive in Phases 2-3). Run with `daml test` (exit code is authoritative).
--
--   * test_setup_seeds      (LEDG-02): initialize seeds 4 parties + the exact
--                            §4 holdings (5 Asset contracts).
--   * test_asset_split_merge(LEDG-03): operator Split then Merge preserve total
--                            quantity (conservation); out-of-range Split rejected.
module Umbra.Tests where

import Daml.Script
import DA.Assert
import DA.Foldable (forA_)
import DA.List (sort)
import Umbra.Setup
import Umbra.Auction
  ( Side(..), Allocation(..)
  , Order, Round(..), RoundStatus(..), TradeConfirmation, RoundStats(..)
  , CloseRound(..), Clear(..)
  , OrderCommitment(..), RevealOrder(..), ForfeitBond(..), ProofAnchor(..)
  , commitOf, serializeOrder
  )
import Umbra.Roles (Venue(..), SubmitOrder(..), CommitOrder(..), IssueHolding(..), AnchorProof(..))
import Umbra.Clearing
import Umbra.Compliance (DeskEligibility(..), isEligible)
-- IDEN-03 (12-01): the four-eyes clearing-approval templates + gate. The tests
-- allocate a DEDICATED `compliance` dev party (distinct from operator) so the
-- signatory SEPARATION is real while `daml test` runs headless.
import Umbra.Approval
  ( ClearingApproval(..), ClearingApprovalRequest(..)
  , ApproveClearing(..), RejectClearing(..)
  )
import Umbra.Instrument (InstrumentId(..))
import Umbra.Holding (Holding(..), Split(..), Merge(..), Reassign(..))
import Umbra.Settlement
  ( Instruction(..)
  , buildGrossInstructions, netLegs, conservationOk, settleBatch
  )
-- ADJ-02 (13-06): the keyless RFQ side-mode — a firm signed Quote accepted by the
-- requester settles a 1×1 batch via the SAME Umbra.Settlement.settleBatch DvP path.
import Umbra.Rfq (RfqRequest(..), Quote(..), AcceptQuote(..))

-- LEDG-02 — the §4 seed is the single correctness reference. Assert that after
-- `initialize` the operator sees exactly the 5 §4 `Holding`s with the right
-- owner/instrument/amount (DFIN-01: holdings, not Assets). A wrong mint literal
-- fails here instead of silently corrupting every downstream test (threat T-01-07).
test_setup_seeds : Script ()
test_setup_seeds = do
  Parties{..} <- initialize
  let bond = bondInstrumentOf operator
      cash = cashInstrumentOf operator
  holdings <- query @Holding operator
  -- Exactly 5 Holding contracts minted.
  length holdings === 5
  let held = [(h.owner, h.instrument, h.amount) | (_, h) <- holdings]
  -- The four parties are distinct.
  assertMsg "parties must be distinct"
    (operator /= bankA && bankA /= bankB && bankB /= bankC && operator /= bankC)
  -- Every §4 holding is present (owner, instrument, amount).
  let expected =
        [ (bankA, cash, 5000.0)
        , (bankB, bond, 20.0)
        , (bankB, cash, 1000.0)
        , (bankC, bond, 15.0)
        , (bankC, cash, 1000.0)
        ]
  forA_ expected $ \h ->
    assertMsg ("missing expected §4 holding: " <> show h) (h `elem` held)

-- LEDG-03 — operator-only Split/Merge preserve total amount. Mint 10.0 of a bond
-- Holding, Split into 4.0 + 6.0 (conservation: sum == original), then Merge back to
-- 10.0. Also prove the ensure/assert guard rejects an out-of-range splitQty.
test_holding_split_merge : Script ()
test_holding_split_merge = do
  Parties{operator, bankB} <- allocateAll
  let bond = bondInstrumentOf operator
  holdingCid <- mintHolding operator bankB bond 10.0

  -- Split 10.0 -> (4.0, 6.0)
  (aCid, bCid) <- submit operator do
    exerciseCmd holdingCid Split with splitQty = 4.0
  a <- queryContractId operator aCid
  b <- queryContractId operator bCid
  case (a, b) of
    (Some av, Some bv) -> do
      av.amount === 4.0
      bv.amount === 6.0
      -- conservation: the two halves sum to the original.
      (av.amount + bv.amount) === 10.0
    _ -> abort "Split did not produce two Holding contracts"

  -- Merge (4.0) back with (6.0) -> 10.0
  mergedCid <- submit operator do
    exerciseCmd aCid Merge with otherCid = bCid
  merged <- queryContractId operator mergedCid
  case merged of
    Some mv -> mv.amount === 10.0
    None    -> abort "Merge did not produce a merged Holding"

  -- Edge: out-of-range Split (>= amount) is rejected by the assertMsg guard.
  submitMustFail operator do
    exerciseCmd mergedCid Split with splitQty = 10.0

-- CLEAR-04 — THE §8 canary, the build's continuous correctness reference
-- (CLAUDE.md rule 3). Runs the PURE `computeClearing` on the §4 fixture (no
-- ledger needed — the tightest guardrail isolating the §8 trap from settlement)
-- and asserts BOTH the price AND the fills:
--   * p* == 100.0 (NOT 99.0 — the tie-break must stay scoped to the max-matched
--     set {100,101}; across all prices 99 has the smaller imbalance and would win)
--   * fills A=10 / B=8 / C=2  (C residual = 5 - 2 = 3)
-- If the tie-break ever escapes the max-matched subset, this test fails LOUDLY.
test_clears_at_100 : Script ()
test_clears_at_100 = do
  -- throwaway parties for the OrderView `desk` fields (the §4 desks).
  bankA <- allocatePartyByHint (PartyIdHint "bankA")
  bankB <- allocatePartyByHint (PartyIdHint "bankB")
  bankC <- allocatePartyByHint (PartyIdHint "bankC")

  -- §4 fixture: A Buy 10 @101, B Sell 8 @99, C Sell 5 @100 (Decimal limits,
  -- Int quantities — never compare an Int fill against a Decimal).
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 99.0;  orderType = Limit; minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Limit; minQty = None; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      -- sum the filledQty for all allocations matching a desk.
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]

  -- The price clears at exactly 100.0 ...
  pStar === 100.0
  -- ... and NOT at 99.0 — a loud, named failure if the tie-break trap reappears.
  assertMsg "TIE-BREAK TRAP: cleared at 99 — tie-break escaped the max-matched subset"
    (pStar /= 99.0)

  -- Fills: A=10, B=8, C=2.
  fillOf bankA === 10
  fillOf bankB === 8
  fillOf bankC === 2
  -- C's residual: order qty (5) minus its fill (2) == 3.
  (5 - fillOf bankC) === 3

-- AUCT-01 (09-02) — NONCOMPETITIVE golden fixture, the Daml twin of the
-- `noncomp` scenario in solver/src/auction.test.ts (identical expected numbers =
-- Daml⇄TS parity). A noncompetitive SELL (C) sits alongside a competitive limit
-- buy (A) + competitive limit sell (B). C is willing at ANY price and rations
-- with TOP priority, capped at its qty; B is competitive and rationed AFTER C.
-- Noncomp is kept on the SELL side (single funded buyer — Pitfall 3).
--
--   A Buy 6 @100 (Limit)          demand@100 = 6
--   B Sell 5 @100 (Limit)         competitive supply@100 = 5
--   C Sell 4      (Noncompetitive) supply@ANY = 4   (limit field ignored; 0.0)
--
--   candidatePrices excludes noncomp → {100}.
--   @100: demand 6, supply 5+4 = 9 → matched 6 = traded.
--   Sells by priority: C (noncomp) first fills 4; B (competitive) fills the
--   remaining 2. Buys: A fills 6.
--   ⇒ p* = 100.00, fills A = 6 / B = 2 / C = 4 (noncomp C top-priority, full qty).
--
-- Discriminating: if priority were reversed, competitive B (qty 5) would fill 5
-- and noncomp C only 1 — so this fixture proves top priority, not just any fill.
test_noncomp_sell_top_priority : Script ()
test_noncomp_sell_top_priority = do
  bankA <- allocatePartyByHint (PartyIdHint "ncA")
  bankB <- allocatePartyByHint (PartyIdHint "ncB")
  bankC <- allocatePartyByHint (PartyIdHint "ncC")

  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 6; limit = 100.0; orderType = Limit;          minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 5; limit = 100.0; orderType = Limit;          minQty = None; firmIf = None
        -- Noncompetitive: `limit` is ignored (0.0 sentinel = willing at any price).
        , OrderView with desk = bankC; side = Sell; quantity = 4; limit = 0.0;   orderType = Noncompetitive; minQty = None; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]

  -- Clears at the single competitive candidate price.
  pStar === 100.0
  -- Noncomp C fills FIRST and FULLY (capped at its qty 4); competitive B rationed to 2.
  fillOf bankC === 4
  fillOf bankB === 2
  fillOf bankA === 6
  -- Conservation: buy fills == sell fills == traded (6).
  fillOf bankA === (fillOf bankB + fillOf bankC)
  -- The §4 canary is UNAFFECTED by the noncomp predicate (proven in test_clears_at_100).

-- AUCT-01 (09-03) — ALLORNONE / MAQ golden fixtures, the Daml twins of the
-- `maq`/`aon` scenarios in solver/src/auction.test.ts (identical expected numbers
-- = Daml⇄TS parity). A MAQ order participates only if its integer fill ≥ minQty at
-- the chosen (price, subset); else the bounded (price × subset) enumeration in
-- `coreClear` EXCLUDES it. All-or-none is the special case minQty == quantity.

-- MAQ EXCLUDED — C's fill (2) would fall BELOW its minQty (3) → C excluded, and
-- the book re-clears without it (A=8 / B=8, C=0).
--   A Buy 10 @100, B Sell 8 @100, C Sell 5 @100 (MAQ minQty=3).
--   subset {C}: @100 matched 10, sells B,C by priority → B=8, C=2. C 2 < 3 → INFEASIBLE.
--   subset {}:  @100 matched 8  → A=8, B=8. FEASIBLE and wins (only feasible).
test_maq_excluded : Script ()
test_maq_excluded = do
  bankA <- allocatePartyByHint (PartyIdHint "maqXA")
  bankB <- allocatePartyByHint (PartyIdHint "maqXB")
  bankC <- allocatePartyByHint (PartyIdHint "maqXC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 3; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- excluded: its feasible fill (2) < minQty (3)
  fillOf bankA === 8
  fillOf bankB === 8

-- MAQ INCLUDED — same book, but minQty=2, which C's fill (2) exactly MEETS → C is
-- included and the §4-shaped clear stands (A=10 / B=8 / C=2).
test_maq_included : Script ()
test_maq_included = do
  bankA <- allocatePartyByHint (PartyIdHint "maqIA")
  bankB <- allocatePartyByHint (PartyIdHint "maqIB")
  bankC <- allocatePartyByHint (PartyIdHint "maqIC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 2; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 2   -- included: fill (2) ≥ minQty (2), higher matched volume wins
  fillOf bankA === 10
  fillOf bankB === 8

-- ALL-OR-NONE FILLS — an all-or-none sell (minQty == quantity == 5) whose full 5
-- CAN be filled is included fully; the buy is rationed around it (A=7 / B=2 / C=5).
--   A Buy 10 @100, B Sell 2 @100, C Sell 5 @100 (AON minQty=5).
--   subset {C}: @100 supply 2+5=7, matched 7, sells B,C → B=2, C=5. C 5 ≥ 5 → FEASIBLE, matched 7.
--   subset {}:  @100 supply 2,     matched 2 → A=2, B=2. Lower matched → loses.
test_aon_all_or_none_fills : Script ()
test_aon_all_or_none_fills = do
  bankA <- allocatePartyByHint (PartyIdHint "aonFA")
  bankB <- allocatePartyByHint (PartyIdHint "aonFB")
  bankC <- allocatePartyByHint (PartyIdHint "aonFC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 2;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 5; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 5   -- all-or-none: fully filled (5 ≥ minQty 5)
  fillOf bankB === 2
  fillOf bankA === 7

-- ALL-OR-NONE DROPS — an all-or-none sell (minQty == quantity == 5) that CANNOT
-- reach its 5 (demand only 3) is dropped entirely (A=3 / B=3 / C=0).
--   A Buy 3 @100, B Sell 8 @100, C Sell 5 @100 (AON minQty=5).
--   subset {C}: @100 demand 3, matched 3, sells B,C → B=3, C=0. C 0 < 5 → INFEASIBLE.
--   subset {}:  @100 matched 3 → A=3, B=3. FEASIBLE and wins.
test_aon_all_or_none_drops : Script ()
test_aon_all_or_none_drops = do
  bankA <- allocatePartyByHint (PartyIdHint "aonDA")
  bankB <- allocatePartyByHint (PartyIdHint "aonDB")
  bankC <- allocatePartyByHint (PartyIdHint "aonDC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 3; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5; limit = 100.0; orderType = AllOrNone; minQty = Some 5; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- dropped: cannot reach its all-or-none 5 (demand only 3)
  fillOf bankA === 3
  fillOf bankB === 3

-- AUCT-01 (09-03) — CONDITIONAL auto-firming golden fixtures, the Daml twins of
-- the `conditional` scenarios in solver/src/auction.test.ts (identical numbers =
-- parity). The two-pass rule: PASS 1 clears the FIRM book → provisional p*; PASS 2
-- firms each conditional whose firmIf passes vs that provP (sell firms iff
-- provP >= firmIf), drops the rest, and re-clears. Conditionals are kept on the
-- SELL side (single funded buyer — Pitfall 3).

-- CONDITIONAL FIRMS — a conditional sell with firmIf=99 firms because the
-- provisional p* (100, over the firm book A+B) is ≥ 99; the final clear then
-- includes it (§4-shaped A=10 / B=8 / C=2).
--   firm = {A Buy 10 @100, B Sell 8 @100} → provP = 100.
--   C Sell 5 @100 (Conditional firmIf=99): 100 >= 99 → FIRMS. final {A,B,C} → A=10/B=8/C=2.
test_conditional_firms : Script ()
test_conditional_firms = do
  bankA <- allocatePartyByHint (PartyIdHint "condFA")
  bankB <- allocatePartyByHint (PartyIdHint "condFB")
  bankC <- allocatePartyByHint (PartyIdHint "condFC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Conditional; minQty = None; firmIf = Some 99.0
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 2   -- firmed (provP 100 >= firmIf 99), then rationed to 2
  fillOf bankA === 10
  fillOf bankB === 8

-- CONDITIONAL DROPS — same book but firmIf=101 fails (provisional p* 100 < 101),
-- so the conditional sell DROPS and the firm book clears alone (A=8 / B=8, C=0).
test_conditional_drops : Script ()
test_conditional_drops = do
  bankA <- allocatePartyByHint (PartyIdHint "condDA")
  bankB <- allocatePartyByHint (PartyIdHint "condDB")
  bankC <- allocatePartyByHint (PartyIdHint "condDC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Conditional; minQty = None; firmIf = Some 101.0
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- dropped: provP 100 < firmIf 101
  fillOf bankA === 8
  fillOf bankB === 8

-- ===========================================================================
-- Phase-2 settlement seed helpers (RESEARCH A5 + Pitfall 5).
--
-- `runCanonicalRound` (Setup) only SUBMITS the three §4 orders — it never opens
-- or closes a Round, and the real `Round.Clear` (Option B, DECISIONS D7) needs
-- the round's `[ContractId Order]`, the buyer's USDCx `ContractId Asset`, and
-- each seller's BONDX `ContractId Asset` passed IN as choice args (a choice body
-- cannot `query` the ACS). So these helpers open a Round, submit the orders,
-- CloseRound, and locate the Option-B ContractIds at the SCRIPT tier via `query`.
-- ===========================================================================

-- Everything the real `Round.Clear` needs to settle the §4 fixture. Holdings-
-- migrated (DFIN-01): `buyerCashCids` is the generalized N-buyer list Clear takes.
data SeedResult = SeedResult with
    parties        : Parties
    roundCid       : ContractId Round
    orderCids      : [ContractId Order]
    buyerCashCids  : [(Party, ContractId Holding)]
    sellerBondCids : [(Party, ContractId Holding)]

-- Locate the (single) Holding cid an owner holds for a given instrument from the
-- operator's view of the ACS (Script-tier query — exactly why Option B passes
-- these into Clear; RESEARCH Pitfall 5).
findHoldingCid : Party -> [(ContractId Holding, Holding)] -> InstrumentId -> ContractId Holding
findHoldingCid owner holdings inst =
  case [ cid | (cid, h) <- holdings, h.owner == owner, h.instrument == inst ] of
    (cid :: _) -> cid
    []         -> error ("findHoldingCid: no Holding for " <> show owner <> " " <> inst.id)

-- Open a Round, submit the three §4 orders via the seeded Venue, CloseRound, and
-- collect the Option-B ContractIds. `bondForB` lets the underfunded variant seed
-- B with too little BONDX (it still SUBMITS the canonical §4 order — qty 8 @99 —
-- so computeClearing returns the canonical A=10/B=8/C=2 @100.0; only the holding
-- is undersized, so the failure is the missing holding, not a bad proposal).
seedAndClose : Decimal -> Script SeedResult
seedAndClose bondForB = do
  p@Parties{..} <- initialize
  let bond = bondInstrumentOf operator
      cash = cashInstrumentOf operator
  -- The underfunded variant re-points B's bond holding at an undersized mint.
  -- (initialize already minted B 20.0 BONDX; for the underfunded case we mint a
  -- second, too-small bond holding and use IT as B's sellerBondCid below.)
  -- Open the Round (operator is signatory; desks observe). openedAt from getTime.
  now <- getTime
  roundCid0 <- submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open

  -- Find the seeded Venue + eligibility credentials (COMP-01 gate on SubmitOrder).
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "seedAndClose: no Venue found after initialize"
  creds <- query @DeskEligibility operator
  oa <- submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  ob <- submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankB
  oc <- submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankC

  -- CloseRound → status flips to Closed (the new contract is what Clear settles).
  roundCid <- submit operator do
    exerciseCmd roundCid0 CloseRound

  -- Optionally re-seed B's bond undersized (for the atomicity test): mint a
  -- too-small bond holding for B and use it as B's sellerBondCid so the Split in
  -- settleBatch (filledQty 8 > bondForB) throws and the whole tx rolls back.
  bondBCidM <- if bondForB < 20.0
    then do
      -- B already has 20.0 BONDX from initialize; mint the undersized one and
      -- point sellerBondCids at it so the seller is effectively short.
      cid <- mintHolding operator bankB bond bondForB
      pure (Some cid)
    else pure None

  -- Locate the Option-B ContractIds (Script-tier query).
  holdings <- query @Holding operator
  let buyerCashCid = findHoldingCid bankA holdings cash
      bondCcid     = findHoldingCid bankC holdings bond
      bondBcid     = case bondBCidM of
        Some cid -> cid                                       -- undersized holding
        None     -> findHoldingCid bankB holdings bond
  pure SeedResult with
    parties        = p
    roundCid
    orderCids      = [oa, ob, oc]
    buyerCashCids  = [(bankA, buyerCashCid)]
    sellerBondCids = [(bankB, bondBcid), (bankC, bondCcid)]

-- Canonical §4 seed: B funded (20.0 BONDX) — used by test_settled_balances and
-- test_clear_rejects_bad_allocation (rejection is by re-verification, not assets).
seedCanonicalAndClose : Script SeedResult
seedCanonicalAndClose = seedAndClose 20.0

-- Underfunded-seller seed: B holds only 5.0 BONDX (< its fill of 8) — used by
-- test_atomicity to prove the Split/ensure throws and the whole Clear rolls back.
seedUnderfundedSellerAndClose : Script SeedResult
seedUnderfundedSellerAndClose = seedAndClose 5.0

-- The verified §4 allocation (A buys 10, B sells 8, C sells 2 — C residual 3).
canonicalAllocs : Party -> Party -> Party -> [Allocation]
canonicalAllocs bankA bankB bankC =
  [ Allocation with desk = bankA; side = Buy;  filledQty = 10
  , Allocation with desk = bankB; side = Sell; filledQty = 8
  , Allocation with desk = bankC; side = Sell; filledQty = 2
  ]

-- IDEN-03 (12-01) — the FOUR-EYES approval helper. The operator PROPOSES a
-- clearing (creates a `ClearingApprovalRequest` at the recomputed price) and a
-- DISTINCT `compliance` party APPROVES it (`ApproveClearing`), bringing the
-- operator+compliance-signed `ClearingApproval` into being. `Round.Clear` requires
-- the returned ContractId. operator ≠ compliance is the tested SEPARATION: the
-- operator cannot forge a `ClearingApproval` alone (compliance authority co-flows
-- only through this exercise on a request the operator proposed). Every §4 Clear
-- call site threads one via `withCanonicalApproval`.
approveClearing : Party -> Party -> Text -> Decimal -> Script (ContractId ClearingApproval)
approveClearing operator compliance roundId price = do
  reqCid <- submit operator do
    createCmd ClearingApprovalRequest with
      operator; compliance; roundId; clearingPrice = price
  submit compliance do
    exerciseCmd reqCid ApproveClearing

-- Allocate a dedicated dev compliance party and return a valid §4 `ClearingApproval`
-- (roundId "R1" @ $100.00) — the exact four-eyes credential the §4 `Round.Clear`
-- call sites require. Kept tiny so every pre-existing settle test threads the gate
-- with a single line while staying green.
withCanonicalApproval : Party -> Script (ContractId ClearingApproval)
withCanonicalApproval operator = do
  compliance <- allocatePartyByHint (PartyIdHint "compliance")
  approveClearing operator compliance "R1" 100.0

-- IDEN-03 (12-01 HIGH-01) — the FOUR-EYES DISTINCTNESS negative proof. The
-- separation of duties must not rest on the test merely CHOOSING a distinct
-- compliance party: the LEDGER itself must reject a collapsed-party approval
-- (compliance == operator). Two on-ledger rejections prove it end-to-end:
--   (1) `ApproveClearing` ABORTS when the request names compliance == operator,
--       so the operator cannot MINT a self-approving `ClearingApproval` even
--       while holding both authorities;
--   (2) a directly-created collapsed `ClearingApproval` (operator is the sole
--       signatory when the two ids coincide) threaded into `Round.Clear` is
--       REJECTED by `assertClearingApproved` — self-approval can never authorize
--       a settle. The §4 canary (operator /= compliance) is UNAFFECTED.
test_four_eyes_requires_distinct_party : Script ()
test_four_eyes_requires_distinct_party = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- (1) The operator proposes a request naming ITSELF as compliance and tries to
  --     self-approve. `ApproveClearing`'s on-ledger distinctness assert aborts.
  selfReqCid <- submit operator do
    createCmd ClearingApprovalRequest with
      operator; compliance = operator; roundId = "R1"; clearingPrice = 100.0
  submitMustFail operator do
    exerciseCmd selfReqCid ApproveClearing
  -- (2) Forge a collapsed `ClearingApproval` directly (operator alone satisfies
  --     `signatory operator, compliance` when compliance == operator) and thread it
  --     into a real `Round.Clear`. `assertClearingApproved` rejects it on-ledger,
  --     so the operator-self-made approval can never authorize settlement.
  collapsedAppr <- submit operator do
    createCmd ClearingApproval with
      operator; compliance = operator; roundId = "R1"; clearingPrice = 100.0
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid    = collapsedAppr

-- SETL-01/SETL-02 — after a successful Round.Clear on the §4 fixture the ledger
-- shows the EXACT spec §4 post-balances (A:10/4000, B:12/1800, C:13/1200) and
-- both BONDX and USDCx are conserved end-to-end (totals unchanged vs the seed:
-- 35.0 BONDX, 7000.0 USDCx). A per-desk TradeConfirmation exists. These are the
-- two things HackCanton judges check (spec §10) — assert them exactly.
test_settled_balances : Script ()
test_settled_balances = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Settle: drive the REAL Clear with the verified §4 allocation @100.0 and the
  -- Option-B ContractIds. operator authority alone (operator-custody DvP).
  -- IDEN-03: thread the compliance-signed four-eyes approval @100.0.
  approvalCid <- withCanonicalApproval operator
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  -- Sum each owner's Holdings per instrument from the operator's view of the ACS.
  holdings <- query @Holding operator
  let bal owner sym = sum [ h.amount | (_, h) <- holdings, h.owner == owner, h.instrument.id == sym ]
  -- The EXACT spec §4 post-settlement balances (non-negotiable correctness ref).
  bal bankA "BONDX" === 10.0
  bal bankA "USDCx" === 4000.0
  bal bankB "BONDX" === 12.0
  bal bankB "USDCx" === 1800.0
  bal bankC "BONDX" === 13.0
  bal bankC "USDCx" === 1200.0
  -- Conservation: global totals unchanged vs the §4 seed (no value created/destroyed).
  let totalBondx = sum [ h.amount | (_, h) <- holdings, h.instrument.id == "BONDX" ]
      totalUsdc  = sum [ h.amount | (_, h) <- holdings, h.instrument.id == "USDCx" ]
  totalBondx === 35.0     -- 20 (B) + 15 (C) seeded; A had 0 BONDX
  totalUsdc  === 7000.0   -- 5000 (A) + 1000 (B) + 1000 (C)
  -- A per-desk TradeConfirmation receipt exists (one per participating desk).
  confs <- query @TradeConfirmation operator
  assertMsg "expected a TradeConfirmation per desk" (length confs == 3)
  -- AUCT-04: every receipt carries the TCA fields — surplusVsLimit ≥ 0 (the proven,
  -- on-ledger best-ex number) and the labeled referencePrice stub (== 100.0 here).
  forA_ confs $ \(_, t) -> do
    assertMsg "surplusVsLimit must be ≥ 0 on every §4 receipt" (t.surplusVsLimit >= 0.0)
    assertMsg "referencePrice stub recorded on the receipt" (t.referencePrice == 100.0)
  -- The EXACT §4 proven surpluses: A=(101-100)*10=10, B=(100-99)*8=8, C=(100-100)*2=0.
  let surplusOf d = sum [ t.surplusVsLimit | (_, t) <- confs, t.desk == d ]
  surplusOf bankA === 10.0
  surplusOf bankB === 8.0
  surplusOf bankC === 0.0

-- AUCT-04 — the on-ledger surplus≥0 PROOF. After a real §4 settle, every per-desk
-- TradeConfirmation carries surplusVsLimit ≥ 0 (the structurally-non-negative,
-- ledger-provable best-execution number). If Round.Clear's `assertMsg surplusVsLimit
-- >= 0` were removed OR the surplus math were wrong (so the §4 allocation produced a
-- negative surplus), this fails LOUDLY — the settle would abort, not merely mis-report.
test_surplus_nonneg : Script ()
test_surplus_nonneg = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Drive the REAL Clear with the verified §4 allocation @100.0 + the reference stub.
  approvalCid <- withCanonicalApproval operator
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  confs <- query @TradeConfirmation operator
  assertMsg "expected a TradeConfirmation per desk" (length confs == 3)
  -- The proof: NO receipt has a negative surplus-vs-limit (asserted on-ledger).
  forA_ confs $ \(_, t) ->
    assertMsg ("surplusVsLimit must be ≥ 0 for " <> show t.desk) (t.surplusVsLimit >= 0.0)
  -- Discriminating: A's proven surplus is STRICTLY positive ((101-100)*10 = 10) — proves
  -- the field is really computed, not a trivial 0-everywhere stub.
  let surplusOf d = sum [ t.surplusVsLimit | (_, t) <- confs, t.desk == d ]
  surplusOf bankA === 10.0

-- SETL-03 — atomicity: a seller short the BONDX makes a settlement leg fail, so
-- Round.Clear is rejected (submitMustFail) and NO balance changes — the whole
-- transaction rolls back (all-or-nothing DvP). The proposed allocation is the
-- internally-valid §4 one; the failure is the missing asset, not a bad proposal.
test_atomicity : Script ()
test_atomicity = do
  SeedResult{..} <- seedUnderfundedSellerAndClose
  let Parties{..} = parties
  -- Snapshot every Holding (owner, instrument, amount) BEFORE the failing Clear.
  before <- query @Holding operator
  let snap xs = sort [ (show h.owner, h.instrument.id, h.amount) | (_, h) <- xs ]
  -- A VALID four-eyes approval (so the ONLY reason this Clear fails is the missing
  -- asset — the atomicity property — not a missing/invalid approval).
  approvalCid <- withCanonicalApproval operator
  -- B holds only 5.0 BONDX but must deliver 8 → the Split throws → rollback.
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  -- All-or-nothing: the post-failure ACS is IDENTICAL to the pre-Clear snapshot.
  after <- query @Holding operator
  snap after === snap before

-- SETL-04/CLEAR-05 — the on-ledger recompute-and-assert backstop rejects any
-- wrong/unfair proposal on a FUNDED round (so rejection is by re-verification,
-- NOT by missing assets): both an over-stated allocation (A buys 12) and a wrong
-- clearing price (99.0 with correct fills) must fail.
test_clear_rejects_bad_allocation : Script ()
test_clear_rejects_bad_allocation = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Bad fills: A buys 12 (exceeds its order qty 10 and the traded volume 10),
  -- C sells 4 — violates max-matched volume + per-order limits. REJECTED.
  let badAllocs =
        [ Allocation with desk = bankA; side = Buy;  filledQty = 12
        , Allocation with desk = bankB; side = Sell; filledQty = 8
        , Allocation with desk = bankC; side = Sell; filledQty = 4
        ]
  -- A VALID four-eyes approval @100.0: rejection here is by the §8 recompute
  -- (which runs BEFORE the four-eyes gate), not by a missing approval.
  approvalCid <- withCanonicalApproval operator
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = badAllocs
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  -- Wrong price: correct §4 fills but clearingPrice = 99.0 (not the recomputed
  -- p* = 100.0). REJECTED by the price half of the recompute-and-assert.
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 99.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid

-- ===========================================================================
-- §16 privacy proofs (PRIV-01..04). Privacy is already STRUCTURAL from the
-- Phase-1 field shapes (Order: signatory operator+desk, NO observer; Asset:
-- observer owner; TradeConfirmation: observer singular desk; RoundStats:
-- observer desks, count only). These two scripts PROVE it: a stray observer
-- added later makes a `length === 1` / `all (_.desk == thisDesk)` assertion
-- fail LOUDLY. Key fact: in Daml Script, `query @T party` returns ONLY contracts
-- where `party` is a stakeholder — the returned set IS the disclosure boundary.
-- ===========================================================================

-- PRIV-01/02/04 — submit the 3 §4 orders, then prove per-party Order visibility
-- is isolated (each desk sees ONLY its own, operator sees all 3), the RoundStats
-- count is the ONLY pre-clear shared info, and Assets are owner+operator scoped.
test_privacy_orders : Script ()
test_privacy_orders = do
  Parties{..} <- initialize
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "test_privacy_orders: no Venue found after initialize"
  creds <- query @DeskEligibility operator
  -- the three §4 orders, each submitted under its OWN desk authority
  _ <- submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  _ <- submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankB
  _ <- submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankC

  -- seed RoundStats{count = 3} (operator-signed, observer = desks) for PRIV-02
  _ <- submit operator do
    createCmd RoundStats with
      operator
      roundId          = "R1"
      desks            = [bankA, bankB, bankC]
      sealedOrderCount = 3

  -- PRIV-01: each desk sees exactly ITS OWN order, zero of the others' ----------
  aOrders <- query @Order bankA
  bOrders <- query @Order bankB
  cOrders <- query @Order bankC
  length aOrders === 1
  length bOrders === 1
  length cOrders === 1
  -- the single visible order belongs to the querying desk (no cross-leak)
  assertMsg "BankA sees only its own order" (all (\(_, o) -> o.desk == bankA) aOrders)
  assertMsg "BankB sees only its own order" (all (\(_, o) -> o.desk == bankB) bOrders)
  assertMsg "BankC sees only its own order" (all (\(_, o) -> o.desk == bankC) cOrders)
  -- operator (Order signatory) sees all three
  ops <- query @Order operator
  length ops === 3

  -- PRIV-02: desks see the RoundStats COUNT, never order contents of others ------
  aStats <- query @RoundStats bankA
  length aStats === 1
  assertMsg "desk sees the sealed-order count = 3"
    (all (\(_, s) -> s.sealedOrderCount == 3) aStats)
  -- (already proven above: BankA's query @Order returns ONLY its own — never B/C)

  -- PRIV-04: Holdings are visible only to owner + operator -----------------------
  aAssets <- query @Holding bankA
  assertMsg "BankA sees only its own holdings"
    (all (\(_, h) -> h.owner == bankA) aAssets)
  bAssets <- query @Holding bankB
  assertMsg "BankB sees only its own holdings"
    (all (\(_, h) -> h.owner == bankB) bAssets)
  -- operator (Holding signatory) sees ALL holdings (the §4 seed: 5 contracts)
  allAssets <- query @Holding operator
  length allAssets === 5

-- PRIV-03 — after a REAL Round.Clear settles the §4 fixture, each desk sees ONLY
-- its own TradeConfirmation (observer = singular desk); no cross-visibility of
-- fills. Reuses the Phase-2 seedCanonicalAndClose + canonicalAllocs helpers.
test_privacy_confirmations : Script ()
test_privacy_confirmations = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- settle with the verified §4 allocation @100.0 (operator authority)
  approvalCid <- withCanonicalApproval operator
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid

  -- each desk sees exactly its own confirmation; operator sees all three
  aConfs <- query @TradeConfirmation bankA
  bConfs <- query @TradeConfirmation bankB
  cConfs <- query @TradeConfirmation bankC
  length aConfs === 1
  length bConfs === 1
  length cConfs === 1
  assertMsg "BankA sees only its own confirmation" (all (\(_, t) -> t.desk == bankA) aConfs)
  assertMsg "BankB sees only its own confirmation" (all (\(_, t) -> t.desk == bankB) bConfs)
  assertMsg "BankC sees only its own confirmation" (all (\(_, t) -> t.desk == bankC) cConfs)
  -- cross-check: BankA is NOT a stakeholder of BankB's confirmation
  assertMsg "no cross-desk confirmation leak"
    (notElem bankB [ t.desk | (_, t) <- aConfs ])
  allConfs <- query @TradeConfirmation operator
  length allConfs === 3

-- ===========================================================================
-- CRYP-01 (10-01) — on-ledger COMMIT–REVEAL proofs. These prove the ledger
-- itself (not the operator) is the accept/reject authority for a reveal, that a
-- valid reveal returns the escrowed bond, and that a non-revealing desk forfeits
-- it. Round.Clear and the §8 math are UNTOUCHED — the binding lives entirely in
-- OrderCommitment.RevealOrder / .ForfeitBond and the Venue.CommitOrder escrow.
-- ===========================================================================

-- Locate the (single) cash Holding an owner has after `initialize`, from the
-- operator's view of the ACS (Script-tier query — same idiom as findHoldingCid).
findUsdcCid : InstrumentId -> Party -> [(ContractId Holding, Holding)] -> ContractId Holding
findUsdcCid cash owner holdings =
  case [ cid | (cid, h) <- holdings, h.owner == owner, h.instrument == cash ] of
    (cid :: _) -> cid
    []         -> error ("findUsdcCid: no cash Holding for " <> show owner)

-- Find the single Venue seeded by `initialize`.
findVenueCid : Party -> Script (ContractId Venue)
findVenueCid operator = do
  venues <- query @Venue operator
  case venues of
    ((v, _) :: _) -> pure v
    []            -> abort "findVenueCid: no Venue found after initialize"

-- T-10-01 — a reveal whose sha256(order‖salt) does NOT equal the stored
-- commitment is rejected ON-LEDGER. BankA commits its §4 order (Buy 10 @101);
-- revealing with a WRONG salt, and revealing a DIFFERENT order (qty 12) with the
-- RIGHT salt, both `submitMustFail` — the ledger recomputes the digest and aborts.
test_reveal_mismatch_rejected : Script ()
test_reveal_mismatch_rejected = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  let cash = cashInstrumentOf operator
  -- Carve a small cash bond slice from BankA's own holding (value-conserving).
  assets0 <- query @Holding operator
  let aUsdc = findUsdcCid cash bankA assets0
  (aBond, _rem) <- submit operator do exerciseCmd aUsdc Split with splitQty = 10.0
  creds <- query @DeskEligibility operator
  -- Commit the §4 Buy order under the correct salt.
  let comm = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
  oc <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"; commitment = comm; bondCid = aBond
      cashInstrument = cash; eligCid = findEligCid operator creds bankA
  -- Wrong salt → the recomputed digest differs → REJECTED on-ledger.
  submitMustFail bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "WRONG-salt"
  -- Right salt but a DIFFERENT order (qty 12 not 10) → also REJECTED on-ledger.
  submitMustFail bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 12; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  -- The commitment is still live (neither failed reveal consumed it); no Order exists.
  ocs <- query @OrderCommitment operator
  length ocs === 1
  orders <- query @Order operator
  length orders === 0

-- T-10-01 (return leg) — a VALID, timely reveal releases the bond lock and
-- creates the sealed Order. The bond (the desk's own USDCx, locked in operator
-- custody during the window) is freely the desk's after a valid reveal, and the
-- OrderCommitment is consumed (no further ForfeitBond possible).
test_bond_returned : Script ()
test_bond_returned = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  let cash = cashInstrumentOf operator
  assets0 <- query @Holding operator
  let aUsdc = findUsdcCid cash bankA assets0
  (aBond, _rem) <- submit operator do exerciseCmd aUsdc Split with splitQty = 10.0
  creds <- query @DeskEligibility operator
  let comm = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
  oc <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"; commitment = comm; bondCid = aBond
      cashInstrument = cash; eligCid = findEligCid operator creds bankA
  -- While the commitment is live the desk cannot move its own bond (every Holding
  -- choice is controller operator) — locked in operator custody.
  submitMustFail bankA do
    exerciseCmd aBond (Reassign with newOwner = bankB)
  -- A valid reveal: the ledger recompute matches → bond lock released + Order created.
  _ <- submit bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  -- The commitment is consumed (lock released) ...
  ocs <- query @OrderCommitment operator
  length ocs === 0
  -- ... the desk still owns its 10.0 cash bond (returned/released) ...
  afterA <- query @Holding bankA
  assertMsg "bond is the desk's after a valid reveal"
    (any (\(_, h) -> h.owner == bankA && h.instrument == cash && h.amount == 10.0) afterA)
  -- ... and its sealed §4 Order now exists (visible to the desk, one order).
  aOrders <- query @Order bankA
  length aOrders === 1
  assertMsg "revealed order is BankA's Buy 10 @101"
    (all (\(_, o) -> o.desk == bankA && o.side == Buy && o.quantity == 10 && o.limit == 101.0) aOrders)

-- T-10-02 — a commitment still live at close FORFEITS its bond to the operator
-- pot. BankB commits but never reveals; the operator exercises ForfeitBond; the
-- bond moves to the operator and the commitment is consumed. Contrast with
-- test_bond_returned: there the desk keeps its bond, here it loses it.
test_bond_forfeit : Script ()
test_bond_forfeit = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  let cash = cashInstrumentOf operator
  assets0 <- query @Holding operator
  let bUsdc = findUsdcCid cash bankB assets0
  (bBond, _rem) <- submit operator do exerciseCmd bUsdc Split with splitQty = 10.0
  creds <- query @DeskEligibility operator
  let comm = commitOf (serializeOrder Sell 8 99.0 Limit None None) "saltB"
  oc <- submit bankB do
    exerciseCmd venueCid CommitOrder with
      desk = bankB; roundId = "R1"; commitment = comm; bondCid = bBond
      cashInstrument = cash; eligCid = findEligCid operator creds bankB
  -- The desk never reveals; at close the operator seizes the bond.
  _ <- submit operator do exerciseCmd oc ForfeitBond
  -- The commitment is consumed (no reclaim path remains) ...
  ocs <- query @OrderCommitment operator
  length ocs === 0
  -- ... the bond now belongs to the operator pot (owner == operator) ...
  opAssets <- query @Holding operator
  assertMsg "forfeited bond is now owned by the operator pot"
    (any (\(_, h) -> h.owner == operator && h.instrument == cash && h.amount == 10.0) opAssets)
  -- ... and BankB no longer owns that 10.0 bond (the deterrent bit).
  bAssets <- query @Holding bankB
  assertMsg "the desk no longer owns the forfeited bond"
    (not (any (\(_, h) -> h.owner == bankB && h.instrument == cash && h.amount == 10.0) bAssets))

-- CRYP-03 — the on-ledger ProofAnchor records ONLY hashes and is readable. The
-- operator anchors a sample proof hash + vkey hash via Venue.AnchorProof; the
-- contract queries back with both hashes intact (no proof bytes on-ledger).
test_proof_anchor : Script ()
test_proof_anchor = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  let ph = "9f2c1a7bproofhashsample"
      vh = "vkey00d1verificationhash"
  _ <- submit operator do
    exerciseCmd venueCid AnchorProof with roundId = "R1"; proofHash = ph; vkeyHash = vh
  anchors <- query @ProofAnchor operator
  length anchors === 1
  assertMsg "ProofAnchor round-trips proofHash + vkeyHash + roundId"
    (any (\(_, pa) -> pa.proofHash == ph && pa.vkeyHash == vh && pa.roundId == "R1") anchors)

-- THE §4 CANARY through commit → reveal → clear (CLAUDE.md rule 3, HARD). The
-- canonical batch is now sealed via on-ledger commitments, revealed against the
-- ledger's own sha256 recompute, and cleared by the UNCHANGED Round.Clear — and
-- it STILL clears exactly $100.00 with fills A=10 / B=8 / C=2 and the exact §4
-- settled balances (bonds released, so cash lands on the §4 finals). If the
-- crypto layer ever perturbs the money-shot number, this fails LOUDLY.
test_commit_reveal_clears_at_100 : Script ()
test_commit_reveal_clears_at_100 = do
  CommitRevealSeed{..} <- seedCommitRevealRound
  let Parties{..} = parties
  -- Settle via the SAME real Round.Clear (operator-custody DvP), driven by the
  -- verified §4 allocation @100.0 and the Option-B ContractIds.
  approvalCid <- withCanonicalApproval operator
  result <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  -- The money-shot number, now flowing through commit → reveal → clear.
  result.clearingPrice === 100.0
  result.totalMatched === 10
  -- The EXACT §4 post-settlement balances (bond released → cash on the §4 finals).
  holdings <- query @Holding operator
  let bal owner sym = sum [ h.amount | (_, h) <- holdings, h.owner == owner, h.instrument.id == sym ]
  bal bankA "BONDX" === 10.0
  bal bankA "USDCx" === 4000.0
  bal bankB "BONDX" === 12.0
  bal bankB "USDCx" === 1800.0
  bal bankC "BONDX" === 13.0
  bal bankC "USDCx" === 1200.0
  -- Fills A=10 / B=8 / C=2 (C residual 3) via the per-desk TradeConfirmations.
  confs <- query @TradeConfirmation operator
  let fillOf d = sum [ t.filledQty | (_, t) <- confs, t.desk == d ]
  fillOf bankA === 10
  fillOf bankB === 8
  fillOf bankC === 2

-- COMP-01 (11-02) — DeskEligibility POSITIVE lifecycle. The operator (acting as its
-- own Compliance role for the MVP stub) issues an eligibility credential for bankA,
-- proves it is retrievable by (operator, desk) and that `isEligible` is True; and
-- proves an ineligible credential (accredited = False) yields `isEligible == False`.
--
-- This is the positive proof only. The on-ledger REJECTION negative tests (an
-- ineligible desk's submit / holding-receipt failing via assertMsg) are 11-06 — they
-- need the `assertDeskEligible` gate wired into SubmitOrder/CommitOrder/holding
-- issuance in 11-05. (The planned `queryContractKey`-by-key retrieval is a keyless
-- `query`+filter here: contract keys are unsupported on Daml 3.4 / Canton LF 2.1 —
-- see Compliance.daml's ENVIRONMENTAL DEVIATION note.)
test_eligibility_issue : Script ()
test_eligibility_issue = do
  Parties{operator, bankA, bankC} <- allocateAll

  -- Issue an ELIGIBLE credential for bankA (operator == compliance, MVP stub).
  eligCid <- submit operator do
    createCmd DeskEligibility with
      operator
      compliance = operator
      desk = bankA
      accredited = True
      jurisdiction = "US"
      sanctionsClear = True

  -- Retrievable by (operator, desk) — the keyless equivalent of a key lookup:
  -- query the operator's visible credentials and find the one for bankA.
  creds <- query @DeskEligibility operator
  let mine = [ e | (_, e) <- creds, e.operator == operator, e.desk == bankA ]
  case mine of
    [cred] -> do
      assertMsg "issued credential must be eligible" (isEligible cred)
      cred.jurisdiction === "US"
    _ -> abort "expected exactly one DeskEligibility for (operator, bankA)"

  -- queryContractId round-trips the exact issued contract, and it is eligible.
  fetched <- queryContractId operator eligCid
  case fetched of
    Some c -> assertMsg "fetched credential must be eligible" (isEligible c)
    None   -> abort "issued DeskEligibility not retrievable by cid"

  -- An INELIGIBLE credential (accredited = False) yields isEligible == False.
  _ <- submit operator do
    createCmd DeskEligibility with
      operator
      compliance = operator
      desk = bankC
      accredited = False
      jurisdiction = "US"
      sanctionsClear = True
  bankCcreds <- query @DeskEligibility operator
  case [ e | (_, e) <- bankCcreds, e.desk == bankC ] of
    [c] -> assertMsg "accredited=False must be ineligible" (not (isEligible c))
    _   -> abort "expected exactly one DeskEligibility for bankC"

-- Test-only harness: a nonconsuming operator choice that drives `settleBatch` from
-- a Daml Script (Script cannot `submit` a raw Update — it needs a template choice).
-- In production the caller is `Round.Clear` (11-05), which runs the same
-- `settleBatch` under sole operator authority. NOT a production template — it only
-- exists so the standalone Batch/Instruction layer can be exercised on-ledger here.
template SettleHarness
  with
    operator : Party
  where
    signatory operator
    nonconsuming choice RunSettle : ()
      with
        instructions : [Instruction]
        sources : [(Party, InstrumentId, ContractId Holding)]
      controller operator
      do settleBatch operator instructions sources

-- DFIN-02 / DFIN-03 — the pure Batch/Instruction settlement layer proven on
-- synthetic Holdings, INDEPENDENT of Round.Clear (that wiring is 11-05). A
-- 2-buyer × 2-seller batch at ONE uniform price p*=100 (A buys 6, D buys 4; B
-- sells 7, C sells 3):
--   (a) buildGrossInstructions → netLegs both conserve (conservationOk True);
--   (b) netLegs yields EXACTLY one net Instruction per (party, instrument);
--   (c) settleBatch settles every gross Holding transfer in ONE atomic Update,
--       conserving each instrument's total and preserving every desk's economics
--       (no fill zeroed, no cash/asset leaked — Pitfall 5);
--   (d) an under-funded seller batch rolls back ENTIRELY (all-or-nothing, Pitfall
--       "Non-atomic settle").
-- Uses a token-agnostic USDCx-labeled cash instrument (DFIN-03) — nothing here is
-- hardcoded to the string "USDCx" beyond the instrument id.
test_netting_conserves : Script ()
test_netting_conserves = do
  operator <- allocatePartyByHint (PartyIdHint "operator")
  bankA <- allocatePartyByHint (PartyIdHint "bankA")   -- buyer
  bankB <- allocatePartyByHint (PartyIdHint "bankB")   -- seller
  bankC <- allocatePartyByHint (PartyIdHint "bankC")   -- seller
  bankD <- allocatePartyByHint (PartyIdHint "bankD")   -- buyer

  let bond  = InstrumentId with issuer = operator; id = "BONDX"
      cash  = InstrumentId with issuer = operator; id = "USDCx"
      insts = [bond, cash]
      price = 100.0

  -- 2×2 verified allocation at one uniform price.
  let allocs =
        [ Allocation with desk = bankA; side = Buy;  filledQty = 6
        , Allocation with desk = bankD; side = Buy;  filledQty = 4
        , Allocation with desk = bankB; side = Sell; filledQty = 7
        , Allocation with desk = bankC; side = Sell; filledQty = 3
        ]

  -- (a) Pure builders: gross legs, netted legs, per-instrument conservation.
  let gross = buildGrossInstructions price allocs bond cash
      net   = netLegs operator gross
  assertMsg "gross batch conserves per instrument"  (conservationOk gross insts)
  assertMsg "netted batch conserves per instrument" (conservationOk net insts)

  -- (b) Netting produces EXACTLY one net leg per (party, instrument) with non-zero
  --     net: A bond+6/cash−600, D bond+4/cash−400, B bond−7/cash+700, C bond−3/
  --     cash+300 → 8 net legs, one per (desk, instrument).
  length net === 8
  let legsTouching party inst =
        [ l | l <- net, l.instrument == inst, (l.sender == party || l.receiver == party) ]
  forA_ [bankA, bankB, bankC, bankD] $ \p ->
    forA_ insts $ \i ->
      assertMsg "exactly one net leg per (party, instrument)" (length (legsTouching p i) == 1)

  -- Mint synthetic operator-custody source Holdings: buyers fund their cash legs,
  -- sellers fund their bond legs (EXACT amounts, so totals are unambiguous).
  let mint owner inst amt = submit operator do
        createCmd Holding with operator; owner; instrument = inst; amount = amt; lock = None
  aCash <- mint bankA cash 600.0
  dCash <- mint bankD cash 400.0
  bBond <- mint bankB bond 7.0
  cBond <- mint bankC bond 3.0
  let sources = [ (bankA, cash, aCash), (bankD, cash, dCash)
                , (bankB, bond, bBond), (bankC, bond, cBond) ]

  -- Snapshot instrument totals + per-desk positions BEFORE settling.
  before <- query @Holding operator
  let totalOf hs inst = sum [ h.amount | (_, h) <- hs, h.instrument == inst ]
      balOf hs owner inst = sum [ h.amount | (_, h) <- hs, h.owner == owner, h.instrument == inst ]
  let bondTotal0 = totalOf before bond
      cashTotal0 = totalOf before cash
  bondTotal0 === 10.0    -- 7 (B) + 3 (C)
  cashTotal0 === 1000.0  -- 600 (A) + 400 (D)

  -- (c) settleBatch the GROSS legs in ONE transaction under operator authority.
  harness <- submit operator do createCmd SettleHarness with operator
  submit operator do
    exerciseCmd harness RunSettle with instructions = gross; sources

  -- Conservation: each instrument's global total is unchanged (no value made/lost).
  after <- query @Holding operator
  totalOf after bond === 10.0
  totalOf after cash === 1000.0
  -- Economics preserved: each desk's net position matches its allocation.
  balOf after bankA bond === 6.0   -- A bought 6
  balOf after bankD bond === 4.0   -- D bought 4
  balOf after bankB cash === 700.0 -- B sold 7 @ 100
  balOf after bankC cash === 300.0 -- C sold 3 @ 100
  -- Buyers' cash + sellers' bond are fully consumed (nothing stranded/leaked).
  balOf after bankA cash === 0.0
  balOf after bankD cash === 0.0
  balOf after bankB bond === 0.0
  balOf after bankC bond === 0.0

  -- (d) Atomicity: a FRESH batch whose seller B is short the BONDX (5 < the 7 it
  --     must deliver) makes a leg's Split throw → the whole RunSettle rolls back,
  --     leaving the entire Holding ACS byte-identical.
  aCash2 <- mint bankA cash 600.0
  dCash2 <- mint bankD cash 400.0
  bBond2 <- mint bankB bond 5.0    -- underfunded
  cBond2 <- mint bankC bond 3.0
  let sources2 = [ (bankA, cash, aCash2), (bankD, cash, dCash2)
                 , (bankB, bond, bBond2), (bankC, bond, cBond2) ]
  beforeFail <- query @Holding operator
  let snap hs = sort [ (show h.owner, h.instrument.id, h.amount) | (_, h) <- hs ]
  submitMustFail operator do
    exerciseCmd harness RunSettle with instructions = gross; sources = sources2
  afterFail <- query @Holding operator
  snap afterFail === snap beforeFail

-- ===========================================================================
-- DFIN-02 / DFIN-03 / COMP-01 / WOW-07 (11-06) — the Phase-11 generalization
-- goldens, each proven through the REAL generalized `Round.Clear` (not the pure
-- Settlement layer of `test_netting_conserves`). The §4 canary stays the
-- continuous single-buyer reference (test_clears_at_100 / test_settled_balances).
-- ===========================================================================

-- DFIN-02 — a 2-buyer × 2-seller batch clears at ONE uniform price through the
-- generalized Round.Clear and conserves cash + bond on-ledger. Two buyers (A, D)
-- and two sellers (B, C) cross at p*=100; the recompute-§8-and-assert backstop
-- accepts the verified allocation, the Batch DvP settles atomically, and every
-- desk's post-settle position matches its fill. Proves the settlement path is
-- genuinely N-buyer × M-seller — not the single-funded-buyer §4 shortcut.
test_multibuyer_golden : Script ()
test_multibuyer_golden = do
  MultiBuyerSeed{..} <- seedMultiBuyerRound "USDCx"
  -- Snapshot instrument totals BEFORE settling (the conservation reference).
  before <- query @Holding operator
  let totalOf hs inst = sum [ h.amount | (_, h) <- hs, h.instrument == inst ]
  totalOf before bondInstrument === 10.0   -- 7 (B) + 3 (C)
  totalOf before cashInstrument === 1000.0 -- 600 (A) + 400 (D)

  -- Drive the REAL, generalized Round.Clear (recompute-§8-and-assert + Batch DvP).
  approvalCid <- withCanonicalApproval operator
  result <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument
      bondInstrument
      referencePrice = 100.0
      approvalCid

  -- (a) A SINGLE uniform clearing price the ledger re-derived + accepted.
  result.clearingPrice === 100.0
  result.totalMatched  === 10

  -- (b) Per-instrument conservation: global totals unchanged (no value made/lost).
  after <- query @Holding operator
  totalOf after bondInstrument === 10.0
  totalOf after cashInstrument === 1000.0

  -- (c) Each desk's post-settle position matches its fill (buyers get bond, sellers cash).
  let balOf owner inst = sum [ h.amount | (_, h) <- after, h.owner == owner, h.instrument == inst ]
  balOf bankA bondInstrument === 6.0
  balOf bankD bondInstrument === 4.0
  balOf bankB cashInstrument === 700.0   -- sold 7 @100
  balOf bankC cashInstrument === 300.0   -- sold 3 @100
  -- Buyers' cash + sellers' bond fully consumed (nothing stranded/leaked).
  balOf bankA cashInstrument === 0.0
  balOf bankD cashInstrument === 0.0
  balOf bankB bondInstrument === 0.0
  balOf bankC bondInstrument === 0.0
  -- Σ cash received == Σ cash paid (1000); Σ bond received == Σ bond delivered (10).
  (balOf bankB cashInstrument + balOf bankC cashInstrument) === 1000.0
  (balOf bankA bondInstrument + balOf bankD bondInstrument) === 10.0

  -- Per-desk fills via the private TradeConfirmations (A=6 / D=4 / B=7 / C=3).
  confs <- query @TradeConfirmation operator
  length confs === 4
  let fillOf d = sum [ t.filledQty | (_, t) <- confs, t.desk == d ]
  fillOf bankA === 6
  fillOf bankD === 4
  fillOf bankB === 7
  fillOf bankC === 3

-- DFIN-03 — the SAME 2×2 golden settled with a DIFFERENT cash instrument (EURt)
-- behaves identically: Round.Clear follows the passed `cashInstrument`, with NO
-- hardcoded "USDCx" anywhere on the settlement path (token-agnostic). If any code
-- path assumed USDCx, the EURt cash leg would fail to settle / mis-conserve here.
test_cash_instrument_agnostic : Script ()
test_cash_instrument_agnostic = do
  MultiBuyerSeed{..} <- seedMultiBuyerRound "EURt"
  -- The cash leg really is the swapped-in instrument (not USDCx).
  cashInstrument.id === "EURt"

  approvalCid <- withCanonicalApproval operator
  result <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument
      bondInstrument
      referencePrice = 100.0
      approvalCid

  -- Identical clearing behavior: p*=100, matched 10.
  result.clearingPrice === 100.0
  result.totalMatched  === 10

  after <- query @Holding operator
  let balOf owner inst = sum [ h.amount | (_, h) <- after, h.owner == owner, h.instrument == inst ]
      totalOf inst = sum [ h.amount | (_, h) <- after, h.instrument == inst ]
  -- The EURt cash leg settled EXACTLY as USDCx would have (sellers receive EURt).
  balOf bankB cashInstrument === 700.0
  balOf bankC cashInstrument === 300.0
  totalOf cashInstrument === 1000.0
  -- No stray USDCx was created (the swap is total, not additive).
  totalOf (cashInstrumentOf operator) === 0.0
  -- Receipts record the EURt-denominated cashMoved for the guest (4 @100 = 400).
  confs <- query @TradeConfirmation operator
  let cashMovedOf d = sum [ t.cashMoved | (_, t) <- confs, t.desk == d ]
  cashMovedOf bankD === 400.0

-- COMP-01 — an INELIGIBLE desk is rejected ON-LEDGER at ORDER CREATION (the first
-- enforcement point). The desk is REGISTERED in the Venue (so `desk elem desks`
-- passes) but holds an ineligible credential — so the ONLY thing that can reject
-- its submit is `assertDeskEligible`. Proven for BOTH sealed-entry paths
-- (SubmitOrder + CommitOrder), for a substituted rival credential, and isolated
-- from a mere registration failure by a positive control that succeeds.
test_ineligible_submit_rejected : Script ()
test_ineligible_submit_rejected = do
  Parties{..} <- initialize
  bankBad <- allocatePartyByHint (PartyIdHint "bankBad")
  let cash = cashInstrumentOf operator
  -- A Venue that REGISTERS bankBad so `desk elem desks` passes; the eligibility
  -- gate is then the sole possible cause of a submit rejection below.
  venueCid <- submit operator do
    createCmd Venue with operator; desks = [bankA, bankB, bankC, bankBad]
  -- An INELIGIBLE credential (accredited = False) for the registered desk.
  badElig <- submit operator do
    createCmd DeskEligibility with
      operator; compliance = operator; desk = bankBad
      accredited = False; jurisdiction = "US"; sanctionsClear = True
  -- SubmitOrder REJECTED on-ledger by assertDeskEligible (registered but ineligible).
  submitMustFail bankBad do
    exerciseCmd venueCid SubmitOrder with
      desk = bankBad; roundId = "R1"; side = Buy; quantity = 5; limit = 100.0
      orderType = Limit; minQty = None; firmIf = None; eligCid = badElig
  -- CommitOrder (the second sealed-entry path) REJECTED the same way.
  badCash <- mintHolding operator bankBad cash 10.0
  submitMustFail bankBad do
    exerciseCmd venueCid CommitOrder with
      desk = bankBad; roundId = "R1"
      commitment = commitOf (serializeOrder Buy 5 100.0 Limit None None) "sBad"
      bondCid = badCash; cashInstrument = cash; eligCid = badElig
  -- A credential for ANOTHER desk cannot be substituted (assertDeskEligible checks
  -- cred.desk == desk) — bankA's eligible credential is still rejected for bankBad.
  creds <- query @DeskEligibility operator
  submitMustFail bankBad do
    exerciseCmd venueCid SubmitOrder with
      desk = bankBad; roundId = "R1"; side = Buy; quantity = 5; limit = 100.0
      orderType = Limit; minQty = None; firmIf = None
      eligCid = findEligCid operator creds bankA
  -- POSITIVE CONTROL — the SAME registered desk WITH an eligible credential submits
  -- successfully. This proves the rejections above are the eligibility gate, NOT a
  -- registration failure (the "bankBad is simply unregistered" hypothesis would
  -- make THIS submit fail too — it does not).
  goodElig <- submit operator do
    createCmd DeskEligibility with
      operator; compliance = operator; desk = bankBad
      accredited = True; jurisdiction = "US"; sanctionsClear = True
  ocid <- submit bankBad do
    exerciseCmd venueCid SubmitOrder with
      desk = bankBad; roundId = "R1"; side = Buy; quantity = 5; limit = 100.0
      orderType = Limit; minQty = None; firmIf = None; eligCid = goodElig
  Some o <- queryContractId bankBad ocid
  o.desk === bankBad
  o.quantity === 5

-- COMP-01 — an INELIGIBLE receiver is rejected ON-LEDGER at HOLDING ISSUANCE (the
-- second enforcement point). Venue.IssueHolding is controller operator with NO
-- registration check, so the rejection is purely the eligibility assert. A
-- positive control proves an eligible receiver IS issued the holding.
test_ineligible_holding_rejected : Script ()
test_ineligible_holding_rejected = do
  Parties{..} <- initialize
  bankBad <- allocatePartyByHint (PartyIdHint "bankBadH")
  venueCid <- findVenueCid operator
  let cash = cashInstrumentOf operator
  -- INELIGIBLE receiver credential.
  badElig <- submit operator do
    createCmd DeskEligibility with
      operator; compliance = operator; desk = bankBad
      accredited = False; jurisdiction = "US"; sanctionsClear = True
  -- IssueHolding to an ineligible OWNER is REJECTED on-ledger (assertDeskEligible).
  submitMustFail operator do
    exerciseCmd venueCid IssueHolding with
      owner = bankBad; instrument = cash; amount = 100.0; eligCid = badElig
  -- POSITIVE CONTROL — an ELIGIBLE receiver IS issued the holding.
  goodElig <- submit operator do
    createCmd DeskEligibility with
      operator; compliance = operator; desk = bankBad
      accredited = True; jurisdiction = "US"; sanctionsClear = True
  hcid <- submit operator do
    exerciseCmd venueCid IssueHolding with
      owner = bankBad; instrument = cash; amount = 100.0; eligCid = goodElig
  Some h <- queryContractId operator hcid
  h.owner === bankBad
  h.amount === 100.0
  h.instrument === cash

-- WOW-07 — a GUEST 4th desk (bankD) submits a sealed order and settles in the 2×2
-- batch, and its own-fill privacy is STRUCTURAL — identical to A/B/C. PRE-CLEAR
-- each desk sees ONLY its own sealed Order (the guest's is invisible to rivals,
-- and rivals' are invisible to the guest); POST-CLEAR each desk sees ONLY its own
-- TradeConfirmation. The guest is a first-class participant, not a special case.
test_privacy_guest_fill : Script ()
test_privacy_guest_fill = do
  MultiBuyerSeed{..} <- seedMultiBuyerRound "USDCx"
  -- PRE-CLEAR order privacy: each desk sees ONLY its own sealed order.
  aOrders <- query @Order bankA
  dOrders <- query @Order bankD
  length aOrders === 1
  length dOrders === 1
  assertMsg "guest sees only its OWN order" (all (\(_, o) -> o.desk == bankD) dOrders)
  assertMsg "guest's order is INVISIBLE to rival A" (notElem bankD [ o.desk | (_, o) <- aOrders ])
  assertMsg "rival A's order is INVISIBLE to the guest" (notElem bankA [ o.desk | (_, o) <- dOrders ])
  -- operator (Order signatory) sees all four sealed orders.
  ops <- query @Order operator
  length ops === 4

  -- Settle the 2×2 batch via the real Round.Clear.
  approvalCid <- withCanonicalApproval operator
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument
      bondInstrument
      referencePrice = 100.0
      approvalCid

  -- POST-CLEAR fill privacy: each desk sees ONLY its own TradeConfirmation.
  dConfs <- query @TradeConfirmation bankD
  aConfs <- query @TradeConfirmation bankA
  length dConfs === 1
  length aConfs === 1
  assertMsg "guest sees only its OWN fill" (all (\(_, t) -> t.desk == bankD) dConfs)
  assertMsg "guest's fill is INVISIBLE to rival A" (notElem bankD [ t.desk | (_, t) <- aConfs ])
  -- The guest's own fill is exactly Buy 4 (a first-class participant).
  assertMsg "guest's own fill is Buy 4" (all (\(_, t) -> t.side == Buy && t.filledQty == 4) dConfs)
  -- operator sees all four confirmations.
  allConfs <- query @TradeConfirmation operator
  length allConfs === 4

-- ===========================================================================
-- IDEN-03 (12-01) — FOUR-EYES compliance-approval gate on the settle path.
-- A DISTINCT `compliance` party must approve the clearing price before
-- `Round.Clear` commits. The §4 canary STILL clears $100.00 / A=10·B=8·C=2 WITH
-- the approval threaded; a settle with no / wrong / operator-self-made approval is
-- rejected ON-LEDGER. operator ≠ compliance is the real, tested SEPARATION.
-- ===========================================================================

-- THE §4 CANARY WITH FOUR-EYES (CLAUDE.md rule 3, HARD). Seed §4 → a DISTINCT
-- compliance party approves @100.0 → Round.Clear settles → the money shot still
-- lands exactly $100.00 with fills A=10 / B=8 / C=2 and the §4 post-balances.
test_four_eyes_clears_at_100 : Script ()
test_four_eyes_clears_at_100 = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- A DISTINCT compliance party (operator ≠ compliance — the real separation).
  compliance <- allocatePartyByHint (PartyIdHint "compliance")
  assertMsg "four-eyes separation: operator must differ from compliance"
    (operator /= compliance)
  approvalCid <- approveClearing operator compliance "R1" 100.0
  result <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid
  -- The money-shot number, now gated by a distinct compliance approval.
  result.clearingPrice === 100.0
  result.totalMatched  === 10
  -- The EXACT §4 post-settlement balances (unchanged by the four-eyes insertion).
  holdings <- query @Holding operator
  let bal owner sym = sum [ h.amount | (_, h) <- holdings, h.owner == owner, h.instrument.id == sym ]
  bal bankA "BONDX" === 10.0
  bal bankA "USDCx" === 4000.0
  bal bankB "BONDX" === 12.0
  bal bankB "USDCx" === 1800.0
  bal bankC "BONDX" === 13.0
  bal bankC "USDCx" === 1200.0
  -- Per-desk fills A=10 / B=8 / C=2 via the private TradeConfirmations.
  confs <- query @TradeConfirmation operator
  let fillOf d = sum [ t.filledQty | (_, t) <- confs, t.desk == d ]
  fillOf bankA === 10
  fillOf bankB === 8
  fillOf bankC === 2

-- A settle with NO valid approval is rejected ON-LEDGER. We create a real
-- approval, then ARCHIVE it (both signatories) so the ContractId dangles: the
-- `fetch approvalCid` inside Round.Clear finds nothing → the whole Clear aborts.
-- The §8 recompute (which runs BEFORE the gate) PASSES on the §4-valid allocation,
-- so the four-eyes gate is the SOLE reason for rejection.
test_settle_without_approval_rejected : Script ()
test_settle_without_approval_rejected = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  compliance <- allocatePartyByHint (PartyIdHint "compliance")
  approvalCid <- approveClearing operator compliance "R1" 100.0
  -- Archive the approval (requires BOTH signatories) → the cid no longer resolves.
  submitMulti [operator, compliance] [] do archiveCmd approvalCid
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid

-- A settle with a WRONG approval is rejected ON-LEDGER. The four-eyes gate runs
-- AFTER the §8 recompute, so at the real §4 price 100.0 the §8 asserts PASS and the
-- gate itself aborts: (a) an approval at the WRONG price (99.0), and (b) an approval
-- for the WRONG round — both fail `assertClearingApproved`.
test_settle_wrong_approval_rejected : Script ()
test_settle_wrong_approval_rejected = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  compliance <- allocatePartyByHint (PartyIdHint "compliance")
  -- (a) WRONG PRICE: compliance approved 99.0, but §4 clears at 100.0.
  wrongPriceCid <- approveClearing operator compliance "R1" 99.0
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid = wrongPriceCid
  -- (b) WRONG ROUND: correct price 100.0 but the approval is scoped to another round.
  wrongRoundCid <- approveClearing operator compliance "R-OTHER" 100.0
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerCashCids
      sellerBondCids
      cashInstrument = cashInstrumentOf operator
      bondInstrument = bondInstrumentOf operator
      referencePrice = 100.0
      approvalCid = wrongRoundCid

-- The operator ALONE cannot bring a `ClearingApproval` into being — the whole
-- point of the four-eyes SEPARATION. Proven two ways: (a) operator cannot directly
-- `create` the operator+compliance-signed `ClearingApproval` (missing compliance
-- authority), and (b) operator cannot exercise `ApproveClearing` (controller
-- compliance) on a request it proposed.
test_operator_cannot_self_approve : Script ()
test_operator_cannot_self_approve = do
  operator   <- allocatePartyByHint (PartyIdHint "operator")
  compliance <- allocatePartyByHint (PartyIdHint "compliance")
  assertMsg "four-eyes separation: operator must differ from compliance"
    (operator /= compliance)
  -- (a) Operator alone cannot create the two-party-signed approval.
  submitMustFail operator do
    createCmd ClearingApproval with
      operator; compliance; roundId = "R1"; clearingPrice = 100.0
  -- (b) Operator proposes a request (signatory operator), but cannot APPROVE it
  --     itself — `ApproveClearing` is `controller compliance`.
  reqCid <- submit operator do
    createCmd ClearingApprovalRequest with
      operator; compliance; roundId = "R1"; clearingPrice = 100.0
  submitMustFail operator do
    exerciseCmd reqCid ApproveClearing

-- ===========================================================================
-- ADJ-02 (13-06) — the keyless RFQ side-mode. A requester posts an RfqRequest;
-- one or more dealers respond with a FIRM signed Quote (signatory operator,
-- dealer); the requester accepts the best quote and it settles a 1×1 batch via
-- the SAME atomic `Umbra.Settlement.settleBatch` DvP path — cash + bond conserve,
-- and quotes are structurally private to their requester. Rfq.daml is KEYLESS
-- (fetch-by-ContractId + assertMsg), and the §4 clearing path is byte-unchanged.
-- ===========================================================================

-- ADJ-02 — accept-settles-1×1. bankA (requester) posts an RfqRequest to BUY 5
-- units of the bond; bankB (dealer) responds with a FIRM Quote @100.0; the
-- requester exercises AcceptQuote and the 1×1 batch settles through settleBatch:
-- the bond lands with the requester, the cash with the dealer, and BOTH
-- instruments conserve globally (Σ before == Σ after).
test_rfq_accept_settles : Script ()
test_rfq_accept_settles = do
  Parties{..} <- initialize
  let bond      = bondInstrumentOf operator
      cash      = cashInstrumentOf operator
      requester = bankA     -- buyer (funded 5000 USDCx by initialize)
      dealer    = bankB     -- dealer (funded 20 BONDX + 1000 USDCx)

  -- The requester posts the request (operator co-signs — signatory operator, requester).
  reqCid <- submitMulti [requester, operator] [] do
    createCmd RfqRequest with
      operator; requester; dealers = [bankB, bankC]
      instrument = bond; side = Buy; quantity = 5

  -- The dealer responds with a FIRM quote @100.0 (its signature makes it binding).
  quoteCid <- submitMulti [dealer, operator] [] do
    createCmd Quote with
      operator; dealer; requester; instrument = bond; price = 100.0; quantity = 5

  -- Conservation reference: global instrument totals BEFORE the accept.
  before <- query @Holding operator
  let totalOf hs inst = sum [ h.amount | (_, h) <- hs, h.instrument == inst ]
  totalOf before bond === 35.0    -- 20 (B) + 15 (C)
  totalOf before cash === 7000.0  -- 5000 (A) + 1000 (B) + 1000 (C)

  -- Locate the Option-B source Holding cids (Script-tier query, as settle does).
  let bondSrc = findHoldingCid dealer    before bond   -- bankB's 20 BONDX
      cashSrc = findHoldingCid requester before cash   -- bankA's 5000 USDCx

  -- The requester accepts (controller = requester). The operator — a signatory of
  -- RfqRequest and the settlement custodian — co-submits so the operator-custodied
  -- source Holdings are readable to drive settleBatch (the SAME atomic DvP path as
  -- Round.Clear, which likewise runs under operator custody).
  submitMulti [requester, operator] [] do
    exerciseCmd reqCid AcceptQuote with
      quoteCid; bondSourceCid = bondSrc; cashSourceCid = cashSrc; cashInstrument = cash

  -- Post-settle: the bond went to the requester, the cash to the dealer.
  after <- query @Holding operator
  let balOf owner inst = sum [ h.amount | (_, h) <- after, h.owner == owner, h.instrument == inst ]
  balOf requester bond === 5.0      -- bought 5 bond units
  balOf requester cash === 4500.0   -- 5000 − 5×100
  balOf dealer    cash === 1500.0   -- 1000 + 5×100
  balOf dealer    bond === 15.0     -- 20 − 5
  -- Per-instrument conservation: no value created or destroyed.
  totalOf after bond === 35.0
  totalOf after cash === 7000.0

-- ADJ-02 — accept-BEST. Two dealers quote DIFFERENT firm prices for the same
-- BUY request; the requester accepts the BETTER (lower, since buying) quote and
-- settlement uses THAT price. Discriminating: the accepted dealer receives
-- 5×100 = 500 (not 5×101 = 505), and the worse-priced dealer receives nothing.
test_rfq_best_quote : Script ()
test_rfq_best_quote = do
  Parties{..} <- initialize
  let bond      = bondInstrumentOf operator
      cash      = cashInstrumentOf operator
      requester = bankA

  reqCid <- submitMulti [requester, operator] [] do
    createCmd RfqRequest with
      operator; requester; dealers = [bankB, bankC]
      instrument = bond; side = Buy; quantity = 5

  -- Two firm quotes at different prices: bankB @101 (worse), bankC @100 (better).
  _quoteB <- submitMulti [bankB, operator] [] do
    createCmd Quote with
      operator; dealer = bankB; requester; instrument = bond; price = 101.0; quantity = 5
  quoteC  <- submitMulti [bankC, operator] [] do
    createCmd Quote with
      operator; dealer = bankC; requester; instrument = bond; price = 100.0; quantity = 5

  -- The requester accepts the BEST (lower) price for a buy: bankC @100 over
  -- bankB @101. The discriminating proof is the settled amount below (500, not 505).
  before <- query @Holding operator
  let bondSrc = findHoldingCid bankC     before bond   -- winning dealer delivers bond
      cashSrc = findHoldingCid requester before cash
  submitMulti [requester, operator] [] do
    exerciseCmd reqCid AcceptQuote with
      quoteCid = quoteC; bondSourceCid = bondSrc; cashSourceCid = cashSrc; cashInstrument = cash

  after <- query @Holding operator
  let balOf owner inst = sum [ h.amount | (_, h) <- after, h.owner == owner, h.instrument == inst ]
  -- Settlement used the ACCEPTED price 100.0 → bankC received exactly 500 (NOT 505).
  balOf bankC cash === 1500.0        -- 1000 + 5×100
  balOf requester bond === 5.0
  balOf requester cash === 4500.0    -- 5000 − 5×100 (proves 100 used, not 101)
  -- The worse-priced (unaccepted) dealer bankB received nothing — its cash is untouched.
  balOf bankB cash === 1000.0
  balOf bankB bond === 20.0

-- ADJ-02 — the Quote is FIRM (signatory dealer). A quote cannot exist on-ledger
-- without the dealer's authority: neither the operator alone nor the requester can
-- forge one (both submitMustFail). WITH the dealer's signature the firm quote IS
-- created — proving the dealer's authority is the necessary-and-sufficient control.
test_rfq_quote_is_firm : Script ()
test_rfq_quote_is_firm = do
  Parties{..} <- initialize
  let bond = bondInstrumentOf operator
  -- The operator alone CANNOT mint a dealer's quote (missing dealer authority).
  submitMustFail operator do
    createCmd Quote with
      operator; dealer = bankB; requester = bankA; instrument = bond; price = 100.0; quantity = 5
  -- Neither can the requester forge a rival dealer's firm quote.
  submitMustFail bankA do
    createCmd Quote with
      operator; dealer = bankB; requester = bankA; instrument = bond; price = 100.0; quantity = 5
  -- WITH the dealer + operator co-signing, the FIRM quote is created and binding.
  quoteCid <- submitMulti [bankB, operator] [] do
    createCmd Quote with
      operator; dealer = bankB; requester = bankA; instrument = bond; price = 100.0; quantity = 5
  Some q <- queryContractId bankB quoteCid
  q.dealer === bankB
  q.price === 100.0

-- ADJ-02 — RFQ privacy is STRUCTURAL. A Quote's ONLY observer is its requester, so
-- a rival dealer never sees another dealer's quote; and an RfqRequest's observer
-- set (the invited dealers) is the privacy control, so an uninvited desk never
-- sees the request. Both proven by per-party `query` (the disclosure boundary).
test_rfq_privacy : Script ()
test_rfq_privacy = do
  Parties{..} <- initialize
  let bond      = bondInstrumentOf operator
      requester = bankA
  -- Two dealers post firm quotes to the SAME requester.
  _qB <- submitMulti [bankB, operator] [] do
    createCmd Quote with
      operator; dealer = bankB; requester; instrument = bond; price = 101.0; quantity = 5
  _qC <- submitMulti [bankC, operator] [] do
    createCmd Quote with
      operator; dealer = bankC; requester; instrument = bond; price = 100.0; quantity = 5

  -- The requester (sole observer) sees BOTH quotes addressed to it.
  reqQuotes <- query @Quote requester
  length reqQuotes === 2

  -- Dealer bankB sees ONLY its own quote — bankC's is INVISIBLE (observer = requester).
  bQuotes <- query @Quote bankB
  length bQuotes === 1
  assertMsg "dealer sees only its OWN quote" (all (\(_, q) -> q.dealer == bankB) bQuotes)
  assertMsg "a rival dealer's quote is INVISIBLE" (notElem bankC [ q.dealer | (_, q) <- bQuotes ])
  -- Symmetrically, bankC sees only its own quote.
  cQuotes <- query @Quote bankC
  length cQuotes === 1
  assertMsg "dealer sees only its OWN quote" (all (\(_, q) -> q.dealer == bankC) cQuotes)
  -- operator (Quote signatory) sees both.
  opQuotes <- query @Quote operator
  length opQuotes === 2

  -- The RfqRequest observer set is the privacy control: a request naming ONLY
  -- bankB as an invited dealer is invisible to the uninvited bankC.
  _ <- submitMulti [requester, operator] [] do
    createCmd RfqRequest with
      operator; requester; dealers = [bankB]
      instrument = bond; side = Buy; quantity = 5
  bReqs <- query @RfqRequest bankB
  cReqs <- query @RfqRequest bankC
  length bReqs === 1   -- the invited dealer sees the request
  length cReqs === 0   -- the uninvited dealer does NOT
