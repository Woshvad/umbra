-- Umbra — Wave-0 Daml Script validation scaffolds (spec §16; this phase only
-- needs the "seeds + compiles" smoke — clearing/settlement/privacy tests 1-6
-- arrive in Phases 2-3). Run with `daml test` (exit code is authoritative).
--
--   * test_setup_seeds      (LEDG-02): initialize seeds 4 parties + the exact
--                            §4 holdings (5 Asset contracts).
--   * test_asset_split_merge(LEDG-03): operator Split then Merge preserve total
--                            quantity (conservation); out-of-range Split rejected.
module Umbra.Tests where

import Daml.Script
import DA.Assert
import DA.Foldable (forA_)
import DA.List (sort)
import Umbra.Setup
import Umbra.Asset
import Umbra.Auction
  ( Side(..), Allocation(..)
  , Order, Round(..), RoundStatus(..), TradeConfirmation, RoundStats(..)
  , CloseRound(..), Clear(..)
  , OrderCommitment(..), RevealOrder(..)
  , commitOf, serializeOrder
  )
import Umbra.Roles (Venue, SubmitOrder(..), CommitOrder(..))
import Umbra.Clearing

-- LEDG-02 — the §4 seed is the single correctness reference. Assert that after
-- `initialize` the operator sees exactly the 5 §4 Assets with the right
-- owner/symbol/quantity. A wrong mint literal fails here instead of silently
-- corrupting every downstream test (threat T-01-07).
test_setup_seeds : Script ()
test_setup_seeds = do
  Parties{..} <- initialize
  assets <- query @Asset operator
  -- Exactly 5 Asset contracts minted.
  length assets === 5
  let holdings = [(a.owner, a.symbol, a.quantity) | (_, a) <- assets]
  -- The four parties are distinct.
  assertMsg "parties must be distinct"
    (operator /= bankA && bankA /= bankB && bankB /= bankC && operator /= bankC)
  -- Every §4 holding is present (owner, symbol, quantity).
  let expected =
        [ (bankA, "USDCx", 5000.0)
        , (bankB, "BONDX", 20.0)
        , (bankB, "USDCx", 1000.0)
        , (bankC, "BONDX", 15.0)
        , (bankC, "USDCx", 1000.0)
        ]
  forA_ expected $ \h ->
    assertMsg ("missing expected §4 holding: " <> show h) (h `elem` holdings)

-- LEDG-03 — operator-only Split/Merge preserve total quantity. Mint BONDX 10.0,
-- Split into 4.0 + 6.0 (conservation: sum == original), then Merge back to 10.0.
-- Also prove the ensure/assert guard rejects an out-of-range splitQty.
test_asset_split_merge : Script ()
test_asset_split_merge = do
  Parties{operator, bankB} <- allocateAll
  assetCid <- mintAsset operator bankB "BONDX" 10.0

  -- Split 10.0 -> (4.0, 6.0)
  (aCid, bCid) <- submit operator do
    exerciseCmd assetCid Split with splitQty = 4.0
  a <- queryContractId operator aCid
  b <- queryContractId operator bCid
  case (a, b) of
    (Some av, Some bv) -> do
      av.quantity === 4.0
      bv.quantity === 6.0
      -- conservation: the two halves sum to the original.
      (av.quantity + bv.quantity) === 10.0
    _ -> abort "Split did not produce two Asset contracts"

  -- Merge (4.0) back with (6.0) -> 10.0
  mergedCid <- submit operator do
    exerciseCmd aCid Merge with otherCid = bCid
  merged <- queryContractId operator mergedCid
  case merged of
    Some mv -> mv.quantity === 10.0
    None    -> abort "Merge did not produce a merged Asset"

  -- Edge: out-of-range Split (>= quantity) is rejected by the assertMsg guard.
  submitMustFail operator do
    exerciseCmd mergedCid Split with splitQty = 10.0

-- CLEAR-04 — THE §8 canary, the build's continuous correctness reference
-- (CLAUDE.md rule 3). Runs the PURE `computeClearing` on the §4 fixture (no
-- ledger needed — the tightest guardrail isolating the §8 trap from settlement)
-- and asserts BOTH the price AND the fills:
--   * p* == 100.0 (NOT 99.0 — the tie-break must stay scoped to the max-matched
--     set {100,101}; across all prices 99 has the smaller imbalance and would win)
--   * fills A=10 / B=8 / C=2  (C residual = 5 - 2 = 3)
-- If the tie-break ever escapes the max-matched subset, this test fails LOUDLY.
test_clears_at_100 : Script ()
test_clears_at_100 = do
  -- throwaway parties for the OrderView `desk` fields (the §4 desks).
  bankA <- allocatePartyByHint (PartyIdHint "bankA")
  bankB <- allocatePartyByHint (PartyIdHint "bankB")
  bankC <- allocatePartyByHint (PartyIdHint "bankC")

  -- §4 fixture: A Buy 10 @101, B Sell 8 @99, C Sell 5 @100 (Decimal limits,
  -- Int quantities — never compare an Int fill against a Decimal).
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 99.0;  orderType = Limit; minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Limit; minQty = None; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      -- sum the filledQty for all allocations matching a desk.
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]

  -- The price clears at exactly 100.0 ...
  pStar === 100.0
  -- ... and NOT at 99.0 — a loud, named failure if the tie-break trap reappears.
  assertMsg "TIE-BREAK TRAP: cleared at 99 — tie-break escaped the max-matched subset"
    (pStar /= 99.0)

  -- Fills: A=10, B=8, C=2.
  fillOf bankA === 10
  fillOf bankB === 8
  fillOf bankC === 2
  -- C's residual: order qty (5) minus its fill (2) == 3.
  (5 - fillOf bankC) === 3

-- AUCT-01 (09-02) — NONCOMPETITIVE golden fixture, the Daml twin of the
-- `noncomp` scenario in solver/src/auction.test.ts (identical expected numbers =
-- Daml⇄TS parity). A noncompetitive SELL (C) sits alongside a competitive limit
-- buy (A) + competitive limit sell (B). C is willing at ANY price and rations
-- with TOP priority, capped at its qty; B is competitive and rationed AFTER C.
-- Noncomp is kept on the SELL side (single funded buyer — Pitfall 3).
--
--   A Buy 6 @100 (Limit)          demand@100 = 6
--   B Sell 5 @100 (Limit)         competitive supply@100 = 5
--   C Sell 4      (Noncompetitive) supply@ANY = 4   (limit field ignored; 0.0)
--
--   candidatePrices excludes noncomp → {100}.
--   @100: demand 6, supply 5+4 = 9 → matched 6 = traded.
--   Sells by priority: C (noncomp) first fills 4; B (competitive) fills the
--   remaining 2. Buys: A fills 6.
--   ⇒ p* = 100.00, fills A = 6 / B = 2 / C = 4 (noncomp C top-priority, full qty).
--
-- Discriminating: if priority were reversed, competitive B (qty 5) would fill 5
-- and noncomp C only 1 — so this fixture proves top priority, not just any fill.
test_noncomp_sell_top_priority : Script ()
test_noncomp_sell_top_priority = do
  bankA <- allocatePartyByHint (PartyIdHint "ncA")
  bankB <- allocatePartyByHint (PartyIdHint "ncB")
  bankC <- allocatePartyByHint (PartyIdHint "ncC")

  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 6; limit = 100.0; orderType = Limit;          minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 5; limit = 100.0; orderType = Limit;          minQty = None; firmIf = None
        -- Noncompetitive: `limit` is ignored (0.0 sentinel = willing at any price).
        , OrderView with desk = bankC; side = Sell; quantity = 4; limit = 0.0;   orderType = Noncompetitive; minQty = None; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]

  -- Clears at the single competitive candidate price.
  pStar === 100.0
  -- Noncomp C fills FIRST and FULLY (capped at its qty 4); competitive B rationed to 2.
  fillOf bankC === 4
  fillOf bankB === 2
  fillOf bankA === 6
  -- Conservation: buy fills == sell fills == traded (6).
  fillOf bankA === (fillOf bankB + fillOf bankC)
  -- The §4 canary is UNAFFECTED by the noncomp predicate (proven in test_clears_at_100).

-- AUCT-01 (09-03) — ALLORNONE / MAQ golden fixtures, the Daml twins of the
-- `maq`/`aon` scenarios in solver/src/auction.test.ts (identical expected numbers
-- = Daml⇄TS parity). A MAQ order participates only if its integer fill ≥ minQty at
-- the chosen (price, subset); else the bounded (price × subset) enumeration in
-- `coreClear` EXCLUDES it. All-or-none is the special case minQty == quantity.

-- MAQ EXCLUDED — C's fill (2) would fall BELOW its minQty (3) → C excluded, and
-- the book re-clears without it (A=8 / B=8, C=0).
--   A Buy 10 @100, B Sell 8 @100, C Sell 5 @100 (MAQ minQty=3).
--   subset {C}: @100 matched 10, sells B,C by priority → B=8, C=2. C 2 < 3 → INFEASIBLE.
--   subset {}:  @100 matched 8  → A=8, B=8. FEASIBLE and wins (only feasible).
test_maq_excluded : Script ()
test_maq_excluded = do
  bankA <- allocatePartyByHint (PartyIdHint "maqXA")
  bankB <- allocatePartyByHint (PartyIdHint "maqXB")
  bankC <- allocatePartyByHint (PartyIdHint "maqXC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 3; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- excluded: its feasible fill (2) < minQty (3)
  fillOf bankA === 8
  fillOf bankB === 8

-- MAQ INCLUDED — same book, but minQty=2, which C's fill (2) exactly MEETS → C is
-- included and the §4-shaped clear stands (A=10 / B=8 / C=2).
test_maq_included : Script ()
test_maq_included = do
  bankA <- allocatePartyByHint (PartyIdHint "maqIA")
  bankB <- allocatePartyByHint (PartyIdHint "maqIB")
  bankC <- allocatePartyByHint (PartyIdHint "maqIC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 2; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 2   -- included: fill (2) ≥ minQty (2), higher matched volume wins
  fillOf bankA === 10
  fillOf bankB === 8

-- ALL-OR-NONE FILLS — an all-or-none sell (minQty == quantity == 5) whose full 5
-- CAN be filled is included fully; the buy is rationed around it (A=7 / B=2 / C=5).
--   A Buy 10 @100, B Sell 2 @100, C Sell 5 @100 (AON minQty=5).
--   subset {C}: @100 supply 2+5=7, matched 7, sells B,C → B=2, C=5. C 5 ≥ 5 → FEASIBLE, matched 7.
--   subset {}:  @100 supply 2,     matched 2 → A=2, B=2. Lower matched → loses.
test_aon_all_or_none_fills : Script ()
test_aon_all_or_none_fills = do
  bankA <- allocatePartyByHint (PartyIdHint "aonFA")
  bankB <- allocatePartyByHint (PartyIdHint "aonFB")
  bankC <- allocatePartyByHint (PartyIdHint "aonFC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 2;  limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = AllOrNone; minQty = Some 5; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 5   -- all-or-none: fully filled (5 ≥ minQty 5)
  fillOf bankB === 2
  fillOf bankA === 7

-- ALL-OR-NONE DROPS — an all-or-none sell (minQty == quantity == 5) that CANNOT
-- reach its 5 (demand only 3) is dropped entirely (A=3 / B=3 / C=0).
--   A Buy 3 @100, B Sell 8 @100, C Sell 5 @100 (AON minQty=5).
--   subset {C}: @100 demand 3, matched 3, sells B,C → B=3, C=0. C 0 < 5 → INFEASIBLE.
--   subset {}:  @100 matched 3 → A=3, B=3. FEASIBLE and wins.
test_aon_all_or_none_drops : Script ()
test_aon_all_or_none_drops = do
  bankA <- allocatePartyByHint (PartyIdHint "aonDA")
  bankB <- allocatePartyByHint (PartyIdHint "aonDB")
  bankC <- allocatePartyByHint (PartyIdHint "aonDC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 3; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8; limit = 100.0; orderType = Limit;     minQty = None;   firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5; limit = 100.0; orderType = AllOrNone; minQty = Some 5; firmIf = None
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- dropped: cannot reach its all-or-none 5 (demand only 3)
  fillOf bankA === 3
  fillOf bankB === 3

-- AUCT-01 (09-03) — CONDITIONAL auto-firming golden fixtures, the Daml twins of
-- the `conditional` scenarios in solver/src/auction.test.ts (identical numbers =
-- parity). The two-pass rule: PASS 1 clears the FIRM book → provisional p*; PASS 2
-- firms each conditional whose firmIf passes vs that provP (sell firms iff
-- provP >= firmIf), drops the rest, and re-clears. Conditionals are kept on the
-- SELL side (single funded buyer — Pitfall 3).

-- CONDITIONAL FIRMS — a conditional sell with firmIf=99 firms because the
-- provisional p* (100, over the firm book A+B) is ≥ 99; the final clear then
-- includes it (§4-shaped A=10 / B=8 / C=2).
--   firm = {A Buy 10 @100, B Sell 8 @100} → provP = 100.
--   C Sell 5 @100 (Conditional firmIf=99): 100 >= 99 → FIRMS. final {A,B,C} → A=10/B=8/C=2.
test_conditional_firms : Script ()
test_conditional_firms = do
  bankA <- allocatePartyByHint (PartyIdHint "condFA")
  bankB <- allocatePartyByHint (PartyIdHint "condFB")
  bankC <- allocatePartyByHint (PartyIdHint "condFC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Conditional; minQty = None; firmIf = Some 99.0
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 2   -- firmed (provP 100 >= firmIf 99), then rationed to 2
  fillOf bankA === 10
  fillOf bankB === 8

-- CONDITIONAL DROPS — same book but firmIf=101 fails (provisional p* 100 < 101),
-- so the conditional sell DROPS and the firm book clears alone (A=8 / B=8, C=0).
test_conditional_drops : Script ()
test_conditional_drops = do
  bankA <- allocatePartyByHint (PartyIdHint "condDA")
  bankB <- allocatePartyByHint (PartyIdHint "condDB")
  bankC <- allocatePartyByHint (PartyIdHint "condDC")
  let views =
        [ OrderView with desk = bankA; side = Buy;  quantity = 10; limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankB; side = Sell; quantity = 8;  limit = 100.0; orderType = Limit;       minQty = None; firmIf = None
        , OrderView with desk = bankC; side = Sell; quantity = 5;  limit = 100.0; orderType = Conditional; minQty = None; firmIf = Some 101.0
        ]
      (pStar, allocs) = computeClearing views
      fillOf d = sum [ a.filledQty | a <- allocs, a.desk == d ]
  pStar === 100.0
  fillOf bankC === 0   -- dropped: provP 100 < firmIf 101
  fillOf bankA === 8
  fillOf bankB === 8

-- ===========================================================================
-- Phase-2 settlement seed helpers (RESEARCH A5 + Pitfall 5).
--
-- `runCanonicalRound` (Setup) only SUBMITS the three §4 orders — it never opens
-- or closes a Round, and the real `Round.Clear` (Option B, DECISIONS D7) needs
-- the round's `[ContractId Order]`, the buyer's USDCx `ContractId Asset`, and
-- each seller's BONDX `ContractId Asset` passed IN as choice args (a choice body
-- cannot `query` the ACS). So these helpers open a Round, submit the orders,
-- CloseRound, and locate the Option-B ContractIds at the SCRIPT tier via `query`.
-- ===========================================================================

-- Everything the real `Round.Clear` needs to settle the §4 fixture.
data SeedResult = SeedResult with
    parties        : Parties
    roundCid       : ContractId Round
    orderCids      : [ContractId Order]
    buyerUsdcCid   : ContractId Asset
    sellerBondCids : [(Party, ContractId Asset)]

-- Locate the (single) Asset cid an owner holds for a given symbol from the
-- operator's view of the ACS (Script-tier query — exactly why Option B passes
-- these into Clear; RESEARCH Pitfall 5).
findAssetCid : Party -> [(ContractId Asset, Asset)] -> Party -> Text -> ContractId Asset
findAssetCid owner assets _operator sym =
  case [ cid | (cid, a) <- assets, a.owner == owner, a.symbol == sym ] of
    (cid :: _) -> cid
    []         -> error ("findAssetCid: no Asset for " <> show owner <> " " <> sym)

-- Open a Round, submit the three §4 orders via the seeded Venue, CloseRound, and
-- collect the Option-B ContractIds. `bondForB` lets the underfunded variant seed
-- B with too little BONDX (it still SUBMITS the canonical §4 order — qty 8 @99 —
-- so computeClearing returns the canonical A=10/B=8/C=2 @100.0; only the holding
-- is undersized, so the failure is the missing asset, not a bad proposal).
seedAndClose : Decimal -> Script SeedResult
seedAndClose bondForB = do
  p@Parties{..} <- initialize
  -- The underfunded variant re-points B's BONDX holding at an undersized mint.
  -- (initialize already minted B 20.0 BONDX; for the underfunded case we mint a
  -- second, too-small BONDX holding and use IT as B's sellerBondCid below.)
  -- Open the Round (operator is signatory; desks observe). openedAt from getTime.
  now <- getTime
  roundCid0 <- submit operator do
    createCmd Round with
      operator
      roundId       = "R1"
      symbol        = "BONDX"
      desks         = [bankA, bankB, bankC]
      openedAt      = now
      windowSeconds = 60
      status        = Open

  -- Find the seeded Venue (one created by initialize) and submit the §4 orders.
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "seedAndClose: no Venue found after initialize"
  oa <- submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
  ob <- submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
  oc <- submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None

  -- CloseRound → status flips to Closed (the new contract is what Clear settles).
  roundCid <- submit operator do
    exerciseCmd roundCid0 CloseRound

  -- Optionally re-seed B's BONDX undersized (for the atomicity test): mint a
  -- too-small BONDX holding for B and use it as B's sellerBondCid so the Split in
  -- Clear (filledQty 8 > bondForB) throws and the whole tx rolls back.
  bondBCidM <- if bondForB < 20.0
    then do
      -- B already has 20.0 BONDX from initialize; mint the undersized one and
      -- point sellerBondCids at it so the seller is effectively short.
      cid <- mintAsset operator bankB "BONDX" bondForB
      pure (Some cid)
    else pure None

  -- Locate the Option-B ContractIds (Script-tier query).
  assets <- query @Asset operator
  let buyerUsdcCid = findAssetCid bankA assets operator "USDCx"
      bondCcid     = findAssetCid bankC assets operator "BONDX"
      bondBcid     = case bondBCidM of
        Some cid -> cid                                       -- undersized holding
        None     -> findAssetCid bankB assets operator "BONDX"
  pure SeedResult with
    parties        = p
    roundCid
    orderCids      = [oa, ob, oc]
    buyerUsdcCid
    sellerBondCids = [(bankB, bondBcid), (bankC, bondCcid)]

-- Canonical §4 seed: B funded (20.0 BONDX) — used by test_settled_balances and
-- test_clear_rejects_bad_allocation (rejection is by re-verification, not assets).
seedCanonicalAndClose : Script SeedResult
seedCanonicalAndClose = seedAndClose 20.0

-- Underfunded-seller seed: B holds only 5.0 BONDX (< its fill of 8) — used by
-- test_atomicity to prove the Split/ensure throws and the whole Clear rolls back.
seedUnderfundedSellerAndClose : Script SeedResult
seedUnderfundedSellerAndClose = seedAndClose 5.0

-- The verified §4 allocation (A buys 10, B sells 8, C sells 2 — C residual 3).
canonicalAllocs : Party -> Party -> Party -> [Allocation]
canonicalAllocs bankA bankB bankC =
  [ Allocation with desk = bankA; side = Buy;  filledQty = 10
  , Allocation with desk = bankB; side = Sell; filledQty = 8
  , Allocation with desk = bankC; side = Sell; filledQty = 2
  ]

-- SETL-01/SETL-02 — after a successful Round.Clear on the §4 fixture the ledger
-- shows the EXACT spec §4 post-balances (A:10/4000, B:12/1800, C:13/1200) and
-- both BONDX and USDCx are conserved end-to-end (totals unchanged vs the seed:
-- 35.0 BONDX, 7000.0 USDCx). A per-desk TradeConfirmation exists. These are the
-- two things HackCanton judges check (spec §10) — assert them exactly.
test_settled_balances : Script ()
test_settled_balances = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Settle: drive the REAL Clear with the verified §4 allocation @100.0 and the
  -- Option-B ContractIds. operator authority alone (operator-custody DvP).
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0
  -- Sum each owner's Assets per symbol from the operator's view of the ACS.
  assets <- query @Asset operator
  let bal owner sym = sum [ a.quantity | (_, a) <- assets, a.owner == owner, a.symbol == sym ]
  -- The EXACT spec §4 post-settlement balances (non-negotiable correctness ref).
  bal bankA "BONDX" === 10.0
  bal bankA "USDCx" === 4000.0
  bal bankB "BONDX" === 12.0
  bal bankB "USDCx" === 1800.0
  bal bankC "BONDX" === 13.0
  bal bankC "USDCx" === 1200.0
  -- Conservation: global totals unchanged vs the §4 seed (no value created/destroyed).
  let totalBondx = sum [ a.quantity | (_, a) <- assets, a.symbol == "BONDX" ]
      totalUsdc  = sum [ a.quantity | (_, a) <- assets, a.symbol == "USDCx" ]
  totalBondx === 35.0     -- 20 (B) + 15 (C) seeded; A had 0 BONDX
  totalUsdc  === 7000.0   -- 5000 (A) + 1000 (B) + 1000 (C)
  -- A per-desk TradeConfirmation receipt exists (one per participating desk).
  confs <- query @TradeConfirmation operator
  assertMsg "expected a TradeConfirmation per desk" (length confs == 3)
  -- AUCT-04: every receipt carries the TCA fields — surplusVsLimit ≥ 0 (the proven,
  -- on-ledger best-ex number) and the labeled referencePrice stub (== 100.0 here).
  forA_ confs $ \(_, t) -> do
    assertMsg "surplusVsLimit must be ≥ 0 on every §4 receipt" (t.surplusVsLimit >= 0.0)
    assertMsg "referencePrice stub recorded on the receipt" (t.referencePrice == 100.0)
  -- The EXACT §4 proven surpluses: A=(101-100)*10=10, B=(100-99)*8=8, C=(100-100)*2=0.
  let surplusOf d = sum [ t.surplusVsLimit | (_, t) <- confs, t.desk == d ]
  surplusOf bankA === 10.0
  surplusOf bankB === 8.0
  surplusOf bankC === 0.0

-- AUCT-04 — the on-ledger surplus≥0 PROOF. After a real §4 settle, every per-desk
-- TradeConfirmation carries surplusVsLimit ≥ 0 (the structurally-non-negative,
-- ledger-provable best-execution number). If Round.Clear's `assertMsg surplusVsLimit
-- >= 0` were removed OR the surplus math were wrong (so the §4 allocation produced a
-- negative surplus), this fails LOUDLY — the settle would abort, not merely mis-report.
test_surplus_nonneg : Script ()
test_surplus_nonneg = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Drive the REAL Clear with the verified §4 allocation @100.0 + the reference stub.
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0
  confs <- query @TradeConfirmation operator
  assertMsg "expected a TradeConfirmation per desk" (length confs == 3)
  -- The proof: NO receipt has a negative surplus-vs-limit (asserted on-ledger).
  forA_ confs $ \(_, t) ->
    assertMsg ("surplusVsLimit must be ≥ 0 for " <> show t.desk) (t.surplusVsLimit >= 0.0)
  -- Discriminating: A's proven surplus is STRICTLY positive ((101-100)*10 = 10) — proves
  -- the field is really computed, not a trivial 0-everywhere stub.
  let surplusOf d = sum [ t.surplusVsLimit | (_, t) <- confs, t.desk == d ]
  surplusOf bankA === 10.0

-- SETL-03 — atomicity: a seller short the BONDX makes a settlement leg fail, so
-- Round.Clear is rejected (submitMustFail) and NO balance changes — the whole
-- transaction rolls back (all-or-nothing DvP). The proposed allocation is the
-- internally-valid §4 one; the failure is the missing asset, not a bad proposal.
test_atomicity : Script ()
test_atomicity = do
  SeedResult{..} <- seedUnderfundedSellerAndClose
  let Parties{..} = parties
  -- Snapshot every Asset (owner, symbol, quantity) BEFORE the failing Clear.
  before <- query @Asset operator
  let snap xs = sort [ (show a.owner, a.symbol, a.quantity) | (_, a) <- xs ]
  -- B holds only 5.0 BONDX but must deliver 8 → the Split throws → rollback.
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0
  -- All-or-nothing: the post-failure ACS is IDENTICAL to the pre-Clear snapshot.
  after <- query @Asset operator
  snap after === snap before

-- SETL-04/CLEAR-05 — the on-ledger recompute-and-assert backstop rejects any
-- wrong/unfair proposal on a FUNDED round (so rejection is by re-verification,
-- NOT by missing assets): both an over-stated allocation (A buys 12) and a wrong
-- clearing price (99.0 with correct fills) must fail.
test_clear_rejects_bad_allocation : Script ()
test_clear_rejects_bad_allocation = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- Bad fills: A buys 12 (exceeds its order qty 10 and the traded volume 10),
  -- C sells 4 — violates max-matched volume + per-order limits. REJECTED.
  let badAllocs =
        [ Allocation with desk = bankA; side = Buy;  filledQty = 12
        , Allocation with desk = bankB; side = Sell; filledQty = 8
        , Allocation with desk = bankC; side = Sell; filledQty = 4
        ]
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = badAllocs
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0
  -- Wrong price: correct §4 fills but clearingPrice = 99.0 (not the recomputed
  -- p* = 100.0). REJECTED by the price half of the recompute-and-assert.
  submitMustFail operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 99.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0

-- ===========================================================================
-- §16 privacy proofs (PRIV-01..04). Privacy is already STRUCTURAL from the
-- Phase-1 field shapes (Order: signatory operator+desk, NO observer; Asset:
-- observer owner; TradeConfirmation: observer singular desk; RoundStats:
-- observer desks, count only). These two scripts PROVE it: a stray observer
-- added later makes a `length === 1` / `all (_.desk == thisDesk)` assertion
-- fail LOUDLY. Key fact: in Daml Script, `query @T party` returns ONLY contracts
-- where `party` is a stakeholder — the returned set IS the disclosure boundary.
-- ===========================================================================

-- PRIV-01/02/04 — submit the 3 §4 orders, then prove per-party Order visibility
-- is isolated (each desk sees ONLY its own, operator sees all 3), the RoundStats
-- count is the ONLY pre-clear shared info, and Assets are owner+operator scoped.
test_privacy_orders : Script ()
test_privacy_orders = do
  Parties{..} <- initialize
  venues <- query @Venue operator
  let venueCid = case venues of
        ((v, _) :: _) -> v
        []            -> error "test_privacy_orders: no Venue found after initialize"
  -- the three §4 orders, each submitted under its OWN desk authority
  _ <- submit bankA do
    exerciseCmd venueCid SubmitOrder with
      desk = bankA; roundId = "R1"; side = Buy;  quantity = 10; limit = 101.0
      orderType = Limit; minQty = None; firmIf = None
  _ <- submit bankB do
    exerciseCmd venueCid SubmitOrder with
      desk = bankB; roundId = "R1"; side = Sell; quantity = 8;  limit = 99.0
      orderType = Limit; minQty = None; firmIf = None
  _ <- submit bankC do
    exerciseCmd venueCid SubmitOrder with
      desk = bankC; roundId = "R1"; side = Sell; quantity = 5;  limit = 100.0
      orderType = Limit; minQty = None; firmIf = None

  -- seed RoundStats{count = 3} (operator-signed, observer = desks) for PRIV-02
  _ <- submit operator do
    createCmd RoundStats with
      operator
      roundId          = "R1"
      desks            = [bankA, bankB, bankC]
      sealedOrderCount = 3

  -- PRIV-01: each desk sees exactly ITS OWN order, zero of the others' ----------
  aOrders <- query @Order bankA
  bOrders <- query @Order bankB
  cOrders <- query @Order bankC
  length aOrders === 1
  length bOrders === 1
  length cOrders === 1
  -- the single visible order belongs to the querying desk (no cross-leak)
  assertMsg "BankA sees only its own order" (all (\(_, o) -> o.desk == bankA) aOrders)
  assertMsg "BankB sees only its own order" (all (\(_, o) -> o.desk == bankB) bOrders)
  assertMsg "BankC sees only its own order" (all (\(_, o) -> o.desk == bankC) cOrders)
  -- operator (Order signatory) sees all three
  ops <- query @Order operator
  length ops === 3

  -- PRIV-02: desks see the RoundStats COUNT, never order contents of others ------
  aStats <- query @RoundStats bankA
  length aStats === 1
  assertMsg "desk sees the sealed-order count = 3"
    (all (\(_, s) -> s.sealedOrderCount == 3) aStats)
  -- (already proven above: BankA's query @Order returns ONLY its own — never B/C)

  -- PRIV-04: Assets are visible only to owner + operator -------------------------
  aAssets <- query @Asset bankA
  assertMsg "BankA sees only its own holdings"
    (all (\(_, a) -> a.owner == bankA) aAssets)
  bAssets <- query @Asset bankB
  assertMsg "BankB sees only its own holdings"
    (all (\(_, a) -> a.owner == bankB) bAssets)
  -- operator (Asset signatory) sees ALL holdings (the §4 seed: 5 contracts)
  allAssets <- query @Asset operator
  length allAssets === 5

-- PRIV-03 — after a REAL Round.Clear settles the §4 fixture, each desk sees ONLY
-- its own TradeConfirmation (observer = singular desk); no cross-visibility of
-- fills. Reuses the Phase-2 seedCanonicalAndClose + canonicalAllocs helpers.
test_privacy_confirmations : Script ()
test_privacy_confirmations = do
  SeedResult{..} <- seedCanonicalAndClose
  let Parties{..} = parties
  -- settle with the verified §4 allocation @100.0 (operator authority)
  _ <- submit operator do
    exerciseCmd roundCid Clear with
      clearingPrice  = 100.0
      allocations    = canonicalAllocs bankA bankB bankC
      orderCids
      buyerUsdcCid
      sellerBondCids
      referencePrice = 100.0

  -- each desk sees exactly its own confirmation; operator sees all three
  aConfs <- query @TradeConfirmation bankA
  bConfs <- query @TradeConfirmation bankB
  cConfs <- query @TradeConfirmation bankC
  length aConfs === 1
  length bConfs === 1
  length cConfs === 1
  assertMsg "BankA sees only its own confirmation" (all (\(_, t) -> t.desk == bankA) aConfs)
  assertMsg "BankB sees only its own confirmation" (all (\(_, t) -> t.desk == bankB) bConfs)
  assertMsg "BankC sees only its own confirmation" (all (\(_, t) -> t.desk == bankC) cConfs)
  -- cross-check: BankA is NOT a stakeholder of BankB's confirmation
  assertMsg "no cross-desk confirmation leak"
    (notElem bankB [ t.desk | (_, t) <- aConfs ])
  allConfs <- query @TradeConfirmation operator
  length allConfs === 3

-- ===========================================================================
-- CRYP-01 (10-01) — on-ledger COMMIT–REVEAL proofs. These prove the ledger
-- itself (not the operator) is the accept/reject authority for a reveal, that a
-- valid reveal returns the escrowed bond, and that a non-revealing desk forfeits
-- it. Round.Clear and the §8 math are UNTOUCHED — the binding lives entirely in
-- OrderCommitment.RevealOrder / .ForfeitBond and the Venue.CommitOrder escrow.
-- ===========================================================================

-- Locate the (single) USDCx holding an owner has after `initialize`, from the
-- operator's view of the ACS (Script-tier query — same idiom as findAssetCid).
findUsdcCid : Party -> [(ContractId Asset, Asset)] -> ContractId Asset
findUsdcCid owner assets =
  case [ cid | (cid, a) <- assets, a.owner == owner, a.symbol == "USDCx" ] of
    (cid :: _) -> cid
    []         -> error ("findUsdcCid: no USDCx for " <> show owner)

-- Find the single Venue seeded by `initialize`.
findVenueCid : Party -> Script (ContractId Venue)
findVenueCid operator = do
  venues <- query @Venue operator
  case venues of
    ((v, _) :: _) -> pure v
    []            -> abort "findVenueCid: no Venue found after initialize"

-- T-10-01 — a reveal whose sha256(order‖salt) does NOT equal the stored
-- commitment is rejected ON-LEDGER. BankA commits its §4 order (Buy 10 @101);
-- revealing with a WRONG salt, and revealing a DIFFERENT order (qty 12) with the
-- RIGHT salt, both `submitMustFail` — the ledger recomputes the digest and aborts.
test_reveal_mismatch_rejected : Script ()
test_reveal_mismatch_rejected = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  -- Carve a small USDCx bond slice from BankA's own holding (value-conserving).
  assets0 <- query @Asset operator
  let aUsdc = findUsdcCid bankA assets0
  (aBond, _rem) <- submit operator do exerciseCmd aUsdc Split with splitQty = 10.0
  -- Commit the §4 Buy order under the correct salt.
  let comm = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
  oc <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"; commitment = comm; bondCid = aBond
  -- Wrong salt → the recomputed digest differs → REJECTED on-ledger.
  submitMustFail bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "WRONG-salt"
  -- Right salt but a DIFFERENT order (qty 12 not 10) → also REJECTED on-ledger.
  submitMustFail bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 12; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  -- The commitment is still live (neither failed reveal consumed it); no Order exists.
  ocs <- query @OrderCommitment operator
  length ocs === 1
  orders <- query @Order operator
  length orders === 0

-- T-10-01 (return leg) — a VALID, timely reveal releases the bond lock and
-- creates the sealed Order. The bond (the desk's own USDCx, locked in operator
-- custody during the window) is freely the desk's after a valid reveal, and the
-- OrderCommitment is consumed (no further ForfeitBond possible).
test_bond_returned : Script ()
test_bond_returned = do
  Parties{..} <- initialize
  venueCid <- findVenueCid operator
  assets0 <- query @Asset operator
  let aUsdc = findUsdcCid bankA assets0
  (aBond, _rem) <- submit operator do exerciseCmd aUsdc Split with splitQty = 10.0
  let comm = commitOf (serializeOrder Buy 10 101.0 Limit None None) "saltA"
  oc <- submit bankA do
    exerciseCmd venueCid CommitOrder with
      desk = bankA; roundId = "R1"; commitment = comm; bondCid = aBond
  -- While the commitment is live the desk cannot move its own bond (every Asset
  -- choice is controller operator) — locked in operator custody.
  submitMustFail bankA do
    exerciseCmd aBond (Reassign with newOwner = bankB)
  -- A valid reveal: the ledger recompute matches → bond lock released + Order created.
  _ <- submit bankA do
    exerciseCmd oc RevealOrder with
      side = Buy; quantity = 10; limit = 101.0; orderType = Limit; minQty = None; firmIf = None
      salt = "saltA"
  -- The commitment is consumed (lock released) ...
  ocs <- query @OrderCommitment operator
  length ocs === 0
  -- ... the desk still owns its 10.0 USDCx bond (returned/released) ...
  afterA <- query @Asset bankA
  assertMsg "bond is the desk's after a valid reveal"
    (any (\(_, a) -> a.owner == bankA && a.symbol == "USDCx" && a.quantity == 10.0) afterA)
  -- ... and its sealed §4 Order now exists (visible to the desk, one order).
  aOrders <- query @Order bankA
  length aOrders === 1
  assertMsg "revealed order is BankA's Buy 10 @101"
    (all (\(_, o) -> o.desk == bankA && o.side == Buy && o.quantity == 10 && o.limit == 101.0) aOrders)
