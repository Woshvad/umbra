# deploy/devnet/.env.devnet — Splice validator DevNet onboarding inputs.
# Copy to deploy/devnet/.env.devnet (gitignored) and fill in. NO secrets are committed.
# Values come from the hackathon organizers / the Splice DevNet docs (see docs/DEVNET.md §2).

# The Splice release you download the validator Compose bundle from (pin it).
SPLICE_VERSION=

# Sponsor super-validator base URL (from the organizers / a public DevNet SV).
SPONSOR_SV_URL=

# Target global-synchronizer migration id for DevNet (from the organizers / docs).
MIGRATION_ID=

# Onboarding secret. Leave EMPTY on DevNet to self-serve one from SPONSOR_SV_URL
# (valid ~1h); or paste a manually-issued secret. NEVER commit a real value.
ONBOARDING_SECRET=

# Your static PUBLIC egress IP. It must be added to the SV allowlist before the
# validator can join — adoption takes ~2-7 days, so submit it EARLY.
EGRESS_IP=

# Path to the extracted Splice validator Compose bundle (the dir containing start.sh).
VALIDATOR_BUNDLE_DIR=

# false = keep the bundle's default self-signed tokens (matches our local unsafe path,
# so the existing scripts can work as-is). true = real OIDC (start.sh -a) + fill the
# OIDC_* vars in solver/.env.devnet + web/.env.devnet.
ENABLE_OIDC=false
