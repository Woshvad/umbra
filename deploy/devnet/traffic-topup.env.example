# ============================================================================
# Umbra — Canton-Coin traffic auto-top-up config for the DevNet validator (CHAIN-03).
#
# The Splice validator app buys sequencer traffic pay-as-you-go. On DevNet the coin
# is AUTO-TAPPED (a faucet-style tap), so NO funded/pre-loaded wallet is required —
# the node self-provisions traffic. These two knobs govern the auto-top-up loop; the
# validator app tops up when throughput demand crosses the target, throttled by the
# minimum interval. (On MainNet this would draw from a funded wallet — out of scope.)
#
# Placeholders/defaults only — copy the values you use into the validator .env at UAT.
# Unattended top-up against a LIVE node is UAT; this file is config, not a live process.
# ============================================================================

# Target sequencer traffic throughput to maintain (bytes/s-class unit the validator
# app expects). 20000 is a sane DevNet default for a low-volume batch-auction node.
TARGET_TRAFFIC_THROUGHPUT=20000

# Minimum interval between successive top-ups (Go duration string, e.g. 1m/5m/1h).
# Throttles the auto-tap so the node doesn't top up on every micro-fluctuation.
MIN_TRAFFIC_TOPUP_INTERVAL=1m
