# ============================================================================
# Umbra — Splice DevNet validator .env (PLACEHOLDERS ONLY — copy to .env, fill AT THE GATE)
#
# ⚠ EXTERNAL GATE — NEVER faked offline. This file parameterizes a Splice
#   self-hosted validator that joins the REAL Global Synchronizer on Canton
#   DevNet. A genuine connection requires SUPER-VALIDATOR SPONSORSHIP:
#     1. a static egress IP adopted onto the SV allowlist (2–7 days, Pitfall 4)
#     2. a SPONSOR_SV_URL from the sponsoring Super Validator
#     3. a one-time JIT ONBOARDING_SECRET (self-serve 1h / SV-issued 48h, Pitfall 5)
#   None of these can be produced on this box. Booting this compose without them
#   does NOT constitute a live connection — see deploy/SV-SPONSOR-CHECKLIST.md.
#
#   NO real secret / sponsor URL / onboarding secret is committed — placeholders
#   only. Real values live in a gitignored .env at UAT.
# ============================================================================

# ── Splice validator image (vet the digest/tag at the official registry at UAT) ──
# The self-hosted validator compose ships from hyperledger-labs/splice. Pin the
# release the sponsoring SV runs (MIGRATION_ID must match the network's migration).
IMAGE_REPO=ghcr.io/hyperledger-labs/splice
IMAGE_TAG=REPLACE_WITH_SV_NETWORK_RELEASE_TAG_AT_UAT

# ── SV sponsorship inputs (EXTERNAL GATE — obtained via SV-SPONSOR-CHECKLIST.md) ──
# The sponsoring Super Validator's onboarding URL. Placeholder ONLY.
SPONSOR_SV_URL=REPLACE_WITH_SPONSOR_SV_URL_AT_UAT
# One-time JIT onboarding secret — generate JUST before ./start.sh (1h/48h expiry,
# Pitfall 5). NEVER commit a real value; NEVER reuse a stale one.
ONBOARDING_SECRET=REPLACE_WITH_JIT_ONBOARDING_SECRET_AT_UAT
# DevNet migration id — MUST equal the network's current migration (Pitfall 6 class).
MIGRATION_ID=REPLACE_WITH_DEVNET_MIGRATION_ID_AT_UAT

# ── Party hint (Pitfall 7 — DevNet enforces <org>-<function>-<enumerator>) ──
# LocalNet already uses this exact namespaced hint (scripts/localnet/up.mjs).
PARTY_HINT=umbra-operator-1

# ── OIDC auth (dual-mode; the DevNet/prod path — mirrors deploy/canton +
#    deploy/keycloak from 12-02/12-03). The audience is byte-identical to the
#    dev HS256 token — only the signing alg + key source change. ──
AUTH_URL=REPLACE_WITH_OIDC_ISSUER_BASE_AT_UAT
AUTH_JWKS_URL=${AUTH_URL}/protocol/openid-connect/certs
# XOR with LEDGER_API_AUTH_SCOPE — configure ONE (audience chosen, Pitfall 2).
LEDGER_API_AUTH_AUDIENCE=https://canton.network.global
LEDGER_API_AUTH_SCOPE=daml_ledger_api
# The admin user MUST equal the client-credentials token `sub` (Pitfall 3 — the
# #1 live-failure mode). devnet-deploy.mjs grants THIS user the operator rights.
LEDGER_API_ADMIN_USER=REPLACE_WITH_SOLVER_SERVICE_ACCOUNT_SUB_AT_UAT
# The confidential umbra-solver client (client-credentials). Secret is server-side
# ONLY, gitignored, never in a browser bundle.
VALIDATOR_AUTH_CLIENT_ID=umbra-solver
VALIDATOR_AUTH_CLIENT_SECRET=REPLACE_WITH_UMBRA_SOLVER_CLIENT_SECRET_AT_UAT

# ── Canton-Coin traffic auto-top-up (CHAIN-03; DevNet auto-taps coin — no funded
#    wallet needed). See deploy/devnet/traffic-topup.env.example. ──
TARGET_TRAFFIC_THROUGHPUT=20000
MIN_TRAFFIC_TOPUP_INTERVAL=1m

# ── Participant persistent store (isolated per-network Postgres, off LocalNet
#    :55432 and the Keycloak stack :55433). See deploy/devnet/postgres/. ──
POSTGRES_HOST=devnet-postgres
POSTGRES_PORT=5432
POSTGRES_DB=umbra_devnet_participant
POSTGRES_USER=umbra_devnet
POSTGRES_PASSWORD=REPLACE_WITH_STRONG_DB_PASSWORD_AT_UAT

# ── Host-side published ports (deliberately OFF the LocalNet :3975/:2975/:4975/:9090
#    and Keycloak :8443/:8081/:55433 stacks to avoid collisions on the ops box). ──
JSON_LEDGER_API_PORT=6975    # participant JSON Ledger API v2 (off LocalNet :3975/:2975/:4975)
VALIDATOR_ADMIN_PORT=5003    # validator app admin
WALLET_UI_PORT=3020          # CN wallet web UI
CNS_UI_PORT=3021             # Canton Name Service UI
