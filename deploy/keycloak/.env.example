# Umbra Keycloak stack — env template (PLACEHOLDERS ONLY).
#
# Copy to `.env` (gitignored) and fill REAL values at UAT. Nothing here is a live secret.
#   cp .env.example .env
#
# The umbra-solver CONFIDENTIAL client secret is NOT set here — it is defined in the realm
# (deploy/keycloak/umbra-realm.json, placeholder) / rotated in the Keycloak admin console,
# then copied into the SOLVER's gitignored .env as OIDC_CLIENT_SECRET. It never reaches the
# browser (umbra-web is a public PKCE client with no secret).

# --- Keycloak Postgres (isolated instance/volume; host port :55433, off LocalNet :55432) ---
KC_DB_USERNAME=keycloak
KC_DB_PASSWORD=CHANGE_ME_AT_UAT

# --- Keycloak bootstrap admin (first-boot console login; rotate immediately at UAT) ---
KC_BOOTSTRAP_ADMIN_USERNAME=admin
KC_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_AT_UAT

# --- Public hostname the issuer/JWKS URLs are built from (matches the Caddyfile site) ---
KC_HOSTNAME=https://keycloak.umbra.dev:8443
