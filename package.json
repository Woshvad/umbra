    "down": "node scripts/localnet/down.mjs",
    "deploy": "node scripts/localnet/deploy.mjs",
    "seed": "node scripts/localnet/seed.mjs",
    "xnode": "node scripts/localnet/xnode-up.mjs",
    "verify": "node scripts/localnet/verify-settlement.mjs",
    "verify:live": "node scripts/localnet/verify-live-flow.mjs",
