# solver/.env.devnet.example — solver profile for a SELF-HOSTED Splice validator on DevNet.
# Copy to solver/.env (gitignored) when cutting over. Assumes the validator runs on the SAME
# box as the solver, so the JSON Ledger API is reachable on localhost (no external ingress).
# See docs/DEVNET.md. VERIFY the JSON API host/port against your validator bundle.

# The validator's JSON Ledger API v2 base. The standalone Splice validator serves it behind
# nginx at json-ledger-api.localhost (port 80) — NOT the LocalNet :3975 scheme. Confirm and set.
JSON_API_URL=http://json-ledger-api.localhost

SOLVER_PORT=4100
ROUND_SECONDS=60
ANTHROPIC_API_KEY=

# Auth — two options on YOUR OWN validator:
#  (A) Keep the bundle's DEFAULT self-signed tokens (ENABLE_OIDC=false in deploy/devnet). Then
#      leave the OIDC_* vars unset and the existing scripts/mint-jwt path can work AS-IS once the
#      token format is confirmed to match. Simplest cutover.
#  (B) Real OIDC (validator started with -a). Fill ALL of these from your IDP (Auth0/Keycloak):
# OIDC_ISSUER=
# OIDC_JWKS_URL=
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_OPERATOR_PARTY=

# Four-eyes compliance (must be a DISTINCT party from the operator):
# COMPLIANCE_PARTY=
# COMPLIANCE_TOKEN=
