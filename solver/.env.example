# solver/.env — copy to .env (gitignored) and fill in. NEVER commit real secrets.
# The browser never reads this file; only the solver service (server-side) does.

# Canton JSON Ledger API v2 base URL — the cn-quickstart LocalNet app-provider
# participant (:3975). The solver appends absolute /v2/... paths and strips any
# trailing slash. (The legacy Daml 2.x `daml start` sandbox HTTP JSON API v1 was
# :7575/ — preserved at git tag `sandbox-mvp`.)
JSON_API_URL=http://localhost:3975

# The solver HTTP API bind port. Defaults to 4100 on the dev box because the user's
# separate `augur` project owns :4000; web/.env's VITE_SOLVER_URL must match.
SOLVER_PORT=4100

# The auction window in seconds (drives the in-memory clock auto-close timer).
ROUND_SECONDS=60

# Anthropic API key — consumed by solver/src/agent.ts (the AI solver agent, Phase 5).
# Read ONLY here (server-side), held module-private, never returned/logged/in the frontend
# (spec §15). OPTIONAL: leave EMPTY and the demo still runs — agent.ts degrades gracefully
# to the deterministic §8 clearing (the §4 fixture clears at 100.00 with or without a key).
# OPS-02: resolved at boot through the SecretsProvider (see SECRETS_PROVIDER below).
ANTHROPIC_API_KEY=

# ── OPS-01 Observability (OpenTelemetry) ──────────────────────────────────────────
# The OTLP/HTTP collector endpoint for traces + metrics. COMMENTED OUT by default: when
# UNSET, telemetry degrades to the OTel Console exporters (spans/metrics print to stdout),
# so tracing works offline with NO collector running. Set it to export to a real collector
# at UAT/prod (e.g. http://localhost:4318).
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# ── OPS-02 Secrets (SecretsProvider) ──────────────────────────────────────────────
# Selects the secret backend: `env` (dev default — reads process.env, preserving current
# .env behavior byte-for-byte) or `vault` (HashiCorp Vault KV v2 over HTTP). Leave `env`
# for the local demo; set `vault` only when a Vault instance is deployed at UAT.
SECRETS_PROVIDER=env

# HashiCorp Vault address + access token — read ONLY by the `vault` SecretsProvider backend
# (server-side, held module-private, never logged/returned). Unused when SECRETS_PROVIDER=env.
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
