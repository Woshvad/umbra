# solver/.env — copy to .env (gitignored) and fill in. NEVER commit real secrets.
# The browser never reads this file; only the solver service (server-side) does.

# Canton JSON Ledger API v2 base URL — the cn-quickstart LocalNet app-provider
# participant (:3975). The solver appends absolute /v2/... paths and strips any
# trailing slash. (The legacy Daml 2.x `daml start` sandbox HTTP JSON API v1 was
# :7575/ — preserved at git tag `sandbox-mvp`.)
JSON_API_URL=http://localhost:3975

# The solver HTTP API bind port (spec §11 surface).
SOLVER_PORT=4000

# The auction window in seconds (drives the in-memory clock auto-close timer).
ROUND_SECONDS=60

# Anthropic API key — consumed by solver/src/agent.ts (the AI solver agent, Phase 5).
# Read ONLY here (server-side), held module-private, never returned/logged/in the frontend
# (spec §15). OPTIONAL: leave EMPTY and the demo still runs — agent.ts degrades gracefully
# to the deterministic §8 clearing (the §4 fixture clears at 100.00 with or without a key).
ANTHROPIC_API_KEY=
