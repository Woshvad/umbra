# solver/.env.railway.example — the Railway env-var CONTRACT for the deployed solver.
#
# VARIABLE NAMES ONLY. Every value below is a placeholder describing the shape of the real
# value; NOTHING here is a live credential and this file is TRACKED, so it must stay that way.
# The real values live in solver/.env.devnet (gitignored) and are pushed to Railway with
# `railway variables --set 'NAME=value'` (see docs/DEPLOY.md).
#
# NOTE: Railway injects PORT itself — do NOT set it. The solver binds process.env.PORT when
# present (index.ts), falling back to SOLVER_PORT and then 4100 for local dev.

# ── Required: the AI solver agent (server-side only; never reaches the browser) ──────
ANTHROPIC_API_KEY=sk-ant-…

# ── Required: the Canton validator the solver AND the ledger proxy talk to ───────────
JSON_API_URL=https://ledger-api.validator.devnet.sandbox.fivenorth.io

# ── Required: DevNet OIDC (client-credentials m2m). OIDC_ISSUER being SET is what
#    switches the solver off the LocalNet dev-token path and onto the real OIDC path.
OIDC_ISSUER=https://auth.sandbox.fivenorth.io/application/o/validator-devnet-m2m/
OIDC_TOKEN_URL=https://auth.sandbox.fivenorth.io/application/o/token/
OIDC_JWKS_URL=https://auth.sandbox.fivenorth.io/application/o/validator-devnet-m2m/jwks/
OIDC_CLIENT_ID=validator-devnet-m2m
OIDC_CLIENT_SECRET=…                      # SECRET — set via `railway variables`, never committed
OIDC_AUDIENCE=validator-devnet-m2m

# ── Required: on-ledger identities (PUBLIC party ids, not secrets) ───────────────────
OIDC_OPERATOR_PARTY=umbra-operator-…::1220…
COMPLIANCE_PARTY=umbra-compliance-…::1220…
COMPLIANCE_TOKEN=…                        # SECRET — the distinct four-eyes compliance bearer

# ── Required: the deployed Daml package ──────────────────────────────────────────────
UMBRA_PACKAGE_ID=…
UMBRA_PACKAGE_NAME=umbra-sealed-auction

# ── Required for a public link: allow the Vercel origin to call this service ─────────
# Comma-separated exact origins. `*` opts into reflect-any-origin (permissive demo mode).
# UNSET ⇒ http://localhost:5173 only (the historical dev-only behaviour).
CORS_ORIGIN=https://<your-app>.vercel.app

# ── Optional: the browser-facing ledger proxy (ON by default) ────────────────────────
# LEDGER_PROXY=off                         # disable the proxy entirely
# LEDGER_PROXY_TARGET=https://ledger-api.validator.devnet.sandbox.fivenorth.io
#                                          # defaults to JSON_API_URL, so normally omit this
# LEDGER_PROXY_TOKEN=…                     # SECRET — a static bearer that OVERRIDES the OIDC
#                                          # acquisition. Normally omit: with OIDC_ISSUER set
#                                          # the proxy mints/refreshes its own m2m bearer.
