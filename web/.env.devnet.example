# web/.env.devnet.example — web profile for DevNet. Copy to web/.env (gitignored) at cutover.
# NO secrets (the web is a public PKCE client). See docs/DEVNET.md.

# The solver stays reachable at its own URL (unchanged).
VITE_SOLVER_URL=http://localhost:4100

# Desk auth:
#  - blank  → keep the pre-minted per-desk tokens (tokens.json) — works with the validator's
#             default self-signed tokens (ENABLE_OIDC=false).
#  - set    → OIDC auth-code + PKCE desk login against your IDP realm (validator started with -a).
VITE_OIDC_AUTHORITY=

VITE_ROUND_ID=R1

# NOTE (code gap, see docs/DEVNET.md §5): the browser reaches the ledger via tokens.json `base`
# + the Vite proxy. For DevNet, add a proxy entry (or a configurable base) pointing at the
# validator's JSON Ledger API host, plus CORS/TLS as needed. This is the one web change required.
