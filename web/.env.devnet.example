# web/.env.devnet.example — web profile for DevNet. Copy to web/.env (gitignored) at cutover.
# NO secrets (the web is a public PKCE client). See docs/DEVNET.md.

# The solver stays reachable at its own URL — and, since the ledger proxy is mounted on the
# SAME service, this is the ONLY URL a deploy has to change. On Vercel, set it to the public
# Railway solver URL (https://<service>.up.railway.app). See docs/DEPLOY.md.
VITE_SOLVER_URL=http://localhost:4100

# Only for a split deployment (ledger proxy NOT co-hosted with the solver API). Blank ⇒
# the ledger calls reuse VITE_SOLVER_URL.
VITE_LEDGER_BASE_URL=

# Desk auth:
#  - blank  → keep the pre-minted per-desk tokens (tokens.json) — works with the validator's
#             default self-signed tokens (ENABLE_OIDC=false).
#  - set    → OIDC auth-code + PKCE desk login against your IDP realm (validator started with -a).
VITE_OIDC_AUTHORITY=

VITE_ROUND_ID=R1

# RESOLVED (was: "code gap, see docs/DEVNET.md §5"): the browser no longer reaches the validator
# itself. tokens.json `base` ('/cn/devnet') now resolves against the SOLVER, whose ledger proxy
# forwards to the validator with the bearer injected server-side (solver/src/ledgerproxy.ts).
# Locally the Vite `/cn/devnet` proxy still exists for a legacy per-desk-token tokens.json; the
# shipped token-free path does not use it, which is what makes a static Vercel build work.
