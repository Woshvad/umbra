# web/.env.example — copy to web/.env for local dev. Contains NO secrets.
#
# The live solver service binds :4100 (solver/src/index.ts DEFAULT_SOLVER_PORT).
# The frontend reads this to reach the operator-plane solver; the Anthropic API key
# NEVER lives here (it is server-only, in solver/.env).
VITE_SOLVER_URL=http://localhost:4100

# ── OIDC desk login (DevNet/prod dual-mode — IDEN-01/02) — PUBLIC, NO SECRET ───────
# Set VITE_OIDC_AUTHORITY to the Keycloak realm URL to switch desks from the pre-minted
# dev token (tokens.json) to auth-code + PKCE login. Leave BLANK for the dev LocalNet
# path (unchanged). The web client (umbra-web) is a PUBLIC PKCE client — it carries NO
# client secret (the confidential umbra-solver secret lives server-side only, in .env).
VITE_OIDC_AUTHORITY=
